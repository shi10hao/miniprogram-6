.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #62BCC4 0%, #4aa8b0 40%, #3a9ca4 100%);
  padding: 60rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background: white;
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  color: #333;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

/* 输入行 */
.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #444;
  margin-bottom: 14rpx;
  padding-left: 4rpx;
}

.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #e8eef0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.query-btn {
  width: 160rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #62BCC4, #4aa8b0);
  color: white;
  border-radius: 14rpx;
  font-size: 28rpx;
  border: none;
  flex-shrink: 0;
}

.query-btn[disabled] {
  background: #c8d6d8;
}

/* 错误提示 */
.error {
  display: block;
  color: #ff6b6b;
  font-size: 26rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

/* 用户信息卡片 */
.user-info {
  margin-top: 8rpx;
  padding: 32rpx;
  background: #f8fafb;
  border-radius: 16rpx;
  border: 2rpx solid #e8eef0;
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e8eef0;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-row:last-of-type {
  margin-bottom: 36rpx;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #888;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.text-green {
  color: #2e7d32;
}

.text-red {
  color: #e74c3c;
}

/* 重置按钮 */
.submit-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #e74c3c, #d63031);
  color: white;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(231, 76, 60, 0.3);
}

.submit-btn[disabled] {
  background: #c8d6d8;
  box-shadow: none;
}