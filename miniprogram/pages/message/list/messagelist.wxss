/* 消息页样式 —— 使用 app.wxss 的设计变量 */

/* --------------------------------------------------------------------------
   页面标题（与首页/工作台同一套 hero 样式）
   -------------------------------------------------------------------------- */
.hero {
  padding: 16rpx 8rpx 40rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: var(--ds-text);
  letter-spacing: 1rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

/* --------------------------------------------------------------------------
   操作栏
   -------------------------------------------------------------------------- */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ds-gap-sm);
  padding: 26rpx var(--ds-gap-lg);
  margin-bottom: var(--ds-gap);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
}

.count-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  min-width: 0;
}

.total-count {
  font-size: 26rpx;
  color: var(--ds-text-secondary);
}

.unread-count {
  font-size: 22rpx;
  color: var(--ds-danger);
  background: var(--ds-danger-light);
  padding: 4rpx 16rpx;
  border-radius: var(--ds-radius-pill);
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: var(--ds-gap);
  flex-shrink: 0;
}

.action-btn {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ds-primary);
}

.action-btn.danger {
  color: var(--ds-danger);
}

.action-btn:active {
  opacity: 0.6;
}

/* --------------------------------------------------------------------------
   消息列表
   -------------------------------------------------------------------------- */
.message-list {
  display: flex;
  flex-direction: column;
  gap: var(--ds-gap-sm);
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: var(--ds-gap);
  padding: var(--ds-gap-lg);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
}

.message-item:active {
  background: var(--ds-fill);
}

/* 未读：整卡淡色底 + 加粗标题，比原来的左侧色条更克制 */
.message-item.unread {
  background: var(--ds-primary-soft);
}

.message-item.unread .message-title {
  font-weight: 600;
  color: var(--ds-text);
}

.message-item.read .message-title {
  font-weight: 500;
  color: var(--ds-text-secondary);
}

/* 类型图标 */
.message-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.message-icon.reservation {
  background: var(--ds-primary-light);
}

.message-icon.usage {
  background: var(--ds-warning-light);
}

.message-icon.system {
  background: var(--ds-fill);
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  align-items: baseline;
  gap: var(--ds-gap-sm);
  margin-bottom: 10rpx;
}

.message-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--ds-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.message-time {
  font-size: 22rpx;
  color: var(--ds-text-muted);
  flex-shrink: 0;
}

.message-preview {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--ds-text-secondary);
}

.message-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ds-gap-sm);
  margin-top: 18rpx;
}

/* 类型标签 */
.message-type {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--ds-radius-sm);
  font-size: 22rpx;
  line-height: 1.5;
}

.message-type.reservation {
  color: var(--ds-primary-dark);
  background: var(--ds-primary-light);
}

.message-type.usage {
  color: var(--ds-warning);
  background: var(--ds-warning-light);
}

.message-type.system {
  color: var(--ds-text-secondary);
  background: var(--ds-fill);
}

/* 删除：默认弱化，点按时才强调 */
.delete-btn {
  padding: 6rpx 20rpx;
  border-radius: var(--ds-radius-sm);
  font-size: 22rpx;
  color: var(--ds-text-muted);
  border: 1rpx solid var(--ds-border);
  flex-shrink: 0;
}

.delete-btn:active {
  color: #fff;
  background: var(--ds-danger);
  border-color: var(--ds-danger);
}

/* --------------------------------------------------------------------------
   加载更多
   -------------------------------------------------------------------------- */
.load-more-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--ds-gap) 0;
}

.load-more-btn {
  padding: 16rpx 48rpx;
  font-size: 26rpx;
  color: var(--ds-primary);
  border: 1rpx solid var(--ds-primary);
  border-radius: var(--ds-radius-pill);
}

.load-more-btn:active {
  background: var(--ds-primary-light);
}

.load-more-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

.ds-spinner.small {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  margin-bottom: 0;
}

.no-more {
  padding: var(--ds-gap) 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ds-text-disabled);
}
