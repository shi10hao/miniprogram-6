<view class="ds-page">
  <!-- 页面标题：与其他 tab 页统一 -->
  <view class="hero">
    <text class="hero-title">消息</text>
    <text class="hero-subtitle">
      {{unreadCount > 0 ? '有 ' + unreadCount + ' 条未读消息' : '所有消息都已读'}}
    </text>
  </view>

  <!-- 操作栏 -->
  <view class="action-bar" wx:if="{{messageList.length > 0}}">
    <view class="count-group">
      <text class="total-count">共 {{totalCount}} 条</text>
      <text class="unread-count" wx:if="{{unreadCount > 0}}">{{unreadCount}} 条未读</text>
    </view>
    <view class="action-buttons">
      <text class="action-btn" bindtap="markAllAsRead">全部已读</text>
      <text class="action-btn danger" bindtap="deleteReadMessages">删除已读</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{isLoading}}" class="ds-card">
    <view class="ds-loading">
      <view class="ds-spinner"></view>
      <text>加载中</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{messageList.length === 0}}" class="ds-card">
    <view class="ds-empty">
      <text class="ds-empty-icon">📭</text>
      <text class="ds-empty-title">暂无消息</text>
      <text class="ds-empty-desc">预约提醒与管理员公告会显示在这里</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <view wx:else class="message-list">
    <view
      class="message-item {{item.is_read ? 'read' : 'unread'}}"
      wx:for="{{messageList}}"
      wx:key="_id"
      data-messageid="{{item._id}}"
      data-source="{{item.source}}"
      data-index="{{index}}"
      bindtap="viewMessageDetail"
    >
      <!-- 类型图标：替代原来左侧那根色条，辨识度更高 -->
      <view class="message-icon {{item.styleType}}">{{item.typeIcon}}</view>

      <view class="message-content">
        <view class="message-header">
          <text class="message-title">{{item.title}}</text>
          <text class="message-time">{{item.create_time}}</text>
        </view>
        <text class="message-preview">{{item.preview}}</text>
        <view class="message-footer">
          <text class="message-type {{item.styleType}}">{{item.typeLabel}}</text>
          <text
            wx:if="{{item.canDelete}}"
            class="delete-btn"
            data-messageid="{{item._id}}"
            data-source="{{item.source}}"
            data-index="{{index}}"
            catchtap="deleteMessage"
          >删除</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more-container" wx:if="{{!allLoaded}}">
      <view class="load-more-btn" bindtap="loadMore" wx:if="{{!isLoadingMore}}">加载更多</view>
      <view class="load-more-loading" wx:else>
        <view class="ds-spinner small"></view>
        <text>加载中</text>
      </view>
    </view>
    <view class="no-more" wx:elif="{{messageList.length > 0}}">已加载全部消息</view>
  </view>
</view>
