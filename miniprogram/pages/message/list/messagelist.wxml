<view class="container">
  <view class="action-bar" wx:if="{{messageList.length > 0}}">
    <view class="count-group">
      <text class="total-count">共 {{messageList.length}} 条消息</text>
      <text class="unread-count" wx:if="{{unreadCount > 0}}">{{unreadCount}}条未读</text>
    </view>
    <view class="action-buttons">
      <text class="action-btn" bindtap="markAllAsRead">全部已读</text>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{messageList.length === 0}}" class="empty-container">
    <text class="empty-title">暂无消息</text>
    <text class="empty-desc">还没有收到任何消息通知</text>
  </view>

  <view wx:else class="message-list">
    <view
      class="message-item {{item.is_read ? 'read' : 'unread'}}"
      wx:for="{{messageList}}"
      wx:key="_id"
      data-messageid="{{item._id}}"
      data-source="{{item.source}}"
      data-index="{{index}}"
      bindtap="viewMessageDetail"
    >
      <view class="message-status" wx:if="{{!item.is_read}}"></view>
      <view class="message-content">
        <view class="message-header">
          <text class="message-title">{{item.title}}</text>
          <text class="message-time">{{item.create_time}}</text>
        </view>
        <text class="message-preview">{{item.preview}}</text>
        <view class="message-footer">
          <view class="message-type {{item.styleType}}">
            {{item.typeLabel}}
          </view>
          <text
            wx:if="{{item.canDelete}}"
            class="delete-btn"
            data-messageid="{{item._id}}"
            data-source="{{item.source}}"
            data-index="{{index}}"
            catchtap="deleteMessage"
          >删除</text>
        </view>
      </view>
    </view>
  </view>
</view>
