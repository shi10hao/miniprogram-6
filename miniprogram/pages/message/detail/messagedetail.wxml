<view class="ds-page">
  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="ds-loading detail-loading">
    <view class="ds-spinner"></view>
    <text class="detail-loading-text">加载中...</text>
  </view>

  <!-- 消息 / 公告详情：结构一致，公告多了协作文档入口 -->
  <view wx:elif="{{detail}}" class="ds-card detail-card">
    <text class="detail-title">{{detail.title}}</text>

    <view class="detail-meta">
      <text class="detail-time">{{detail.create_time}}</text>
      <text class="ds-tag ds-tag-{{detail.styleType}}">{{detail.typeLabel}}</text>
    </view>

    <view class="detail-content">
      <text class="detail-content-text">{{detail.content || '暂无内容'}}</text>
    </view>

    <!-- 协作文档（仅公告有 doc_url 时显示） -->
    <view wx:if="{{detail.doc_url}}" class="doc-btn" hover-class="doc-btn-hover" bindtap="openDoc">
      <text class="doc-btn-icon">📄</text>
      <view class="doc-btn-body">
        <text class="doc-btn-text">打开协作文档</text>
        <text class="doc-btn-desc">在腾讯文档中查看完整内容</text>
      </view>
      <text class="doc-btn-arrow">›</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="ds-empty detail-empty">
    <text class="ds-empty-icon">📭</text>
    <text class="ds-empty-title">{{emptyTitle}}</text>
    <text class="ds-empty-desc">{{emptyDesc}}</text>
  </view>
</view>
