/* 消息 / 公告详情（已合并为同一页）
   通用卡片、标签、加载、空状态全部复用 app.wxss 的 ds-* 类，
   这里只写详情页特有的排版和协作文档入口 */

.detail-loading {
  padding-top: 200rpx;
}

.detail-loading-text {
  color: var(--ds-text-muted);
}

.detail-card {
  padding: 40rpx 32rpx 36rpx;
}

.detail-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ds-text);
  word-break: break-word;
}

.detail-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ds-gap-sm);
  margin-top: 20rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--ds-divider);
}

.detail-time {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.detail-content {
  padding-top: 30rpx;
}

/* 公告正文常用换行排版，保留作者输入的换行 */
.detail-content-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.85;
  color: var(--ds-text);
  white-space: pre-line;
  word-break: break-word;
}

/* 协作文档入口：品牌浅底 + 文档图标，点击跳腾讯文档小程序 */
.doc-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 40rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, var(--ds-primary-light), var(--ds-primary-soft));
  border: 1rpx solid var(--ds-primary-shadow);
  border-radius: var(--ds-radius);
}

.doc-btn-hover {
  opacity: 0.86;
}

.doc-btn-icon {
  font-size: 34rpx;
  flex-shrink: 0;
}

.doc-btn-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.doc-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ds-primary-deep);
}

.doc-btn-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ds-primary-dark);
}

.doc-btn-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--ds-primary);
  flex-shrink: 0;
}

.detail-empty {
  padding-top: 160rpx;
}
