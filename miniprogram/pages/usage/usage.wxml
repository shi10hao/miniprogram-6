<view class="container">
  <view wx:if="{{!isAuthenticated}}" class="login-tip">
    <text>登录后可查看使用记录、预约及上传照片</text>
    <button bindtap="goAuth">去登录</button>
  </view>
  <!-- 未读提醒 -->
  <view wx:if="{{unreadReminder}}" bindtap="goToReminder" style="margin: 24rpx 0; padding: 24rpx; border-radius: 20rpx; background: linear-gradient(135deg, #fff8e8 0%, #fff2cc 100%); border: 1px solid #f0d48a;">
    <view style="display: flex; justify-content: space-between; align-items: center; gap: 16rpx;">
      <text style="font-size: 30rpx; font-weight: 600; color: #8a5a00;">未读提醒</text>
      <text style="font-size: 22rpx; color: #8a5a00;">{{unreadReminder.create_time}}</text>
    </view>
    <view style="margin-top: 12rpx;">
      <text style="display: block; font-size: 28rpx; font-weight: 600; color: #333;">{{unreadReminder.title}}</text>
      <text style="display: block; margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: #6b7280;">{{unreadReminder.content}}</text>
    </view>
  </view>

  <!-- 2 当前使用状态模块 -->
  <view class="status-section">
    <view class="section-header">
      <text class="section-title">当前使用状态</text>
    </view>

    <!-- 2.1 如果没有正在使用的仪器 -->
    <view wx:if="{{!currentUsage}}" class="idle-block">
      <view class="idle-icon">🔬</view>
      <text class="idle-text">当前没有使用中的仪器</text>
      <!-- <button class="primary-btn" bindtap="startUsage" disabled="{{isLoading || !isAuthenticated}}">
        <text>拍照开始使用</text>
      </button> -->
    </view>

    <!-- 2.2 如果有正在使用的仪器 -->
    <view wx:else class="using-block">
      <view class="using-info-row">
        <text class="using-label">仪器名称</text>
        <text class="using-value">{{currentUsage.device_name}}</text>
      </view>
      <view class="using-info-row">
        <text class="using-label">仪器编号</text>
        <text class="using-value">{{currentUsage.device_id}}</text>
      </view>
      <view class="using-info-row">
        <text class="using-label">开始时间</text>
        <text class="using-value">{{currentUsage.start_time_display}}</text>
      </view>

      <!-- 2.3 如果没结束 -->
      <view wx:if="{{!endMode}}" class="using-actions">
        <button class="upload-mid-btn" bindtap="uploadUsagePhoto" disabled="{{isLoading || !isAuthenticated}}">
          <text>上传使用照片</text>
        </button>
        <button class="end-btn" bindtap="startEndUsage" disabled="{{isLoading || !isAuthenticated}}">
          <text>正常结束使用</text>
        </button>
      </view>
      <!-- 新增：使用中问题反馈按钮 -->
      <button class="feedback-btn-inline" bindtap="openUsageFeedback" disabled="{{isLoading || !isAuthenticated}}">
        <text>异常问题反馈并结束使用</text>
      </button>
    </view>
  </view>

  <!-- 3 待使用的预约 -->
  <view wx:if="{{pendingReserves.length > 0 && !currentUsage}}" class="pending-section">
    <view class="section-header">
      <text class="section-title">待使用预约</text>
    </view>

    <!-- 预约列表 -->
    <view class="pending-list">
      <view class="pending-item {{item.state}}" wx:for="{{pendingReserves}}" wx:key="_id">
        <view class="pending-header">
          <text class="pending-device">{{item.device_name}}</text>
          <text class="pending-state {{item.state}}">{{item.state === 'ready' ? '可开始' : item.state === 'pending' ? '未到时间' : '已过期'}}</text>
        </view>
        <view class="pending-row">
          <text class="pending-label">预约时段：</text>
          <text class="pending-val">{{item.start_display}} - {{item.end_display}}</text>
        </view>
        <view class="pending-row">
          <text class="pending-label">仪器编号：</text>
          <text class="pending-val">{{item.device_id}}</text>
        </view>
        <button class="start-reserve-btn" data-reserveid="{{item._id}}" bindtap="startUsageFromReserve" disabled="{{isLoading || !isAuthenticated|| item.state === 'expired'}}">扫码拍照开始使用</button>
      </view>
    </view>
  </view>

  <!-- 4 上传照片模块 -->
  <view wx:if="{{currentUsage}}" class="photo-section">

    <!-- 4.1 上传正在使用 -->
    <view wx:if="{{!endMode}}" class="photo-block">
      <view class="section-header">
        <text class="section-title">上传照片板块</text>
      </view>
      <text style="display: block; margin-bottom: 16rpx; color: #6b7280; font-size: 24rpx;">使用过程中拍摄的照片请在这里上传，提醒消息中的“上传照片板块”即此处。</text>

      <!-- 4.1.1 如果有正在使用的，就进行正在使用的仪器照片循环 -->
      <view wx:if="{{currentUsage.usage_images && currentUsage.usage_images.length > 0}}" class="photos-grid">
        <view class="photo-item" wx:for="{{currentUsage.usage_images}}" wx:key="*this">
          <image class="photo-img" src="{{item}}" mode="aspectFill"></image>
        </view>
      </view>

      <!-- 4.1.2 如果没有正在使用的 -->
      <view wx:else class="empty-photos">
        <text class="empty-photos-text">暂无使用中照片</text>
      </view>
    </view>

  </view>

  <view class="history-section">
    <view class="section-header">
      <text class="section-title">使用记录</text>
    </view>

    <view wx:if="{{isLoading && !currentUsage}}" class="loading-text">加载中...</view>
    <view wx:elif="{{usageHistory.length === 0}}" class="empty-history">暂无使用记录</view>

    <view wx:else class="history-list">
      <view class="history-item" wx:for="{{usageHistory}}" wx:key="_id">
        <view class="history-header">
          <text class="history-device">{{item.device_name}}</text>
          <text class="history-status {{item.status}}">{{item.status === 'completed' ? '已完成' : '异常结束'}}</text>
        </view>
        <view class="history-row">
          <text class="history-label">仪器编号：</text>
          <text class="history-val">{{item.device_id}}</text>
        </view>
        <view class="history-row">
          <text class="history-label">预约日期：</text>
          <text class="history-val">{{item.reserve_date}}</text>
        </view>
        <view class="history-row">
          <text class="history-label">使用时段：</text>
          <text class="history-val">{{item.usage_period_display}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 问题反馈弹窗 -->
  <view class="feedback-mask" wx:if="{{!ifWorkingOK}}">
    <view class="feedback-card">
      <view class="feedback-header">
        <text class="feedback-title">{{feedbackScene === 'start' ? '仪器启动异常反馈' : '使用问题反馈'}}</text>
        <text class="feedback-close" bind:tap="closeFeedback">×</text>
      </view>

      <!-- 问题类型选择
      <view class="feedback-type-group">
        <text class="feedback-label">问题类型</text>
        <view class="type-options">
          <view class="type-item {{feedbackType === item.value ? 'active' : ''}}" wx:for="{{feedbackTypeOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="selectFeedbackType">
            {{item.label}}
          </view>
        </view>
      </view> -->

      <input class="feedback-input" placeholder="请输入问题标题（选填）" value="{{feedbackTitle}}" bindinput="onTitleInput" />
      <textarea value="{{feedbackContent}}" class="feedback-textarea" placeholder="请详细描述您遇到的问题，例如故障现象、报错信息等" bindinput="onContentInput" maxlength="500" />
      <!-- 故障照片上传 -->
      <view class="feedback-photo-section">
        <text class="feedback-label">故障照片（选填）</text>
        <view class="photo-upload-grid">
          <view class="photo-slot" wx:for="{{feedbackPhotos}}" wx:key="*this">
            <image class="slot-img" src="{{item}}" mode="aspectFill"></image>
          </view>
          <view class="photo-add-slot" wx:if="{{feedbackPhotos.length < 3}}" bindtap="chooseFeedbackPhoto">
            <text class="slot-plus">+</text>
            <text class="slot-tip">添加照片</text>
          </view>
        </view>
      </view>
      <!-- 结束使用选项 -->
      <!-- <view class="feedback-end-option" wx:if="{{feedbackScene === 'using'}}">
        <label class="checkbox-label">
          <checkbox value="1" checked="{{endWithFeedback}}" color="#62BCC4" bindchange="onEndWithFeedbackChange" />
          <text>仪器无法使用，同步结束本次使用</text>
        </label>
        <text class="option-hint">勾选后将直接终止使用，仅适用于严重故障</text>
      </view> -->

      <button class="feedback-submit-btn" bind:tap="submitFeedback" disabled="{{isLoading}}">
        {{isLoading ? '提交中...' : '提交反馈'}}
      </button>
    </view>
  </view>
  <!-- 结束信息表单浮层 -->
  <view class="end-form-mask" wx:if="{{showEndForm}}">
    <view class="end-form-card">
      <view class="end-form-header">
        <text class="end-form-title">结束使用信息</text>
        <text class="end-form-close" bindtap="cancelEndForm">✕</text>
      </view>

      <scroll-view scroll-y class="end-form-body">
        <!-- 仪器是否关闭 -->
        <view class="form-row">
          <text class="form-label required">仪器是否关闭</text>
          <view class="form-options">
            <text class="option-btn {{endForm.instrumentOff === true ? 'active' : ''}}" data-value="true" bindtap="selectInstrumentOff">是</text>
            <text class="option-btn {{endForm.instrumentOff === false ? 'active' : ''}}" data-value="false" bindtap="selectInstrumentOff">否</text>
          </view>
        </view>

        <!-- 电脑是否关闭 -->
        <view class="form-row">
          <text class="form-label required">电脑是否关闭</text>
          <view class="form-options">
            <text class="option-btn {{endForm.computerOff === true ? 'active' : ''}}" data-value="true" bindtap="selectComputerOff">是</text>
            <text class="option-btn {{endForm.computerOff === false ? 'active' : ''}}" data-value="false" bindtap="selectComputerOff">否</text>
          </view>
        </view>
        <view wx:if="{{endForm.computerOff === false}}" class="form-row">
          <text class="form-label required">下一个使用者姓名</text>
          <input class="form-input" type="text" placeholder="请输入下一个使用者姓名" value="{{endForm.nextUser}}" bindinput="onNextUserInput" />
        </view>

        <!-- 运行样品总数 -->
        <view class="form-row">
          <text class="form-label required">运行样品总数</text>
          <input class="form-input" type="number" placeholder="请输入正整数" value="{{endForm.sampleCount}}" bindinput="onSampleCountInput" />
        </view>
        <view class="form-row">
          <text class="form-label required">是否过多预约</text>
          <view class="form-options">
            <text class="option-btn {{endForm.moreSample === true ? 'active' : ''}}" data-value="true" bindtap="selectMoreSample">是</text>
            <text class="option-btn {{endForm.moreSample === false ? 'active' : ''}}" data-value="false" bindtap="selectMoreSample">否</text>
          </view>
        </view>
        <view wx:if="{{endForm.moreSample}}" class="form-row">
          <text class="form-label required">剩余的样品数量</text>
          <input class="form-input" type="number" placeholder="请输入剩余样品数量" value="{{endForm.moreSampleCount}}" bindinput="onMoreSampleCountInput" />
        </view>
        <!-- 总的预约单 -->
        <view class="form-row">
          <text class="form-label required">总的预约单</text>
          <view class="form-upload" bindtap="pickTotalPage">
            <view wx:if="{{endForm.totalPage}}" class="upload-preview">
              <image class="upload-img" src="{{endForm.totalPage}}" mode="aspectFill" />
              <text class="upload-change">重新选择</text>
            </view>
            <view wx:else class="upload-empty">
              <text class="upload-plus">+</text>
              <text class="upload-tip">点击上传预约单截图</text>
            </view>
          </view>
        </view>

        <!-- 仪器照片，实验室关门照片 -->
        <view class="form-row">
          <text class="form-label required">仪器关闭照片</text>
          <view class="form-upload" bind:tap="pickDevicePage">
            <view wx:if="{{endForm.devicePage}}" class="upload-preview" mode="aspectFill">
              <image src="{{endForm.devicePage}}" mode="aspectFill" class="upload-img" />
              <text class="upload-change">重新选择</text>
            </view>
            <view wx:else class="upload-empty">
              <text class="upload-plus">+</text>
              <text class="upload-tip">点击上传仪器关闭图像</text>
            </view>
          </view>
        </view>
        <view class="form-row">
          <text class="form-label required">实验室关门照片</text>
          <view class="form-upload" bind:tap="pickRoomPage">
            <view wx:if="{{endForm.roomPage}}" class="upload-preview" mode="aspectFill">
              <image src="{{endForm.roomPage}}" mode="aspectFill" class="upload-img" />
              <text class="upload-change">重新选择</text>
            </view>
            <view wx:else class="upload-empty">
              <text class="upload-plus">+</text>
              <text class="upload-tip">点击上传实验室关门图像</text>
            </view>
          </view>
        </view>
        <!-- 是否需要补充预约 -->
        <view class="form-row">
          <text class="form-label required">是否需要补充预约</text>
          <view class="form-options">
            <text class="option-btn {{endForm.needSupplement === true ? 'active' : ''}}" data-value="true" bindtap="selectNeedSupplement">是</text>
            <text class="option-btn {{endForm.needSupplement === false ? 'active' : ''}}" data-value="false" bindtap="selectNeedSupplement">否</text>
          </view>
        </view>

        <!-- 补充预约单 -->
        <view wx:if="{{endForm.needSupplement}}" class="form-row">
          <text class="form-label required">补充预约单</text>
          <view class="form-upload" bindtap="pickSupplementPage">
            <view wx:if="{{endForm.supplementPage}}" class="upload-preview">
              <image class="upload-img" src="{{endForm.supplementPage}}" mode="aspectFill" />
              <text class="upload-change">重新选择</text>
            </view>
            <view wx:else class="upload-empty">
              <text class="upload-plus">+</text>
              <text class="upload-tip">点击上传补充预约单截图</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 提交按钮 -->
      <view class="end-form-footer">
        <button class="form-cancel-btn" bindtap="cancelEndForm">取消</button>
        <button class="form-submit-btn" bindtap="submitEndForm" disabled="{{isLoading}}">
          {{isLoading ? '提交中...' : '确认结束使用'}}
        </button>
      </view>
    </view>
  </view>
</view>

<!-- ===== 新增：隐藏的 Canvas，用于绘制水印 ===== -->
<canvas type="2d" id="watermarkCanvas" style="width:750px;height:1000px;position:fixed;left:-9999px;top:-9999px;pointer-events:none;"></canvas>