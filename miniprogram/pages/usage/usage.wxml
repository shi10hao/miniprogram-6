<!-- 仪器使用页 -->
<view class="page">
  <!-- 顶部渐变头：一眼看到「现在在用什么仪器」 -->
  <view class="hero">
    <view class="hero-row">
      <view class="hero-main">
        <text class="hero-eyebrow">仪器使用</text>
        <text class="hero-title">{{currentUsage ? currentUsage.device_name : '准备就绪'}}</text>
      </view>
      <view class="hero-badge {{currentUsage ? 'is-using' : ''}}">
        <view class="hero-badge-dot"></view>
        <text class="hero-badge-text">{{currentUsage ? '使用中' : '空闲'}}</text>
      </view>
    </view>

    <view wx:if="{{currentUsage}}" class="hero-meta">
      <text class="hero-meta-text">{{currentUsage.start_time_display}} 起</text>
      <text wx:if="{{elapsedText}}" class="hero-meta-pill">{{elapsedText}}</text>
    </view>
    <text wx:else class="hero-sub">扫码开始使用 · 上传过程照片 · 正常结束</text>
  </view>

  <view class="body">
    <!-- 未认证 -->
    <view wx:if="{{!isAuthenticated}}" class="ds-card state-card">
      <text class="state-icon">🔒</text>
      <text class="state-title">还没有完成身份认证</text>
      <text class="state-desc">认证后才能预约仪器、开始使用和上传照片</text>
      <view class="ds-btn ds-btn-block state-btn" bindtap="goAuth">去认证</view>
    </view>

    <block wx:else>
      <!-- 未读提醒 -->
      <view wx:if="{{unreadReminder}}" class="remind" bindtap="goToReminder">
        <view class="remind-mark"></view>
        <view class="remind-main">
          <view class="remind-head">
            <text class="remind-title">{{unreadReminder.title}}</text>
            <text class="remind-time">{{unreadReminder.time_text}}</text>
          </view>
          <text class="remind-text">{{unreadReminder.content}}</text>
        </view>
        <text class="remind-action">查看</text>
        <view class="remind-close" catchtap="closeReminder">✕</view>
      </view>

      <!-- 当前使用 -->
      <block wx:if="{{currentUsage}}">
        <view class="ds-card">
          <view class="card-row">
            <view class="card-row-main">
              <text class="card-row-label">本次使用</text>
              <text class="card-row-value">{{currentUsage.device_id || currentUsage.device_name}}</text>
            </view>
            <text class="ds-tag {{currentUsage.status_tag}}">{{currentUsage.status_text}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">开始时间</text>
            <text class="info-value">{{currentUsage.start_time_display}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">已使用</text>
            <text class="info-value info-strong">{{elapsedText || '刚刚开始'}}</text>
          </view>

          <view class="card-actions">
            <view class="ds-btn ds-btn-block" bindtap="startEndUsage">正常结束使用</view>
            <view class="ghost-actions">
              <view class="ds-btn ds-btn-ghost ghost-btn" bindtap="uploadUsagePhoto">上传照片</view>
              <view class="ds-btn ds-btn-danger ghost-btn" bindtap="openUsageFeedback">遇到问题</view>
            </view>
          </view>
        </view>

        <!-- 使用过程照片 -->
        <view id="photoSection" class="ds-card">
          <view class="ds-section-head photo-head">
            <text class="ds-section-title">使用过程照片</text>
            <text class="photo-count">{{selfUsageImages.length}}/{{photoLimit}}</text>
          </view>

          <view class="photo-grid">
            <view wx:for="{{selfUsageImages}}" wx:key="fileId" class="photo-tile">
              <image
                wx:if="{{!item.failed}}"
                class="photo-img"
                src="{{item.url}}"
                mode="aspectFill"
                data-url="{{item.url}}"
                data-index="{{index}}"
                bindtap="previewUsagePhoto"
                binderror="onUsagePhotoError"
              />
              <view wx:else class="photo-broken">加载失败</view>
            </view>

            <view
              wx:if="{{selfUsageImages.length < photoLimit}}"
              class="photo-tile photo-add"
              bindtap="uploadUsagePhoto"
            >
              <text class="photo-add-icon">+</text>
              <text class="photo-add-text">上传</text>
            </view>
          </view>

          <text wx:if="{{!selfUsageImages.length}}" class="photo-hint">还没有过程照片，上传时会给照片打上时间与仪器水印</text>
          <text wx:else class="photo-hint">照片会自动添加时间与仪器水印，最多 {{photoLimit}} 张</text>
        </view>
      </block>

      <view wx:else class="ds-card state-card">
        <text class="state-icon">🧪</text>
        <text class="state-title">当前没有进行中的使用</text>
        <text class="state-desc">在下方「待使用预约」里点「扫码开始」，扫描仪器上的二维码即可开始</text>
      </view>

      <!-- 待使用预约 -->
      <view class="ds-section-head section-gap">
        <text class="ds-section-title">待使用预约</text>
        <text class="ds-section-more">{{pendingReserves.length}} 个</text>
      </view>

      <block wx:if="{{pendingReserves.length}}">
        <view wx:for="{{pendingReserves}}" wx:key="_id" class="ds-card reserve-card">
          <view class="card-row">
            <view class="card-row-main">
              <text class="reserve-name">{{item.device_name}}</text>
              <text class="reserve-id">{{item.device_id}}</text>
            </view>
            <text class="ds-tag {{item.tag_class}}">{{item.state_text}}</text>
          </view>

          <view class="info-row">
            <text class="info-label">预约日期</text>
            <text class="info-value">{{item.reserve_date}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">预约时段</text>
            <text class="info-value">{{item.period_text}}</text>
          </view>

          <view class="reserve-foot">
            <text class="reserve-hint {{item.state === 'ready' ? 'is-ready' : ''}}">{{item.time_text}}</text>
            <view
              wx:if="{{item.can_start}}"
              class="ds-btn reserve-btn"
              data-reserveid="{{item._id}}"
              catchtap="startUsageFromReserve"
            >扫码开始</view>
            <view wx:else class="reserve-btn is-disabled">已结束</view>
          </view>
        </view>
      </block>

      <view wx:else class="ds-card ds-empty">
        <text class="ds-empty-icon">📅</text>
        <text class="ds-empty-title">暂无待使用的预约</text>
        <text class="ds-empty-desc">在「预约」页申请通过后，这里会出现扫码入口</text>
      </view>

      <!-- 使用历史 -->
      <view class="ds-section-head section-gap">
        <text class="ds-section-title">使用历史</text>
        <text wx:if="{{!isHistoryLoading}}" class="ds-section-more">最近 {{usageHistory.length}} 条</text>
      </view>

      <block wx:if="{{isHistoryLoading}}">
        <view wx:for="{{[1, 2]}}" wx:key="*this" class="ds-skeleton-card">
          <view class="ds-skeleton sk-line sk-line-title"></view>
          <view class="ds-skeleton sk-line"></view>
          <view class="ds-skeleton sk-line sk-line-short"></view>
        </view>
      </block>

      <block wx:elif="{{usageHistory.length}}">
        <view
          wx:for="{{usageHistory}}"
          wx:key="_id"
          class="ds-card history-card"
          data-reserveid="{{item.reserve_id}}"
          bindtap="openHistoryDetail"
        >
          <view class="card-row">
            <view class="card-row-main">
              <text class="history-name">{{item.device_name}}</text>
              <text class="reserve-id">{{item.device_id}}</text>
            </view>
            <text class="ds-tag {{item.status_tag}}">{{item.status_text}}</text>
          </view>

          <view class="info-row">
            <text class="info-label">时间</text>
            <text class="info-value">{{item.usage_period_display}}</text>
          </view>
          <view wx:if="{{item.duration_text}}" class="info-row">
            <text class="info-label">时长</text>
            <text class="info-value">{{item.duration_text}}</text>
          </view>

          <view wx:if="{{item.has_feedback}}" class="history-feedback">
            <text class="history-feedback-label">异常反馈</text>
            <text class="history-feedback-text">{{item.feedback_title || item.feedback_content}}</text>
          </view>

          <text wx:if="{{item.reserve_id}}" class="history-more">查看详情 ›</text>
        </view>
      </block>

      <view wx:else class="ds-card ds-empty">
        <text class="ds-empty-icon">📋</text>
        <text class="ds-empty-title">还没有使用记录</text>
        <text class="ds-empty-desc">结束第一次使用后，记录会显示在这里</text>
      </view>
    </block>
  </view>
</view>

<!-- ==================== 异常反馈 ==================== -->
<view wx:if="{{showFeedback}}" class="sheet-mask" catchtap="closeFeedback" catchtouchmove="noop"></view>
<view wx:if="{{showFeedback}}" class="sheet" catchtouchmove="noop">
  <view class="sheet-head">
    <text class="sheet-title">{{feedbackScene === 'using' ? '反馈问题并结束使用' : '仪器无法正常启动'}}</text>
    <text class="sheet-close" catchtap="closeFeedback">✕</text>
  </view>

  <scroll-view scroll-y class="sheet-scroll">
    <view class="sheet-tip">
      <text wx:if="{{feedbackScene === 'using'}}">提交后本次使用会立即结束，管理员将收到异常通知。</text>
      <text wx:else>提交后管理员将收到异常通知，本次使用不会开始。</text>
    </view>

    <view class="form-block">
      <text class="form-label">问题标题</text>
      <input
        class="form-input"
        value="{{feedbackTitle}}"
        placeholder="例如：仪器无法启动"
        placeholder-class="form-placeholder"
        maxlength="40"
        bindinput="onFeedbackTitleInput"
      />
    </view>

    <view class="form-block">
      <text class="form-label">问题描述<text class="form-required">*</text></text>
      <textarea
        class="form-textarea"
        value="{{feedbackContent}}"
        placeholder="请描述具体现象，方便管理员定位"
        placeholder-class="form-placeholder"
        maxlength="300"
        bindinput="onFeedbackContentInput"
      />
      <text class="form-counter">{{feedbackContent.length}}/300</text>
    </view>

    <view class="form-block">
      <text class="form-label">现场照片（最多 {{maxFeedbackPhotos}} 张）</text>
      <view class="photo-grid">
        <view wx:for="{{feedbackPhotos}}" wx:key="*this" class="photo-tile">
          <image class="photo-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewFeedbackPhoto" />
          <view class="photo-remove" data-index="{{index}}" catchtap="deleteFeedbackPhoto">✕</view>
        </view>
        <view
          wx:if="{{feedbackPhotos.length < maxFeedbackPhotos}}"
          class="photo-tile photo-add"
          bindtap="chooseFeedbackPhoto"
        >
          <text class="photo-add-icon">+</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="sheet-foot">
    <view class="ds-btn ds-btn-ghost sheet-btn" catchtap="closeFeedback">取消</view>
    <view class="ds-btn sheet-btn {{isSubmittingFeedback ? 'is-busy' : ''}}" catchtap="submitFeedback">
      {{isSubmittingFeedback ? '提交中…' : '提交反馈'}}
    </view>
  </view>
</view>

<!-- ==================== 正常结束使用 ==================== -->
<view wx:if="{{showEndForm}}" class="sheet-mask" catchtap="cancelEndForm" catchtouchmove="noop"></view>
<view wx:if="{{showEndForm}}" class="sheet" catchtouchmove="noop">
  <view class="sheet-head">
    <text class="sheet-title">结束使用</text>
    <text class="sheet-close" catchtap="cancelEndForm">✕</text>
  </view>

  <scroll-view scroll-y class="sheet-scroll">
    <view class="sheet-tip">请如实填写现场情况，并上传照片留档，共 3 项必传。</view>

    <!-- 仪器是否关闭 -->
    <view class="form-block">
      <text class="form-label">仪器是否关闭<text class="form-required">*</text></text>
      <view class="seg">
        <view
          class="seg-item {{endForm.instrumentOff === true ? 'is-on' : ''}}"
          data-value="true"
          bindtap="selectInstrumentOff"
        >已关闭</view>
        <view
          class="seg-item {{endForm.instrumentOff === false ? 'is-on' : ''}}"
          data-value="false"
          bindtap="selectInstrumentOff"
        >未关闭</view>
      </view>
    </view>

    <!-- 电脑是否关闭 -->
    <view class="form-block">
      <text class="form-label">电脑是否关闭<text class="form-required">*</text></text>
      <view class="seg">
        <view
          class="seg-item {{endForm.computerOff === true ? 'is-on' : ''}}"
          data-value="true"
          bindtap="selectComputerOff"
        >已关闭</view>
        <view
          class="seg-item {{endForm.computerOff === false ? 'is-on' : ''}}"
          data-value="false"
          bindtap="selectComputerOff"
        >未关闭</view>
      </view>
    </view>

    <!-- 电脑未关时必须交代下一个使用者 -->
    <view wx:if="{{endForm.computerOff === false}}" class="form-block">
      <text class="form-label">下一个使用者<text class="form-required">*</text></text>
      <input
        class="form-input"
        value="{{endForm.nextUser}}"
        placeholder="填写接手的同学姓名"
        placeholder-class="form-placeholder"
        maxlength="20"
        bindinput="onNextUserInput"
      />
    </view>

    <!-- 样品数量 -->
    <view class="form-block">
      <text class="form-label">运行样品总数<text class="form-required">*</text></text>
      <input
        class="form-input"
        type="number"
        value="{{endForm.sampleCount}}"
        placeholder="本次一共测试了几个样品"
        placeholder-class="form-placeholder"
        bindinput="onSampleCountInput"
      />
    </view>

    <view class="form-block">
      <text class="form-label">是否还有未测试的样品<text class="form-required">*</text></text>
      <view class="seg">
        <view
          class="seg-item {{endForm.moreSample === true ? 'is-on' : ''}}"
          data-value="true"
          bindtap="selectMoreSample"
        >有</view>
        <view
          class="seg-item {{endForm.moreSample === false ? 'is-on' : ''}}"
          data-value="false"
          bindtap="selectMoreSample"
        >没有</view>
      </view>
    </view>

    <view wx:if="{{endForm.moreSample === true}}" class="form-block">
      <text class="form-label">剩余样品数量<text class="form-required">*</text></text>
      <input
        class="form-input"
        type="number"
        value="{{endForm.moreSampleCount}}"
        placeholder="不能大于运行样品总数"
        placeholder-class="form-placeholder"
        bindinput="onMoreSampleCountInput"
      />
    </view>

    <!-- 三张必传照片 -->
    <view class="form-block">
      <text class="form-label">总的预约单<text class="form-required">*</text></text>
      <view class="end-photo" data-key="totalPage" bindtap="pickEndPhoto">
        <block wx:if="{{endForm.totalPage}}">
          <image class="photo-img end-photo-img" src="{{endForm.totalPage}}" mode="aspectFill" />
          <view class="photo-remove" data-key="totalPage" catchtap="clearEndPhoto">✕</view>
        </block>
        <view wx:else class="end-photo-empty">
          <text class="photo-add-icon">+</text>
          <text class="end-photo-text">拍摄预约单</text>
        </view>
      </view>
    </view>

    <view class="form-block">
      <text class="form-label">仪器关闭照片<text class="form-required">*</text></text>
      <view class="end-photo" data-key="devicePage" bindtap="pickEndPhoto">
        <block wx:if="{{endForm.devicePage}}">
          <image class="photo-img end-photo-img" src="{{endForm.devicePage}}" mode="aspectFill" />
          <view class="photo-remove" data-key="devicePage" catchtap="clearEndPhoto">✕</view>
        </block>
        <view wx:else class="end-photo-empty">
          <text class="photo-add-icon">+</text>
          <text class="end-photo-text">拍摄仪器关闭状态</text>
        </view>
      </view>
    </view>

    <view class="form-block">
      <text class="form-label">实验室关门照片<text class="form-required">*</text></text>
      <view class="end-photo" data-key="roomPage" bindtap="pickEndPhoto">
        <block wx:if="{{endForm.roomPage}}">
          <image class="photo-img end-photo-img" src="{{endForm.roomPage}}" mode="aspectFill" />
          <view class="photo-remove" data-key="roomPage" catchtap="clearEndPhoto">✕</view>
        </block>
        <view wx:else class="end-photo-empty">
          <text class="photo-add-icon">+</text>
          <text class="end-photo-text">拍摄关灯后的实验室</text>
        </view>
      </view>
    </view>

    <view class="form-block">
      <text class="form-label">是否需要补充预约<text class="form-required">*</text></text>
      <view class="seg">
        <view
          class="seg-item {{endForm.needSupplement === true ? 'is-on' : ''}}"
          data-value="true"
          bindtap="selectNeedSupplement"
        >需要</view>
        <view
          class="seg-item {{endForm.needSupplement === false ? 'is-on' : ''}}"
          data-value="false"
          bindtap="selectNeedSupplement"
        >不需要</view>
      </view>
    </view>

    <view wx:if="{{endForm.needSupplement === true}}" class="form-block">
      <text class="form-label">补充预约单<text class="form-required">*</text></text>
      <view class="end-photo" data-key="supplementPage" bindtap="pickEndPhoto">
        <block wx:if="{{endForm.supplementPage}}">
          <image class="photo-img end-photo-img" src="{{endForm.supplementPage}}" mode="aspectFill" />
          <view class="photo-remove" data-key="supplementPage" catchtap="clearEndPhoto">✕</view>
        </block>
        <view wx:else class="end-photo-empty">
          <text class="photo-add-icon">+</text>
          <text class="end-photo-text">拍摄补充预约单</text>
        </view>
      </view>
    </view>

    <view class="sheet-bottom-space"></view>
  </scroll-view>

  <view class="sheet-foot">
    <view class="ds-btn ds-btn-ghost sheet-btn" catchtap="cancelEndForm">取消</view>
    <view class="ds-btn sheet-btn {{isSubmittingEnd ? 'is-busy' : ''}}" catchtap="submitEndForm">
      {{isSubmittingEnd ? '提交中…' : '确认结束'}}
    </view>
  </view>
</view>

<!-- 水印画布：必须保留，addWatermarkToPhoto 依赖它离屏绘制 -->
<canvas
  type="2d"
  id="watermarkCanvas"
  class="watermark-canvas"
></canvas>
