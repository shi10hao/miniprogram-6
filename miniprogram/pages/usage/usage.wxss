.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 通用区块 */
.status-section,
.photo-section,
.history-section,
.pending-section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-header {
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 未使用状态 */
.idle-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.idle-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.idle-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

/* 使用中状态 */
.using-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.using-info-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.using-label {
  font-size: 26rpx;
  color: #888;
  width: 160rpx;
  flex-shrink: 0;
}

.using-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.using-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

/* 按钮 */
.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 88rpx;
  background: #62BCC4;
  color: white;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
}

.btn-icon {
  font-size: 36rpx;
}

.upload-mid-btn {
  flex: 1;
  height: 80rpx;
  background: #fff8e1;
  color: #f57f17;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ffcc02;
}

.end-btn {
  flex: 1;
  height: 80rpx;
  background: #f0f7ff;
  color: #1976d2;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: 1rpx solid #90caf9;
}

/* 使用中照片 */
.photo-block,
.end-photo-block {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.photos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  aspect-ratio: 1;
  border-radius: 10rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.empty-photos {
  padding: 40rpx 0;
  text-align: center;
}

.empty-photos-text {
  font-size: 26rpx;
  color: #bbb;
}

/* 结束照片槽 */
.end-photo-slot {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.slot-label {
  font-size: 26rpx;
  color: #555;
  font-weight: 500;
}

.slot-upload {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx dashed #ccc;
  position: relative;
}

.slot-preview {
  width: 100%;
  height: 100%;
  position: relative;
}

.slot-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.slot-done-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: #4caf50;
  color: white;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.slot-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  gap: 8rpx;
}

.slot-plus {
  font-size: 48rpx;
  color: #bbb;
  line-height: 1;
}

.slot-tip {
  font-size: 22rpx;
  color: #bbb;
}

/* 结束操作按钮 */
.end-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.cancel-end-btn {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}

.confirm-end-btn {
  flex: 2;
  height: 80rpx;
  background: #62BCC4;
  color: white;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
}

.confirm-end-btn.disabled {
  background: #b2d8dc;
}

/* 历史记录 */
.loading-text,
.empty-history {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #eee;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.history-device {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.history-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.history-status.using {
  background: #fff3cd;
  color: #856404;
}

.history-status.completed {
  background: #d4edda;
  color: #155724;
}

.history-status.abnormal {
  background: #ffdbdb;
  color: #ff0000;
}

.history-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.history-label {
  font-size: 24rpx;
  color: #888;
  width: 100rpx;
}

.history-val {
  font-size: 24rpx;
  color: #555;
  flex: 1;
}

.pending-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pending-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #eee;
}

.pending-item.ready {
  border-color: #62BCC4;
  background: #f0fafb;
}

.pending-item.expired {
  opacity: 0.6;
}

.pending-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.pending-device {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.pending-state {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.pending-state.ready {
  background: #d4edda;
  color: #155724;
}

.pending-state.pending {
  background: #fff3cd;
  color: #856404;
}

.pending-state.expired {
  background: #f5f5f5;
  color: #999;
}

.pending-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.pending-label {
  font-size: 24rpx;
  color: #888;
  width: 120rpx;
}

.pending-val {
  font-size: 24rpx;
  color: #555;
  flex: 1;
}

.start-reserve-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #62BCC4, #4da9b1);
  color: white;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  padding: 0;
}

.start-reserve-btn[disabled] {
  background: #a8d8dc;
  color: #f0f0f0;
}

/* ✅ 未登录提示条 */
.login-tip {
  background: #fff8e1;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #8a6d3b;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tip-login-btn {
  background: #62BCC4;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: none;
}

/* 遮罩层 */
.feedback-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

/* 弹窗卡片 */
.feedback-card {
  width: 85%;
  max-width: 400px;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 头部 */
.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.feedback-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.feedback-close {
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
}
/* 使用中反馈按钮 */
.feedback-btn-inline {
  margin-top: 20rpx;
  flex: 1;
  height: 90rpx;
  width: 100%;
  background: #ffebee;
  color: #c62828;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ef9a9a;
}

/* 反馈表单扩展样式 */
.feedback-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.feedback-photo-section {
  margin: 24rpx 0;
}

.photo-upload-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.photo-slot, .photo-add-slot {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.photo-slot .slot-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.slot-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(0,0,0,0.6);
  color: white;
  font-size: 28rpx;
  border-bottom-left-radius: 8rpx;
}

.photo-add-slot {
  border: 2rpx dashed #ccc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: #fafafa;
}

.photo-add-slot .slot-plus {
  font-size: 40rpx;
  color: #bbb;
  line-height: 1;
}

.photo-add-slot .slot-tip {
  font-size: 20rpx;
  color: #bbb;
}

.feedback-end-option {
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #fff8e1;
  border-radius: 8rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #8a6d3b;
}

.feedback-submit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #62BCC4, #4da9b1);
  color: white;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: none;
  margin-top: 8rpx;
}

.feedback-submit-btn[disabled] {
  background: #b2d8dc;
}

/* ===== 结束信息表单浮层 ===== */
.end-form-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.end-form-card {
  width: 680rpx;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.end-form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.end-form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.end-form-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.end-form-body {
  flex: 1;                         /* 占据剩余空间 */
  padding: 24rpx 32rpx;
  overflow-y: auto;                /* 内容超出时滚动 */
  -webkit-overflow-scrolling: touch; /* iOS 平滑滚动 */
}

.form-row {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-label.required::before {
  content: '*';
  color: #e74c3c;
  margin-right: 4rpx;
}

.form-options {
  display: flex;
  gap: 20rpx;
}

.option-btn {
  padding: 14rpx 40rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border: 2rpx solid #e0e0e0;
}

.option-btn.active {
  background: #e3f2fd;
  color: #1976d2;
  border-color: #1976d2;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #e8ecf0;
  box-sizing: border-box;
}

.form-upload {
  width: 160rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.upload-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f9fc;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
}

.upload-plus {
  font-size: 48rpx;
  color: #bbb;
  line-height: 1;
}

.upload-tip {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.upload-preview {
  width: 100%;
  height: 100%;
  position: relative;
}

.upload-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.upload-change {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  padding: 6rpx 0;
}

.end-form-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.form-cancel-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 38rpx;
}

.form-submit-btn {
  flex: 2;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: #62BCC4;
  border-radius: 38rpx;
}

.form-submit-btn[disabled] {
  opacity: 0.5;
}