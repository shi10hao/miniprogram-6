/* 仪器使用页：渐变头部 + 叠压卡片，视觉与 reserve-detail 保持一致 */
.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  background: var(--ds-bg);
}

/* ---------------- 头部 ---------------- */
.hero {
  padding: 40rpx var(--ds-gap) 96rpx;
  background: linear-gradient(160deg, var(--ds-primary) 0%, var(--ds-primary-dark) 100%);
  color: #fff;
}

.hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--ds-gap);
}

.hero-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.hero-eyebrow {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: var(--ds-radius-pill);
  background: rgba(255, 255, 255, 0.22);
}

.hero-badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

/* 使用中用呼吸点强调「正在进行」 */
.hero-badge.is-using .hero-badge-dot {
  background: #fff;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.28);
}

.hero-badge-text {
  font-size: 24rpx;
  color: #fff;
}

.hero-sub {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--ds-gap-sm);
  margin-top: 18rpx;
}

.hero-meta-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-meta-pill {
  padding: 6rpx 20rpx;
  border-radius: var(--ds-radius-pill);
  background: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ds-primary-deep);
}

/* ---------------- 内容区叠压 ---------------- */
.body {
  margin-top: -64rpx;
  padding: 0 var(--ds-gap);
}

.section-gap {
  margin-top: var(--ds-gap-lg);
}

/* ---------------- 提醒横幅 ---------------- */
.remind {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--ds-gap-sm);
  padding: var(--ds-gap) var(--ds-gap-lg);
  margin-bottom: var(--ds-gap);
  border-radius: var(--ds-radius);
  background: var(--ds-surface);
  box-shadow: var(--ds-shadow-sm);
}

.remind-mark {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--ds-warning);
}

.remind-main {
  flex: 1;
  min-width: 0;
}

.remind-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--ds-gap-sm);
}

.remind-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ds-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remind-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.remind-text {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ds-text-secondary);
  line-height: 1.5;
}

.remind-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--ds-primary);
}

.remind-close {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

/* ---------------- 空态 / 未认证 ---------------- */
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--ds-gap-xl) var(--ds-gap-lg);
  text-align: center;
}

.state-icon {
  font-size: 64rpx;
  line-height: 1;
}

.state-title {
  margin-top: var(--ds-gap);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.state-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--ds-text-secondary);
  line-height: 1.6;
}

.state-btn {
  margin-top: var(--ds-gap-lg);
}

/* ---------------- 卡片内的通用行 ---------------- */
.card-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--ds-gap-sm);
}

.card-row-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.card-row-label {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.card-row-value {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.info-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--ds-gap);
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--ds-divider);
}

.info-row:last-of-type {
  border-bottom: none;
}

.info-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--ds-text);
}

.info-strong {
  font-weight: 600;
  color: var(--ds-primary-deep);
}

.card-actions {
  margin-top: var(--ds-gap);
}

.ghost-actions {
  display: flex;
  gap: var(--ds-gap-sm);
  margin-top: var(--ds-gap-sm);
}

.ghost-btn {
  flex: 1;
  height: 76rpx;
  font-size: 27rpx;
}

/* ---------------- 照片 ---------------- */
.photo-head {
  margin-bottom: var(--ds-gap-sm);
}

.photo-count {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ds-gap-sm);
}

.photo-tile {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 196rpx;
  border-radius: var(--ds-radius-sm);
  overflow: hidden;
  background: var(--ds-fill);
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-broken {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx dashed var(--ds-border);
  background: var(--ds-primary-soft);
}

.photo-add:active {
  opacity: 0.8;
}

.photo-add-icon {
  font-size: 44rpx;
  line-height: 1;
  color: var(--ds-primary);
}

.photo-add-text {
  font-size: 22rpx;
  color: var(--ds-primary);
}

.photo-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(31, 39, 51, 0.55);
  color: #fff;
  font-size: 20rpx;
}

.photo-hint {
  display: block;
  margin-top: var(--ds-gap-sm);
  font-size: 23rpx;
  color: var(--ds-text-muted);
  line-height: 1.5;
}

/* ---------------- 待使用预约 ---------------- */
.reserve-card {
  position: relative;
}

.reserve-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.reserve-id {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--ds-text-muted);
}

.reserve-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ds-gap);
  margin-top: var(--ds-gap);
}

.reserve-hint {
  font-size: 24rpx;
  color: var(--ds-text-secondary);
}

.reserve-hint.is-ready {
  color: var(--ds-success);
  font-weight: 600;
}

.reserve-btn {
  height: 68rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
}

.reserve-btn.is-disabled {
  background: var(--ds-fill);
  color: var(--ds-text-disabled);
}

/* ---------------- 骨架屏 ---------------- */
.sk-line {
  height: 26rpx;
  margin-bottom: var(--ds-gap-sm);
  border-radius: 8rpx;
}

.sk-line-title {
  width: 45%;
  height: 34rpx;
}

.sk-line-short {
  width: 32%;
  margin-bottom: 0;
}

/* ---------------- 使用历史 ---------------- */
.history-card:active {
  opacity: 0.92;
}

.history-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.history-feedback {
  display: flex;
  align-items: baseline;
  gap: var(--ds-gap-sm);
  margin-top: var(--ds-gap-sm);
  padding: 14rpx 18rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-danger-light);
}

.history-feedback-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--ds-danger);
}

.history-feedback-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ds-text-secondary);
  line-height: 1.5;
}

.history-more {
  display: block;
  margin-top: var(--ds-gap-sm);
  text-align: right;
  font-size: 23rpx;
  color: var(--ds-text-muted);
}

/* ---------------- 底部弹层 ---------------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(17, 24, 32, 0.45);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  display: flex;
  flex-direction: column;
  max-height: 88vh;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 32rpx 32rpx 0 0;
  background: var(--ds-surface);
  box-shadow: var(--ds-shadow-md);
}

.sheet-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-bottom: 1rpx solid var(--ds-divider);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.sheet-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

.sheet-scroll {
  height: 60vh;
  padding: 0 var(--ds-gap-lg);
  box-sizing: border-box;
}

.sheet-tip {
  margin: var(--ds-gap) 0;
  padding: 16rpx 20rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-warning-light);
  font-size: 23rpx;
  line-height: 1.55;
  color: #8a5b00;
}

.sheet-bottom-space {
  height: var(--ds-gap-lg);
}

/* ---------------- 表单 ---------------- */
.form-block {
  margin-bottom: var(--ds-gap-lg);
}

.form-label {
  display: block;
  margin-bottom: var(--ds-gap-sm);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.form-required {
  margin-left: 4rpx;
  color: var(--ds-danger);
}

/* input 是原生组件，没写 height 时用的是基础库给的默认高度（约 1.4rem）。
   之前这里只给了上下 padding，又配了 box-sizing: border-box，
   默认高度被 40rpx 的上下内边距吃掉，真正装文字的内容区只剩几条 rpx —— 看上去就是输入栏被压扁。
   所以输入框一律写死高度、内边距只留左右；textarea 的换行留白继续走上下 padding。 */
.form-input,
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: var(--ds-radius-sm);
  border: 1rpx solid var(--ds-border);
  background: var(--ds-fill);
  font-size: 27rpx;
  color: var(--ds-text);
}

.form-input {
  height: 88rpx;
  padding: 0 var(--ds-gap);
}

.form-textarea {
  height: 190rpx;
  padding: 20rpx var(--ds-gap);
  line-height: 1.6;
}

.form-placeholder {
  color: var(--ds-text-muted);
}

.form-counter {
  display: block;
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

/* 二选一：比 picker 更少的点击次数，也不会误触 */
.seg {
  display: flex;
  gap: var(--ds-gap-sm);
}

.seg-item {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: var(--ds-radius-sm);
  border: 1rpx solid var(--ds-border);
  background: var(--ds-fill);
  font-size: 27rpx;
  color: var(--ds-text-secondary);
}

.seg-item.is-on {
  border-color: var(--ds-primary);
  background: var(--ds-primary-light);
  color: var(--ds-primary-deep);
  font-weight: 600;
}

/* 结束表单的照片位 */
.end-photo {
  position: relative;
  width: 260rpx;
  height: 190rpx;
  border-radius: var(--ds-radius-sm);
  overflow: hidden;
  border: 2rpx dashed var(--ds-border);
  background: var(--ds-primary-soft);
}

.end-photo-img {
  width: 100%;
  height: 100%;
}

.end-photo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 100%;
}

.end-photo-text {
  font-size: 22rpx;
  color: var(--ds-primary);
}

.sheet-foot {
  display: flex;
  gap: var(--ds-gap-sm);
  padding: var(--ds-gap) var(--ds-gap-lg);
  border-top: 1rpx solid var(--ds-divider);
}

.sheet-btn {
  flex: 1;
}

.sheet-btn.is-busy {
  opacity: 0.6;
}

/* 水印画布：尺寸必须用 px，且移出可视区域，避免影响布局 */
.watermark-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1000px;
  pointer-events: none;
}
