page {
  background-color: #f0f4f8;
}
.container {
  padding: 24rpx;
  min-height: 100vh;
}

/*引导提示块*/
.guide-tip {
  background:#e8f4f5;
  color:#2d6a6e;
  font-size:26rpx;
  padding:20rpx 24rpx;
  border-radius:12rpx;
  margin-bottom:24rpx;
  line-height:1.6;
}

/*搜索框*/
.search-box {
  position: relative;
  background:#ffffff;
  border-radius:48rpx;
  padding:24rpx 32rpx 24rpx 88rpx;
  margin-bottom:32rpx;
}
.search-icon {
  position:absolute;
  left:32rpx;
  top:50%;
  transform: translateY(-50%);
  font-size:32rpx;
  color:#999;
}
.search-input {
  font-size:28rpx;
}

.block-title {
  font-size:30rpx;
  font-weight:600;
  color:#333;
  margin-bottom:20rpx;
}

.recent-wrap,.search-result-wrap {
  margin-bottom:30rpx;
}

.device-list {
  display:flex;
  flex-direction:column;
  gap:20rpx;
}

.device-card {
  position: relative;
  background:#fff;
  border-radius:16rpx;
  padding:32rpx;
  box-shadow:0 2rpx 12rpx rgba(0,0,0,0.06);
}
.dev-name {
  font-size:30rpx;
  font-weight:500;
  color:#222;
  margin-bottom:12rpx;
}

/*卡片右下角标签*/
.card-tag {
  position:absolute;
  right:24rpx;
  bottom:24rpx;
  background:#62BCC4;
  color:#fff;
  font-size:22rpx;
  padding:6rpx 16rpx;
  border-radius:20rpx;
}

.empty {
  text-align:center;
  padding:80rpx 0;
  font-size:26rpx;
  color:#999;
}
.empty-small {
  font-size:26rpx;
  color:#999;
  padding:20rpx 0;
}