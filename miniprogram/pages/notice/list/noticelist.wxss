.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  margin-top: 20rpx;
  color: #666;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 公告列表 */
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 10rpx 20rpx;
}

/* 公告项 */
.notice-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  transition: background-color 0.2s;
}

.notice-item:active {
  background-color: #f9f9f9;
}

/* 公告标题 */
.notice-title {
  font-size: 32rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 发布日期 */
.notice-date {
  font-size: 26rpx;
  color: #999;
  margin-top: auto;
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  color: #666;
  font-size: 26rpx;
  gap: 10rpx;
}
    