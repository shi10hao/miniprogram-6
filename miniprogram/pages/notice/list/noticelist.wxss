/* 公告列表页样式 —— 只用 app.wxss 的 --ds-* 变量与 ds-* 类，不新造色值 */

/* --------------------------------------------------------------------------
   页面标题（与首页 / 消息页同一套 hero 样式）
   -------------------------------------------------------------------------- */
.hero {
  padding: 16rpx 8rpx 40rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: var(--ds-text);
  letter-spacing: 1rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

/* --------------------------------------------------------------------------
   骨架屏
   -------------------------------------------------------------------------- */
.skeleton-main {
  display: flex;
  gap: var(--ds-gap);
}

.skeleton-date {
  width: 96rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.skeleton-body {
  flex: 1;
  min-width: 0;
}

.skeleton-line {
  height: 24rpx;
  margin-bottom: 16rpx;
}

.skeleton-line-title {
  width: 70%;
  height: 30rpx;
}

.skeleton-line-short {
  width: 45%;
  margin-bottom: 0;
}

/* --------------------------------------------------------------------------
   公告卡片
   -------------------------------------------------------------------------- */
.notice-card {
  display: flex;
  align-items: flex-start;
  gap: var(--ds-gap);
  padding: 28rpx var(--ds-gap-lg);
  margin-bottom: var(--ds-gap-sm);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
  transition: background 0.2s ease;
}

/* 真机上 view 的 :active 常常不触发，按下反馈走 hover-class（见 wxml） */
.notice-card-hover {
  background: var(--ds-fill);
}

.notice-card:active {
  background: var(--ds-fill);
}

/* 日期块：月在上日在下，颜色取主色浅色，弱化但可扫读 */
.notice-date {
  width: 96rpx;
  padding: 14rpx 0;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--ds-primary-light);
  border-radius: var(--ds-radius-sm);
}

.notice-date-day {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.15;
  color: var(--ds-primary-deep);
}

.notice-date-month {
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--ds-primary-dark);
}

.notice-main {
  flex: 1;
  min-width: 0;
}

.notice-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.notice-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ds-text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* NEW 角标：只给三天内的公告，避免满屏红点 */
.notice-new {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--ds-radius-pill);
  font-size: 20rpx;
  line-height: 1.5;
  color: #fff;
  background: var(--ds-primary);
}

.notice-preview {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--ds-text-secondary);
}

.notice-foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.notice-time {
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

/* 阅读全文：靠右、主色、弱化字重，作为卡片的"可点"暗示 */
.notice-more {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--ds-primary);
}

/* --------------------------------------------------------------------------
   底部加载状态
   -------------------------------------------------------------------------- */
.list-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--ds-gap) 0 var(--ds-gap-lg);
}

.list-foot-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

.ds-spinner.small {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  margin-bottom: 0;
}

.load-more-btn {
  padding: 16rpx 48rpx;
  font-size: 26rpx;
  color: var(--ds-primary);
  border: 1rpx solid var(--ds-primary);
  border-radius: var(--ds-radius-pill);
}

.load-more-btn:active,
.load-more-hover {
  background: var(--ds-primary-light);
}

.list-foot-text {
  font-size: 24rpx;
  color: var(--ds-text-disabled);
}

/* 失败态按钮：不要撑满整行 */
.retry-btn {
  height: 68rpx;
  margin-top: var(--ds-gap-lg);
  padding: 0 48rpx;
  font-size: 26rpx;
}

.retry-btn-hover {
  opacity: 0.7;
}
