<view class="container">

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading">加载中...</view>

  <!-- 详情内容 -->
  <view wx:else>
    <!-- 有公告数据时显示 -->
    <view wx:if="{{notice}}" class="detail-content">
      <!-- 标题（改为正文标题，非导航栏标题） -->
      <view class="detail-title">{{notice.title}}</view>
      
      <!-- 发布日期 -->
      <view class="detail-date">发布日期：{{notice.publish_date}}</view>

      <!-- 正文内容 -->
      <view class="detail-content-text">
        {{notice.content || '暂无内容'}}
      </view>

      <!-- ↓ 新增：协作文档按钮（有链接才显示） -->
      <view wx:if="{{notice.doc_url}}" class="doc-btn" bindtap="openDoc">
        <text class="doc-btn-icon">📄</text>
        <text class="doc-btn-text">打开协作文档</text>
        <text class="doc-btn-arrow">></text>
      </view>
    </view>

    <!-- 无公告数据时显示 -->
    <view wx:else class="empty">未找到该公告</view>
  </view>
</view>