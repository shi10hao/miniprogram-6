.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  padding: 40rpx 32rpx;
  margin: 32rpx 0;
}

.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.lab-name-item {
  border-bottom: 2rpx solid #eee;
  padding-bottom: 20rpx;
}

.form-label {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333;
}

.form-input {
  font-size: 28rpx;
  padding: 10rpx 0;
  border-bottom: 2rpx solid #eee;
}

.upload-item {
  align-items: flex-start;
}

.upload-btn {
  background: linear-gradient(to right, #07c160, #09cc7f);
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.image-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 30rpx;
  height: 30rpx;
  background-color: #ff5a5f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: white;
}

.submit-btn {
  background: linear-gradient(to right, #07c160, #09cc7f);
  color: white;
  border: none;
  border-radius: 40rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  background: #a8d8dc;
  color: #f5f5f5;
}
