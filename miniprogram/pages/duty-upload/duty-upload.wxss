/* 安全员打卡：品牌色头部 + 三张表单卡片 */
.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 头部 ---------- */
.hero {
  padding: 36rpx 40rpx 104rpx;
  background: linear-gradient(160deg, var(--ds-primary) 0%, var(--ds-primary-dark) 100%);
  color: #fff;
}

.hero-eyebrow {
  display: block;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.85;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.88;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--ds-radius-pill);
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.hero-badge-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

.body {
  margin-top: -48rpx;
  padding: 0 var(--ds-gap);
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 28rpx;
}

.field-last {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
}

.field-required {
  margin-left: 4rpx;
  color: var(--ds-danger);
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
  font-size: 28rpx;
  color: var(--ds-text);
}

.field-input.is-error {
  background: var(--ds-danger-light);
}

.field-placeholder {
  color: var(--ds-text-disabled);
}

.field-error {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ds-danger);
}

.sec-hint {
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

/* ---------- 照片 ---------- */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item,
.photo-add {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--ds-radius-sm);
  overflow: hidden;
  box-sizing: border-box;
}

.photo-item {
  background: var(--ds-fill);
}

.photo-img {
  display: block;
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(31, 39, 51, 0.55);
  color: #fff;
  font-size: 20rpx;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 1rpx dashed var(--ds-border);
  background: var(--ds-fill);
  color: var(--ds-text-muted);
}

.photo-add:active {
  background: var(--ds-primary-soft);
}

.photo-add-plus {
  font-size: 44rpx;
  line-height: 1;
  color: var(--ds-primary);
}

.photo-add-text {
  font-size: 22rpx;
}

.photo-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

/* ---------- 情况说明 ---------- */
.remark-box {
  position: relative;
  padding: 20rpx 24rpx 44rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
}

.remark-input {
  width: 100%;
  height: 168rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ds-text);
}

.remark-count {
  position: absolute;
  right: 20rpx;
  bottom: 12rpx;
  font-size: 22rpx;
  color: var(--ds-text-disabled);
}

/* ---------- 提交 ---------- */
.submit-btn {
  box-sizing: border-box;
  margin-top: var(--ds-gap-lg);
}

.is-disabled {
  opacity: 0.6;
}

.submit-tip {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}
