/* 顶部状态标签 */
.status-badge {
  align-self: flex-start;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  font-weight: 500;
  margin-top: 12rpx;
}

.status-badge.upcoming {
  background: #e3f2fd;
  color: #1565c0;
}

.status-badge.using {
  background: #fff8e1; color: #f57c00;
}

.status-badge.completed {
  background: #e8f5e9; color: #2e7d32;
}

.status-badge.abnormal {
  background: #e2e2e2; color: #ff0000;
}

.container {
  min-height: 100vh;
  background: #f0f4f8;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #2d6a6e, #62BCC4);
  padding: 48rpx 40rpx 36rpx;
}

.device-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

.center-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
  color: #aaa;
  font-size: 26rpx;
}

.loading-spin {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #62BCC4;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.content {
  padding: 24rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.empty-hint {
  text-align: center;
  color: #aaa;
  font-size: 24rpx;
  padding: 40rpx 0;
}

.photo-section {
  margin-top: 16rpx;
}

.usage-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #eee;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 仪器信息卡片 */
.info-card {
  background: white;
  border-radius: 20rpx;
  margin: 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.info-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 区域折叠 */
.section-title-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 24rpx;
}

.section-title-wrap .section-title {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.feedback-section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.feedback-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 异常处理按钮区域 */
.abnormal-action {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.resolve-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  background: #e74c3c;
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: none;
}

.resolve-btn::after {
  border: none;
}

/* 处理中提示 */
.handling-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 结束信息展示 */
.end-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.end-info-row:last-of-type {
  border-bottom: none;
}

.end-info-label {
  font-size: 26rpx;
  color: #666;
}

.end-info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.end-info-value.yes {
  color: #2e7d32;
}

.end-info-value.no {
  color: #c62828;
}

.end-info-photo-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.end-info-photo-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

/* 基本信息列表 - 上下结构 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.info-item-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
  word-break: break-all;
}