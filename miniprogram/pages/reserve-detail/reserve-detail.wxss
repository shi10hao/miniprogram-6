/* pages/reserve-detail/reserve-detail.wxss */

.page {
  min-height: 100vh;
  background: var(--ds-bg);
  padding-bottom: 48rpx;
}

/* ==================== 顶部 ==================== */

.hero {
  padding: 36rpx 40rpx 120rpx;
  background: linear-gradient(160deg, var(--ds-primary), var(--ds-primary-dark));
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-eyebrow {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 2rpx;
}

.hero-chip {
  font-size: 22rpx;
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: var(--ds-radius-pill);
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.hero-chip-abnormal {
  background: #fff;
  color: var(--ds-danger);
  border-color: #fff;
  font-weight: 600;
}

.hero-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.body {
  margin-top: -72rpx;
  padding: 0 var(--ds-gap);
}

/* ==================== 状态提示 ==================== */

.tip {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx 28rpx;
  margin-bottom: var(--ds-gap);
  border-radius: var(--ds-radius);
  background: var(--ds-surface);
  box-shadow: var(--ds-shadow-sm);
}

.tip-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--ds-primary);
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
  line-height: 1.6;
}

.tip-using .tip-dot {
  background: var(--ds-warning);
}

.tip-completed .tip-dot {
  background: var(--ds-success);
}

.tip-abnormal {
  background: var(--ds-danger-light);
}

.tip-abnormal .tip-dot {
  background: var(--ds-danger);
}

.tip-abnormal .tip-text {
  color: var(--ds-danger);
}

/* ==================== 卡片通用 ==================== */

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--ds-gap);
}

.card-hint {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--ds-gap);
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--ds-divider);
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 26rpx;
  color: var(--ds-text-muted);
  flex-shrink: 0;
}

.row-value {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ds-text);
  text-align: right;
  word-break: break-all;
}

.is-yes {
  color: var(--ds-success);
}

.is-no {
  color: var(--ds-danger);
}

/* ==================== 异常反馈 ==================== */

.abnormal-card {
  border-left: 8rpx solid var(--ds-danger);
}

.abnormal-card.is-resolved {
  border-left-color: var(--ds-border);
}

.abnormal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
  margin-bottom: 12rpx;
}

.abnormal-desc {
  font-size: 28rpx;
  color: var(--ds-text-secondary);
  line-height: 1.7;
  word-break: break-all;
}

.abnormal-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.abnormal-photos {
  margin-top: 20rpx;
}

.abnormal-handled {
  margin-top: var(--ds-gap);
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ds-divider);
  font-size: 24rpx;
  color: var(--ds-success);
}

.abnormal-wait {
  margin-top: var(--ds-gap);
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ds-divider);
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.resolve-btn {
  margin-top: var(--ds-gap);
  background: var(--ds-danger);
  color: #fff;
  border: none;
}

.resolve-btn::after {
  border: none;
}

/* ==================== 照片 ==================== */

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo {
  width: 196rpx;
  height: 196rpx;
  border-radius: 12rpx;
  background: var(--ds-fill);
}

.photo-sm {
  width: 156rpx;
  height: 156rpx;
}

.sub-photos {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ds-gap);
  margin-top: var(--ds-gap);
  padding-top: var(--ds-gap);
  border-top: 1rpx solid var(--ds-divider);
}

.sub-photo {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sub-photo-label {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.empty-photo {
  text-align: center;
  padding: 48rpx var(--ds-gap-lg);
}

.empty-photo-text {
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

.foot-hint {
  padding: 8rpx 0 var(--ds-gap-lg);
  text-align: center;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

/* ==================== 状态卡 / 骨架屏 ==================== */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx;
  text-align: center;
}

.state-icon {
  font-size: 72rpx;
  line-height: 1.2;
}

.state-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.state-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
  line-height: 1.6;
}

.state-btn {
  margin-top: var(--ds-gap-lg);
  box-sizing: border-box;
}

.state-btn::after {
  border: none;
}

.sk-card {
  border-radius: var(--ds-radius);
}

.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.sk-line-lg {
  width: 60%;
}

.sk-line-sm {
  width: 35%;
  margin-bottom: 0;
}
