<view class="container">
  <!-- 顶部状态 -->
  <view class="header">
    <view class="info-card-header">
      <text class="device-name">预约详情</text>
      <view class="status-badge {{status}}">
        {{status === 'upcoming' ? '即将到来' : status === 'using' ? '使用中' : status === 'abnormal' ? '出现问题' : '已完成'}}
      </view>
    </view>

    <!-- 新增：异常处理按钮 -->
    <view wx:if="{{status === 'abnormal' && !isHandlingAbnormal}}" class="abnormal-action">
      <button class="resolve-btn" bindtap="onResolveAbnormal">标记为已处理</button>
    </view>

  </view>

  <!-- 加载中 -->
  <view wx:if="{{isLoading}}" class="center-hint">
    <view class="loading-spin"></view>
    <text>加载中...</text>
  </view>

  <view wx:else class="content">
    <!-- 基本信息 -->
    <view class="info-card">
      <view class="info-card-header">
        <text class="info-card-title">预约信息</text>
      </view>

      <view class="info-list">
        <view class="info-item">
          <text class="info-item-label">使用人员:</text>
          <text class="info-item-value">{{detail.student_name || detail.user_id}}</text>
        </view>
        <view class="info-item">
          <text class="info-item-label">课题组:</text>
          <text class="info-item-value">{{detail.group_name || '未填写'}}</text>
        </view>
        <view class="info-item">
          <text class="info-item-label">仪器编号:</text>
          <text class="info-item-value">{{detail.device_id}}</text>
        </view>
        <view class="info-item">
          <text class="info-item-label">仪器名称:</text>
          <text class="info-item-value">{{detail.device_name}}</text>
        </view>
        <view class="info-item">
          <text class="info-item-label">预约时间:</text>
          <text class="info-item-value">{{detail.dateDisplay}} {{detail.timeDisplay}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{status === 'abnormal'}}" class=" wrong-section">

      <!-- 新增：处理中状态 -->
      <view wx:if="{{isHandlingAbnormal}}" class="handling-hint">
        <view class="loading-spin"></view>
        <text>处理中...</text>
      </view>

      <view class="feedback-section">
        <text class="feedback-section-title">问题反馈</text>
        <text class="feedback-title-content">{{feedback.title}}</text>
      </view>
      <view class="feedback-section">
        <text class="feedback-section-title">详细内容</text>
        <text class="feedback-content-content">{{feedback.content}}</text>
      </view>
      <view class="feedback-section">
        <text class="feedback-section-title">反馈时间</text>
        <text class="feedback-content-content">{{feedback.submit_time_display}}</text>
      </view>
      <!-- 新增：反馈照片 -->
      <view wx:if="{{detail.feedbackPhotoUrls && detail.feedbackPhotoUrls.length > 0}}" class="feedback-section">
        <text class="feedback-section-title">反馈照片（{{detail.feedbackPhotoUrls.length}}）</text>
        <view class="photo-grid">
          <image wx:for="{{detail.feedbackPhotoUrls}}" wx:key="*this" class="usage-photo" src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}" data-urls="{{allPhotos}}" />
        </view>
      </view>
    </view>

    <view wx:else class="ok-section">
      <!-- 开始照片 -->
      <view class="section">
        <view class="section-title-wrap">
          <text class="section-title">开始照片</text>
        </view>
        <view class="photo-section">
          <image wx:if="{{detail.startPhotoUrl}}" class="usage-photo" src="{{detail.startPhotoUrl}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{detail.startPhotoUrl}}" data-urls="{{allPhotos}}" />
          <text wx:else class="empty-hint">暂无照片</text>
        </view>
      </view>

      <!-- 使用照片（多张） -->
      <view class="section">
        <view class="section-title-wrap">
          <text class="section-title">使用照片（{{detail.usageImageUrls.length}}）</text>
        </view>
        <view wx:if="{{detail.usageImageUrls.length > 0}}" class="photo-grid">
          <image wx:for="{{detail.usageImageUrls}}" wx:key="*this" class="usage-photo" src="{{item}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}" data-urls="{{allPhotos}}" />
        </view>
        <text wx:else class="empty-hint">暂无照片</text>
      </view>

      <!-- 系统预约单 -->
      <view class="section">
        <view class="section-title-wrap">
          <text class="section-title">系统预约单</text>
        </view>
        <view class="photo-section">
          <image wx:if="{{detail.reservePageUrl}}" class="usage-photo" src="{{detail.reservePageUrl}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{detail.reservePageUrl}}" data-urls="{{allPhotos}}" />
          <text wx:else class="empty-hint">未上传预约单</text>
        </view>
      </view>

      <!-- 结束信息 -->
      <view wx:if="{{detail.endChecklistDisplay}}" class="section">
        <view class="section-title-wrap">
          <text class="section-title">结束使用信息</text>
        </view>

        <!-- 仪器是否关闭 -->
        <view class="end-info-row">
          <text class="end-info-label">仪器关闭</text>
          <text class="end-info-value {{detail.endChecklistDisplay.instrumentOff ? 'yes' : 'no'}}">{{detail.endChecklistDisplay.instrumentOff ? '是' : '否'}}</text>
        </view>

        <!-- 电脑是否关闭 -->
        <view class="end-info-row">
          <text class="end-info-label">电脑关闭</text>
          <text class="end-info-value {{detail.endChecklistDisplay.computerOff ? 'yes' : 'no'}}">{{detail.endChecklistDisplay.computerOff ? '是' : '否'}}</text>
        </view>

        <!-- 运行样品总数 -->
        <view class="end-info-row">
          <text class="end-info-label">运行样品总数</text>
          <text class="end-info-value">{{detail.endChecklistDisplay.sampleCount}} 个</text>
        </view>

        <!-- 是否需要补充预约 -->
        <view class="end-info-row">
          <text class="end-info-label">补充预约</text>
          <text class="end-info-value {{detail.endChecklistDisplay.needSupplement ? 'yes' : 'no'}}">{{detail.endChecklistDisplay.needSupplement ? '是' : '否'}}</text>
        </view>

        <!-- 总的预约单图片 -->
        <view wx:if="{{detail.endChecklistDisplay.totalPageUrl}}" class="end-info-photo-section">
          <text class="end-info-photo-label">总的预约单</text>
          <image class="usage-photo" src="{{detail.endChecklistDisplay.totalPageUrl}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{detail.endChecklistDisplay.totalPageUrl}}" data-urls="{{allPhotos}}" />
        </view>

        <!-- 补充预约单图片 -->
        <view wx:if="{{detail.endChecklistDisplay.supplementPageUrl}}" class="end-info-photo-section">
          <text class="end-info-photo-label">补充预约单</text>
          <image class="usage-photo" src="{{detail.endChecklistDisplay.supplementPageUrl}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{detail.endChecklistDisplay.supplementPageUrl}}" data-urls="{{allPhotos}}" />
        </view>
      </view>
    </view>

  </view>
</view>