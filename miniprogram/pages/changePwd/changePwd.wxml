<view class="container">
  <view class="card">
    <view class="title">修改密码</view>
    <view class="desc">首次登录请修改初始密码（初始密码为手机号）</view>

    <view class="form-item">
      <text class="label">新密码</text>
      <input class="input" placeholder="请输入新密码（至少6位）" password value="{{newPwd}}" bindinput="onNewPwdInput" />
    </view>

    <view class="form-item">
      <text class="label">确认密码</text>
      <input class="input" placeholder="请再次输入新密码" password value="{{confirmPwd}}" bindinput="onConfirmPwdInput" />
    </view>

    <text class="error" wx:if="{{errMsg}}">{{errMsg}}</text>

    <button class="submit-btn" bindtap="doChange" disabled="{{loading}}">
      {{loading ? '提交中...' : '确认修改'}}
    </button>
  </view>
</view>