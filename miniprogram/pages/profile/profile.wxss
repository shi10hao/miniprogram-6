page {
  background: #f0f4f8;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #2d6a6e, #62BCC4);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(98, 188, 196, 0.3);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 详细信息卡片 */
.info-card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.admin-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.admin-item:last-child {
  border-bottom: none;
}

.admin-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.admin-icon {
  font-size: 40rpx;
}

.admin-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.admin-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.admin-role {
  font-size: 22rpx;
  color: #999;
}

.admin-contact-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding-left: 56rpx;
  gap: 12rpx;
}

.admin-phone-label {
  font-size: 24rpx;
  color: #999;
}

.admin-phone {
  font-size: 26rpx;
  color: #62BCC4;
  font-weight: 500;
}

/* 功能菜单 */
.menu-card {
  background: white;
  border-radius: 20rpx;
  padding: 16rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 20rpx;
  position: relative;
}

.menu-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 84rpx;
  right: 32rpx;
  height: 1rpx;
  background: #f0f0f0;
}

.menu-item:last-child::after {
  display: none;
}

.menu-icon {
  font-size: 40rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.menu-arrow {
  font-size: 48rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* 退出登录 */
.logout-section {
  margin-top: 40rpx;
  padding: 0 32rpx 40rpx;
}

.logout-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: white;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.logout-button::after {
  border: none;
}
