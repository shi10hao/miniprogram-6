/* 我的页面样式 —— 使用 app.wxss 的设计变量 */

/* --------------------------------------------------------------------------
   用户卡
   白底 + 顶部品牌色细条，克制但有品牌识别度
   -------------------------------------------------------------------------- */
.profile-card {
  position: relative;
  padding: var(--ds-gap-lg);
  padding-top: 44rpx;
  margin-bottom: var(--ds-gap);
  background: var(--ds-surface);
  border-radius: var(--ds-radius-lg);
  box-shadow: var(--ds-shadow);
  overflow: hidden;
}

/* 顶部品牌色细条 */
.profile-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, var(--ds-primary-deep), var(--ds-primary));
}

.profile-main {
  display: flex;
  align-items: center;
  gap: var(--ds-gap);
}

.profile-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--ds-primary-deep), var(--ds-primary));
  box-shadow: 0 6rpx 20rpx var(--ds-primary-shadow);
  flex-shrink: 0;
}

.profile-text {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ds-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-verified {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: var(--ds-radius-sm);
  font-size: 20rpx;
  color: var(--ds-primary-dark);
  background: var(--ds-primary-light);
}

.profile-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-id {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

/* --------------------------------------------------------------------------
   数据概览
   -------------------------------------------------------------------------- */
.stat-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: var(--ds-gap-lg);
  padding-top: var(--ds-gap);
  border-top: 1rpx solid var(--ds-divider);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
}

.stat-item:active {
  opacity: 0.6;
}

/* 用分隔线代替边框，视觉更轻 */
.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 52rpx;
  background: var(--ds-divider);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--ds-text);
  font-variant-numeric: tabular-nums;
}

/* 有正在使用的仪器时才高亮，起到提醒作用 */
.stat-num.active {
  color: var(--ds-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

/* --------------------------------------------------------------------------
   常用服务：图标磁贴
   -------------------------------------------------------------------------- */
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--ds-gap-sm);
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-radius: var(--ds-radius-sm);
}

.service-item:active {
  background: var(--ds-primary-soft);
}

.service-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  background: var(--ds-primary-light);
}

.service-label {
  font-size: 24rpx;
  color: var(--ds-text-secondary);
  text-align: center;
}

/* --------------------------------------------------------------------------
   未登录
   -------------------------------------------------------------------------- */
.hero {
  padding: 24rpx 8rpx 44rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: var(--ds-text);
  letter-spacing: 1rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

.login-panel {
  padding: var(--ds-gap-xl) var(--ds-gap-lg);
  margin-bottom: var(--ds-gap);
  text-align: center;
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
}

.login-panel-text {
  display: block;
  margin-bottom: var(--ds-gap-lg);
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

.login-btn {
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: var(--ds-primary);
  border-radius: var(--ds-radius-pill);
  line-height: 88rpx;
}

/* --------------------------------------------------------------------------
   菜单（未登录时的关于入口）
   -------------------------------------------------------------------------- */
.menu-group {
  overflow: hidden;
}

/* --------------------------------------------------------------------------
   联系管理员
   -------------------------------------------------------------------------- */
.admin-item {
  padding: 20rpx 0;
  position: relative;
}

.admin-item + .admin-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: var(--ds-divider);
  transform: scaleY(0.5);
}

.admin-row {
  display: flex;
  align-items: center;
  gap: var(--ds-gap-sm);
}

.admin-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-primary-dark);
  background: var(--ds-primary-light);
  flex-shrink: 0;
}

.admin-detail {
  flex: 1;
  min-width: 0;
}

.admin-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ds-text);
}

.admin-role {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.admin-phone {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ds-primary);
  flex-shrink: 0;
}

/* --------------------------------------------------------------------------
   退出登录
   -------------------------------------------------------------------------- */
.logout-section {
  margin-top: var(--ds-gap-lg);
}

.logout-button {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: var(--ds-radius-pill);
}
