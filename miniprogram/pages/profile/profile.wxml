<view class="container">
  <view class="user-card">
    <view class="user-avatar">
      <text>{{avatarText}}</text>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.name}}</text>
      <text class="user-id">学号：{{userInfo.userId}}</text>
    </view>
  </view>

  <view class="info-card">
    <view class="info-row">
      <text class="info-label">专业</text>
      <text class="info-value">{{userInfo.major}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">课题组</text>
      <text class="info-value">{{userInfo.groupName}}</text>
    </view>
  </view>

  <view class="info-card" wx:if="{{adminContacts.length > 0}}">
    <view class="card-title">联系管理员</view>
    <view class="admin-item" wx:for="{{adminContacts}}" wx:key="_id">
      <view class="admin-row">
        <text class="admin-icon">👨‍🔬</text>
        <view class="admin-detail">
          <text class="admin-name">{{item.name}}</text>
          <text class="admin-role">{{item.role === 'admin' ? '系统管理员' : '课题组长'}}</text>
        </view>
      </view>
      <view class="admin-contact-row" wx:if="{{item.phone}}">
        <text class="admin-phone-label">电话</text>
        <text class="admin-phone" bindtap="callAdmin" data-phone="{{item.phone}}">......</text>
      </view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="navigateToAppointment">
      <text class="menu-icon">📋</text>
      <text class="menu-text">我的预约</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigateToFeedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">管理员消息</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigateToDutyUpload">
      <text class="menu-icon">📝</text>
      <text class="menu-text">值日人员</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="navigateToAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="logout-button" bindtap="logout">退出登录</button>
  </view>
</view>
