/* 工作台样式 —— 使用 app.wxss 的设计变量 */

/* --------------------------------------------------------------------------
   页面标题（与首页保持同一套 hero 样式）
   -------------------------------------------------------------------------- */
.hero {
  padding: 16rpx 8rpx 40rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: var(--ds-text);
  letter-spacing: 1rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

/* --------------------------------------------------------------------------
   使用概览
   -------------------------------------------------------------------------- */
.overview-card {
  padding: var(--ds-gap-lg) var(--ds-gap) var(--ds-gap);
}

.overview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--ds-gap-sm) var(--ds-gap);
}

.overview-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.overview-hint {
  font-size: 24rpx;
  color: var(--ds-primary);
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
  position: relative;
}

.overview-item:active {
  opacity: 0.7;
}

/* 用分隔线代替边框，视觉更轻 */
.overview-item + .overview-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 56rpx;
  background: var(--ds-divider);
}

.overview-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--ds-text);
  font-variant-numeric: tabular-nums;
}

.overview-num.accent {
  color: var(--ds-primary);
}

.overview-label {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

/* --------------------------------------------------------------------------
   使用提示
   -------------------------------------------------------------------------- */
.tips-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.tip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ds-primary);
  margin-top: 16rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ds-text-secondary);
}
