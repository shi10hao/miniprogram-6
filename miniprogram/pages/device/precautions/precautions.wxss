.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.header {
  background: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.content {
  background: white;
  padding: 30rpx;
  border-radius: 12rpx;
  min-height: 400rpx;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-line;
}

/* 保持原有样式，新增以下样式 */

.category {
  margin-bottom: 40rpx;
}

.category-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fa541c;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #fa541c;
}

.item {
  margin-bottom: 16rpx;
}

.item-content {
  display: flex;
  align-items: flex-start;
  line-height: 1.6;
}

.item-icon {
  margin-right: 12rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.item-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.plain-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-line;
}