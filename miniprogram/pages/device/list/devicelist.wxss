.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 统计信息卡片 */
.stats-card {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx 0;
}

.stat-number {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #62BCC4;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #666;
}

/* 搜索区域 */
.search-section {
  background: white;
  padding: 20rpx;
  margin-bottom: 10rpx;
}

.search-box {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 40rpx;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
  border: 1rpx solid #e9ecef;
}

.search-icon {
  position: absolute;
  right: 50rpx;
  font-size: 28rpx;
  color: #999;
}

.clear-search {
  position: absolute;
  right: 30rpx;
  font-size: 24rpx;
  color: #999;
  padding: 10rpx;
}

/* 筛选区域 */
.filter-section {
  background: white;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
}

.filter-group {
  margin-bottom: 30rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.filter-buttons {
  display: flex;
  gap: 20rpx;
}

.filter-btn {
  padding: 16rpx 32rpx;
  background: #f8f9fa;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-btn.active {
  background: #62BCC4;
  color: white;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #666;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 仪器列表 */
.device-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 20rpx;
}

/* 仪器卡片 */
.device-card {
  background-color: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.card-header {
  padding: 30rpx 30rpx 20rpx;
}

.device-basic {
  margin-bottom: 10rpx;
}

.device-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.device-tags {
  display: flex;
  gap: 12rpx;
}

.device-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
  color: white;
  display: flex;
  align-items: center;            /* 垂直居中 */
  justify-content: center;        /* 水平居中 */
  height: 48rpx;                  /* 固定高度 */
  min-width: 120rpx;           /* 最小宽度 */
  box-sizing: border-box;      /* 包含 padding */
  
  /* 文本样式 */
  text-align: center;
  white-space: nowrap;
  line-height: 1;
}

.device-tag.lab.public {
  background: #62BCC4;
}

.device-tag.lab.group {
  background: #ffc107;
  color: #333;
}

.device-tag.lab.mixed {
  background: #5a6abf;
}

.device-tag.type.large {
  background: #e74c3c;
}

.device-tag.type.small {
  background: #2ecc71;
}

/* 仪器图片 */
.device-image {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
}

.device-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lab-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  padding: 20rpx 30rpx;
  color: white;
}

.lab-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.lab-room {
  display: block;
  font-size: 22rpx;
  opacity: 0.9;
}

/* 仪器描述 */
.device-desc {
  padding: 20rpx 30rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 修改：设备名称行样式 */
.device-name-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.device-model {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.device-count-badge {
  background: #62BCC4;
  color: white;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  min-width: 80rpx;
  text-align: center;
  box-sizing: border-box;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40rpx; /* 固定高度 */
}

/* ↓ 加这个 */
.device-count-badge.mixed {
  min-width: 120rpx;
  background: #5a6abf;
}

.count-split-text {
  font-size: 20rpx;
  white-space: nowrap;
  letter-spacing: 2rpx;
}



