/* pages/device/detail/devicedetail.wxss
   颜色 / 圆角 / 阴影 / 间距全部取自 app.wxss 的 --ds-* 变量，
   版式与仪器列表、预约单详情保持同一套视觉语言：品牌色头部 + 叠压卡片。 */

.page {
  min-height: 100vh;
  background: var(--ds-bg);
  padding-bottom: 48rpx;
}

/* ==================== 顶部品牌头 ==================== */

.hero {
  padding: 36rpx 40rpx 120rpx;
  background: linear-gradient(160deg, var(--ds-primary) 0%, var(--ds-primary-dark) 100%);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ds-gap-sm);
}

.hero-eyebrow {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 2rpx;
}

/* 状态徽标：白底彩字，颜色全部取自语义变量，不新造色值 */
.hero-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: var(--ds-radius-pill);
  background: var(--ds-surface);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.hero-chip-available {
  color: var(--ds-success);
}

.hero-chip-using {
  color: var(--ds-warning);
}

.hero-chip-maintenance {
  color: var(--ds-danger);
}

.hero-chip-none {
  color: var(--ds-text-muted);
}

.hero-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #fff;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* 内容区上移压住头部，形成层次 */
.body {
  margin-top: -72rpx;
  padding: 0 var(--ds-gap);
}

/* ==================== 卡片内小标题 ==================== */

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--ds-gap);
}

.card-hint {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

/* ==================== 基本信息 ==================== */

.basic-row {
  display: flex;
  align-items: flex-start;
  gap: var(--ds-gap);
}

.cover {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: var(--ds-radius-sm);
  overflow: hidden;
  background: var(--ds-fill);
  transition: opacity 0.15s ease;
}

.cover-hover {
  opacity: 0.88;
}

.cover-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 无图 / 加载失败时给型号图标，比"图片加载失败"文字体面 */
.cover-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ds-primary-light);
}

.cover-icon {
  font-size: 60rpx;
  line-height: 1;
  opacity: 0.85;
}

.basic-info {
  flex: 1;
  min-width: 0;
}

.basic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.basic-tags .ds-tag {
  padding: 6rpx 18rpx;
  font-weight: 500;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
}

.meta-icon {
  flex-shrink: 0;
  font-size: 22rpx;
  opacity: 0.75;
}

.meta-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.meta-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
}

/* 编号可点击复制，用一枚小标签把"能点"这件事说清楚 */
.meta-copy {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-primary-light);
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--ds-primary-dark);
}

/* 仪器简介：与上方信息用细线分层，不再另起一张卡 */
.desc-block {
  margin-top: var(--ds-gap-sm);
  padding-top: var(--ds-gap);
  border-top: 1rpx solid var(--ds-divider);
}

.desc-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.desc-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ds-text-secondary);
  word-break: break-all;
  /* 管理端用 textarea 录入，换行要原样保留，否则几段说明会挤成一坨 */
  white-space: pre-wrap;
}

.desc-text.is-empty {
  color: var(--ds-text-muted);
}

/* ==================== 同款仪器状态 ==================== */

.status-hint {
  margin-bottom: var(--ds-gap);
  padding: 20rpx 24rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ds-text-muted);
}

.status-group + .status-group {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ds-divider);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.group-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ds-text-disabled);
}

.group-dot-available {
  background: var(--ds-success);
}

.group-dot-using {
  background: var(--ds-warning);
}

.group-dot-maintenance {
  background: var(--ds-danger);
}

.group-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ds-text);
}

.group-count {
  font-size: 24rpx;
  color: var(--ds-text-muted);
  font-variant-numeric: tabular-nums;
}

.group-codes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.group-empty {
  font-size: 24rpx;
  color: var(--ds-text-disabled);
}

.code-chip {
  padding: 10rpx 18rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
  font-size: 24rpx;
  line-height: 1.3;
  color: var(--ds-text-secondary);
  letter-spacing: 0.5rpx;
  font-variant-numeric: tabular-nums;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.code-chip-hover {
  transform: scale(0.94);
  opacity: 0.75;
}

.code-chip-available {
  background: var(--ds-success-light);
  color: var(--ds-success);
}

.code-chip-using {
  background: var(--ds-warning-light);
  color: var(--ds-warning);
}

.code-chip-maintenance {
  background: var(--ds-danger-light);
  color: var(--ds-danger);
}

/* ==================== 操作指南 ==================== */

.guide-grid {
  display: flex;
  gap: var(--ds-gap-sm);
}

.guide-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 0 24rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
  transition: background 0.2s ease, transform 0.15s ease;
}

.guide-btn-hover {
  background: var(--ds-primary-soft);
  transform: scale(0.98);
}

/* 没有对应资料时弱化，但保留点击（点了给一句提示） */
.guide-btn.is-empty {
  opacity: 0.45;
}

.guide-icon {
  font-size: 40rpx;
  line-height: 1;
}

.guide-label {
  font-size: 24rpx;
  color: var(--ds-text-secondary);
}

.guide-foot {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

/* ==================== 状态卡 / 骨架屏 / 底部 ==================== */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx;
  text-align: center;
}

.state-icon {
  font-size: 72rpx;
  line-height: 1.2;
}

.state-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.state-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ds-text-muted);
}

.state-btn {
  margin-top: var(--ds-gap-lg);
  box-sizing: border-box;
}

.state-btn::after {
  border: none;
}

.sk-main {
  display: flex;
  gap: var(--ds-gap-sm);
}

.sk-cover {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: var(--ds-radius-sm);
}

.sk-lines {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 8rpx;
}

.sk-line {
  height: 24rpx;
  border-radius: var(--ds-radius-pill);
}

.sk-line-lg {
  width: 64%;
  height: 30rpx;
}

.sk-line-sm {
  width: 38%;
}

.sk-tags {
  display: flex;
  gap: 12rpx;
  margin-top: var(--ds-gap-sm);
}

.sk-tag {
  width: 96rpx;
  height: 32rpx;
  border-radius: var(--ds-radius-pill);
}

.sk-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sk-chip {
  width: 132rpx;
  height: 48rpx;
  border-radius: var(--ds-radius-sm);
}

.sk-btns {
  display: flex;
  gap: var(--ds-gap-sm);
}

.sk-btn {
  flex: 1;
  height: 132rpx;
  border-radius: var(--ds-radius-sm);
}

.foot-tip {
  padding: 8rpx 0 var(--ds-gap-lg);
  text-align: center;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

/* ==================== 吸底预约栏（同 reservation 页的 submit-bar 口径） ==================== */

.page.has-bar {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: var(--ds-gap);
  padding: 20rpx var(--ds-gap);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--ds-surface);
  border-top: 1rpx solid var(--ds-divider);
  box-shadow: 0 -6rpx 24rpx rgba(31, 39, 51, 0.06);
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-text {
  display: block;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
}

.action-btn {
  flex-shrink: 0;
  min-width: 220rpx;
  margin: 0;
}

.action-btn::after {
  border: none;
}
