<page-container show="{{showExitConfirm}}" overlay="{{true}}" position="bottom" custom-style="height:auto;max-height:40vh;" bindbeforeleave="onBeforeLeaveExit">

  <view class="exit-confirm-panel">
    <text class="exit-confirm-title">退出管理端</text>
    <text class="exit-confirm-desc">确定要退出管理端吗？退出后需重新登录。</text>
    <view class="exit-confirm-btns">
      <button class="exit-cancel-btn" bindtap="cancelExit">取消</button>
      <button class="exit-confirm-btn" bindtap="doLogout">退出</button>
    </view>
  </view>
</page-container>

<view class="container">
  <view class="admin-header">
    <view class="admin-avatar">⚙️</view>
    <view class="admin-info">
      <text class="admin-title">欢迎您，{{adminName}}</text>
    </view>
    <view class="admin-3d-btn" bindtap="goTo3DBoard">
      <text class="btn-3d-icon">🌐</text>
      <text class="btn-3d-text">三维看板</text>
    </view>
    <view class="admin-logout" bindtap="confirmLogout">
      <text class="logout-text">退出</text>
    </view>
  </view>

  <view class="tab-bar">
    <view class="tab-item {{activeTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">
      <text class="tab-icon">🔬</text>
      <text class="tab-label">仪器状态</text>
    </view>
    <view class="tab-item {{activeTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">
      <text class="tab-icon">📋</text>
      <text class="tab-label">预约记录</text>
    </view>
    <view class="tab-item {{activeTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-tab="2">
      <text class="tab-icon">📢</text>
      <text class="tab-label">发布通知</text>
    </view>
  </view>

  <view wx:if="{{activeTab === 0}}" class="tab-content">

    <view class="search-section">
      <view class="search-box">
        <input class="search-input" placeholder="搜索仪器名称、实验室..." bindinput="onSearchInput" value="{{filters.searchKeyword}}" />
        <text class="search-icon">🔍</text>
        <text class="clear-search" wx:if="{{filters.searchKeyword}}" bindtap="clearSearch">✕</text>
      </view>
    </view>

    <view class="device-op-bar">
      <button class="add-device-btn" bind:tap="openAddDeviceModal">
        <text class="add-icon">+</text>
        <text>新增仪器</text>
      </button>
    </view>

    <view class="filter-section">
      <!-- 实验室类型筛选 -->
      <view class="filter-group">
        <text class="filter-label">实验室类型</text>
        <view class="filter-buttons">
          <text class="filter-btn {{filters.labType === 'all' ? 'active' : ''}}" data-type="all" bindtap="onLabTypeChange">全部</text>
          <text class="filter-btn {{filters.labType === 'public' ? 'active' : ''}}" data-type="public" bindtap="onLabTypeChange">公共实验室</text>
          <text class="filter-btn {{filters.labType === 'group' ? 'active' : ''}}" data-type="group" bindtap="onLabTypeChange">课题组</text>
        </view>
      </view>

      <!-- 仪器类型筛选 -->
      <view class="filter-group">
        <text class="filter-label">仪器类型</text>
        <view class="filter-buttons">
          <text class="filter-btn {{filters.deviceType === 'all' ? 'active' : ''}}" data-type="all" bindtap="onDeviceTypeChange">全部</text>
          <text class="filter-btn {{filters.deviceType === 'large' ? 'active' : ''}}" data-type="large" bindtap="onDeviceTypeChange">大型仪器</text>
          <text class="filter-btn {{filters.deviceType === 'small' ? 'active' : ''}}" data-type="small" bindtap="onDeviceTypeChange">小型仪器</text>
        </view>
      </view>
    </view>

    <view wx:if="{{isLoadingDevices}}" class="center-hint">
      <view class="loading-spin"></view>
      <text>加载中...</text>
    </view>

    <view wx:elif="{{deviceGroups.length === 0}}" class="center-hint">
      <text class="hint-icon">-</text>
      <text>暂无仪器数据</text>
    </view>

    <view wx:else class="device-list">
      <view class="device-card" wx:for="{{displayedGroups}}" wx:key="group_key" bindtap="goToDeviceDetail" data-device-name="{{item.device_name}}" data-lab-name="{{item.lab_name}}" data-device-type="{{item.device_type}}" data-model="{{item.model}}" data-group-key="{{item.group_key}}">

        <view class="card-delete-btn" catch:tap="deleteDeviceGroup" data-device-name="{{item.device_name}}" data-lab-name="{{item.lab_name}}" data-device-room="{{item.device_room}}" data-device-type="{{item.device_type}}" data-model="{{item.model}}">
          删除
        </view>
        <image class="device-img" src="{{item.picture}}" mode="aspectFill"></image>

        <view class="card-body">
          <view class="card-top">
            <text class="d-name">{{item.device_name}}</text>
            <text class="d-type {{item.device_type}}">{{item.device_type === 'large' ? '大型' : '小型'}}</text>
          </view>
          <text class="d-lab">{{item.device_room}}</text>
          <text wx:if="{{item.model}}" class="d-lab">型号：{{item.model}}</text>

          <view class="badge-row">
            <view class="badge available">
              <text class="badge-num">{{item.available}}</text>
              <text class="badge-label">可用</text>
            </view>
            <view class="badge {{item.using > 0 ? 'using-active' : 'using'}}">
              <text class="badge-num">{{item.using}}</text>
              <text class="badge-label">使用中</text>
            </view>
            <view class="badge {{item.maintenance > 0 ? 'maint-active' : 'maint'}}">
              <text class="badge-num">{{item.maintenance}}</text>
              <text class="badge-label">维护</text>
            </view>
          </view>
        </view>

        <text class="card-arrow">></text>
      </view>
    </view>

    <!-- 加载更多按钮 -->
    <view wx:if="{{hasMore && !isLoadingDevices}}" class="load-more-wrap">
      <button class="load-more-btn" bindtap="loadMoreDevices">加载更多仪器</button>
    </view>

  </view>

  <view wx:if="{{activeTab === 1}}" class="tab-content">
    <view class="reserve-summary">
      <view class="summary-card" bind:tap="gotoUpcoming">
        <text class="summary-num">{{reserveStats.upcoming}}</text>
        <text class="summary-label">即将使用</text>
      </view>
      <view class="summary-card" bind:tap="gotoUsing">
        <text class="summary-num using-color">{{reserveStats.using}}</text>
        <text class="summary-label">使用中</text>
      </view>
      <view class="summary-card" bind:tap="gotoCompleted">
        <text class="summary-num completed-color">{{reserveStats.completed}}</text>
        <text class="summary-label">已完成</text>
      </view>
      <view class="summary-card" bind:tap="gotoAbnormal">
        <text class="summary-num abnormal-color">{{reserveStats.abnormal}}</text>
        <text class="summary-label">异常</text>
      </view>
      <view class="summary-card" bind:tap="gotoAll">
        <text class="summary-num total-color">{{reserveStats.total}}</text>
        <text class="summary-label">总预约</text>
      </view>
    </view>

    <view wx:if="{{isLoadingReserves}}" class="center-hint">
      <view class="loading-spin"></view>
      <text>加载中...</text>
    </view>

    <view wx:elif="{{recentReserves.length === 0}}" class="center-hint">
      <text class="hint-icon">📋</text>
      <text>暂无预约记录</text>
    </view>

    <view wx:else class="reserve-list">
      <view class="reserve-card" wx:for="{{recentReserves}}" wx:key="_id" bind:tap="gotoReserveDetail" data-id="{{item._id}}">
        <view class="card-top">
          <text class="d-name">{{item.device_name}}</text>
          <view class="status-tag {{item.displayStatus}}">{{item.displayStatusText}}</view>
        </view>
        <view class="reserve-info">
          <text class="reserve-person">{{item.student_name || item.user_id}}</text>
          <text class="reserve-time">{{item.reserve_date}} {{item.start_time_display}}-{{item.end_time_display}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{recentReserves.length > 0}}" class="view-all-btn" bindtap="goToReserveList">
      <text>查看全部预约记录</text>
    </view>
  </view>

  <view wx:if="{{activeTab === 2}}" class="tab-content">
    <view class="compose-card">
      <text class="compose-heading">发布管理员通知</text>
      <text class="compose-hint">发布后将继续写入公告流程，学生端可直接看到。</text>

      <view class="input-group">
        <text class="input-label">标题</text>
        <input class="title-input" placeholder="请输入通知标题" value="{{msgTitle}}" bindinput="onTitleInput" maxlength="50" />
      </view>

      <view class="input-group">
        <text class="input-label">内容</text>
        <textarea class="content-textarea" placeholder="请输入通知内容..." value="{{msgContent}}" bindinput="onContentInput" maxlength="500" auto-height />
      </view>

      <button class="send-btn {{isSending ? 'sending' : ''}}" bindtap="sendMessage" disabled="{{isSending}}">
        {{isSending ? '发布中...' : '立即发布'}}
      </button>
    </view>

    <view class="sent-section">
      <text class="sent-heading">历史通知</text>

      <view wx:if="{{isLoadingMessages}}" class="center-hint">
        <text>加载中...</text>
      </view>
      <view wx:elif="{{sentMessages.length === 0}}" class="center-hint">
        <text class="hint-icon">-</text>
        <text>暂无发布记录</text>
      </view>
      <view wx:else>
        <view class="sent-item" wx:for="{{sentMessages}}" wx:key="_id">
          <view class="sent-row">
            <text class="sent-title">{{item.title}}</text>
            <text class="sent-date">{{item.dateDisplay}}</text>
          </view>
          <text class="sent-content">{{item.content}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showDeviceForm}}">
    <view class="device-form-modal" catchtap="">
      <view class="form-title">新增仪器组</view>

      <!-- 1. 基础信息（必填，组共享） -->
      <view class="form-section-title">基础信息</view>

      <view class="form-item">
        <text class="form-label">仪器名称 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入仪器名称" value="{{deviceForm.device_name}}" bindinput="onDeviceFormInput" data-field="device_name" />
      </view>

      <view class="form-item">
        <text class="form-label">所属实验室 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入实验室名称" value="{{deviceForm.lab_name}}" bindinput="onDeviceFormInput" data-field="lab_name" />
      </view>

      <view class="form-item">
        <text class="form-label">房间位置 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入房间号" value="{{deviceForm.device_room}}" bindinput="onDeviceFormInput" data-field="device_room" />
      </view>

      <view class="form-item">
        <text class="form-label">仪器类型 <text class="required">*</text></text>
        <view class="form-radio-group">
          <text class="form-radio {{deviceForm.device_type === 'large' ? 'active' : ''}}" bindtap="selectDeviceType" data-type="large">大型仪器</text>
          <text class="form-radio {{deviceForm.device_type === 'small' ? 'active' : ''}}" bindtap="selectDeviceType" data-type="small">小型仪器</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">实验室类型 <text class="required">*</text></text>
        <view class="form-radio-group">
          <text class="form-radio {{deviceForm.lab_type === 'public' ? 'active' : ''}}" bindtap="selectLabType" data-type="public">公共实验室</text>
          <text class="form-radio {{deviceForm.lab_type === 'group' ? 'active' : ''}}" bindtap="selectLabType" data-type="group">课题组</text>
        </view>
      </view>

      <!-- 2. 仪器实例列表（每台独立编号） -->
      <view class="form-section-title">仪器实例</view>
      <view class="form-item">
        <text class="form-label">设备编号列表 <text class="required">*</text></text>
        <view class="instance-list">
          <view class="instance-item" wx:for="{{deviceForm.instances}}" wx:key="index">
            <text class="instance-index">{{index + 1}}</text>
            <input class="instance-input" placeholder="请输入设备编号" value="{{item.device_id}}" bindinput="onInstanceInput" data-index="{{index}}" />
            <text class="instance-delete" bindtap="deleteInstance" data-index="{{index}}" wx:if="{{deviceForm.instances.length > 1}}">删除</text>
          </view>
        </view>
        <view class="add-instance-btn" bindtap="addInstance">
          <text class="add-icon-sm">+</text>
          <text>添加一台</text>
        </view>
      </view>

      <!-- 3. 补充信息（可选，组共享） -->
      <view class="form-section-title">补充信息（可选）</view>

      <view class="form-item">
        <text class="form-label">仪器图片</text>
        <view class="form-image-upload" bindtap="chooseDevicePic">
          <image wx:if="{{deviceForm.picture}}" class="upload-preview" src="{{deviceForm.picture}}" mode="aspectFill"></image>
          <view wx:else class="upload-empty">
            <text class="upload-plus">+</text>
            <text class="upload-tip">点击上传图片</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">操作规程</text>
        <textarea class="form-textarea" placeholder="请输入操作规程" value="{{deviceForm.operation_procedure}}" bindinput="onDeviceFormInput" data-field="operation_procedure" maxlength="2000" auto-height />
      </view>

      <view class="form-item">
        <text class="form-label">注意事项</text>
        <textarea class="form-textarea" placeholder="请输入注意事项" value="{{deviceForm.precautions}}" bindinput="onDeviceFormInput" data-field="precautions" maxlength="2000" auto-height />
      </view>

      <view class="form-item">
        <text class="form-label">规格参数</text>
        <textarea class="form-textarea" placeholder="每行一项，格式：参数名：参数值" value="{{deviceForm.specificationsText}}" bindinput="onDeviceFormInput" data-field="specificationsText" maxlength="2000" auto-height />
        <text class="form-hint">示例：型号：GC-2014</text>
      </view>

      <view class="form-btns">
        <button class="form-cancel-btn" bindtap="closeDeviceForm">取消</button>
        <button class="form-confirm-btn" bindtap="submitDeviceForm" disabled="{{isSubmittingDevice}}">
          {{isSubmittingDevice ? '提交中...' : '确认新增'}}
        </button>
      </view>
    </view>
  </view>
</view>