<view class="container">
  <view class="filter-bar">
    <view class="filter-group">
      <text
        class="filter-btn {{filterStatus === 'all' ? 'active' : ''}}"
        data-status="all"
        bindtap="onFilterChange"
      >全部</text>
      <text
        class="filter-btn {{filterStatus === 'upcoming' ? 'active' : ''}}"
        data-status="upcoming"
        bindtap="onFilterChange"
      >即将使用</text>
      <text
        class="filter-btn {{filterStatus === 'using' ? 'active' : ''}}"
        data-status="using"
        bindtap="onFilterChange"
      >使用中</text>
      <text
        class="filter-btn {{filterStatus === 'completed' ? 'active' : ''}}"
        data-status="completed"
        bindtap="onFilterChange"
      >已完成</text>
    </view>
  </view>

  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索仪器名称、预约人..."
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <text wx:if="{{searchKeyword}}" class="clear-btn" bindtap="clearSearch">✕</text>
  </view>

  <view wx:if="{{isLoading}}" class="center-hint">
    <view class="loading-spin"></view>
    <text>加载中...</text>
  </view>

  <view wx:elif="{{filteredReserves.length === 0}}" class="center-hint">
    <text class="hint-icon">📋</text>
    <text>暂无预约记录</text>
  </view>

  <view wx:else class="reserve-list">
    <view
      class="reserve-card"
      wx:for="{{filteredReserves}}"
      wx:key="_id"
    >
      <view class="card-top">
        <text class="device-name">{{item.device_name}}</text>
        <view class="status-tag {{item.displayStatus}}">{{item.displayStatusText}}</view>
      </view>

      <view class="card-body">
        <view class="info-row">
          <text class="info-label">仪器编号</text>
          <text class="info-value">{{item.device_id}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">预约人</text>
          <text class="info-value">{{item.student_name || item.user_id}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">课题组</text>
          <text class="info-value">{{item.research_group || '未设置'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">预约日期</text>
          <text class="info-value">{{item.reserve_date}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">预约时段</text>
          <text class="info-value">{{item.start_time_display}} - {{item.end_time_display}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">联系电话</text>
          <text class="info-value">{{item.phone || '未填写'}}</text>
        </view>
      </view>

      <view wx:if="{{item.usage_status === 'active'}}" class="using-badge">
        <text class="using-dot"></text>
        <text class="using-text">正在使用中</text>
      </view>
    </view>
  </view>

  <view wx:if="{{hasMore && !isLoading}}" class="load-more" bindtap="loadMore">
    <text>加载更多</text>
  </view>

  <view wx:if="{{!hasMore && filteredReserves.length > 0}}" class="no-more">
    <text>没有更多记录了</text>
  </view>
</view>
