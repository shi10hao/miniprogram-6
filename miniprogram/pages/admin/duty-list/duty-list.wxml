<view class="page">

  <!-- 顶部 -->
  <view class="hero">
    <view class="hero-top">
      <text class="hero-eyebrow">安全员打卡</text>
      <text wx:if="{{!isChecking && !forbidden && !hasError && totalCount}}" class="hero-chip">共 {{totalCount}} 条</text>
    </view>
    <text class="hero-title">卫生打卡记录</text>
    <text class="hero-sub">每日实验台面、设备与废物处理情况</text>
  </view>

  <view class="body">

    <!-- 搜索与筛选 -->
    <view wx:if="{{!forbidden}}" class="filter-card">
      <view class="search-field">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="搜索姓名 / 实验室 / 手机号"
          placeholder-class="search-placeholder"
          maxlength="30"
          confirm-type="search"
          bindinput="onKeywordInput"
        />
        <view wx:if="{{keyword}}" class="search-clear" catchtap="onClearKeyword">✕</view>
      </view>
      <view class="chip-row">
        <view
          wx:for="{{dateFilters}}"
          wx:key="key"
          class="chip {{dateFilter === item.key ? 'chip-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onDateFilter"
        >{{item.label}}</view>
        <text wx:if="{{!isChecking && !hasError}}" class="chip-count">{{matchedCount}} 条</text>
      </view>
    </view>

    <!-- 校验中 / 加载中（已有数据时原地刷新，不闪骨架屏） -->
    <block wx:if="{{(isChecking || isLoading) && !visibleRecords.length}}">
      <view wx:for="{{skeletonRows}}" wx:key="*this" class="ds-card sk-card">
        <view class="sk-head">
          <view class="ds-skeleton sk-avatar"></view>
          <view class="sk-head-text">
            <view class="ds-skeleton sk-line sk-line-lg"></view>
            <view class="ds-skeleton sk-line sk-line-sm"></view>
          </view>
        </view>
        <view class="ds-skeleton sk-photos"></view>
      </view>
    </block>

    <!-- 无权限 -->
    <block wx:elif="{{forbidden}}">
      <view class="ds-card state-card">
        <text class="state-icon">🔒</text>
        <text class="state-title">无权查看打卡记录</text>
        <text class="state-desc">这份记录包含全站同学的姓名与联系方式，仅教师和管理员可见</text>
        <button class="ds-btn ds-btn-block state-btn" bindtap="goBack">返回</button>
      </view>
    </block>

    <!-- 加载失败 -->
    <block wx:elif="{{hasError}}">
      <view class="ds-card state-card" bindtap="onRetry">
        <text class="state-icon">⚠️</text>
        <text class="state-title">打卡记录加载失败</text>
        <text class="state-desc">点击此处重试</text>
      </view>
    </block>

    <!-- 空态：区分「一条都没有」和「筛选后没有」 -->
    <block wx:elif="{{!visibleRecords.length}}">
      <view class="ds-card state-card">
        <text class="state-icon">{{totalCount ? '🔍' : '📋'}}</text>
        <text class="state-title">{{totalCount ? '没有匹配的打卡记录' : '还没有打卡记录'}}</text>
        <text class="state-desc">{{totalCount ? '换个关键词或时间范围试试' : '安全员提交打卡后会出现在这里'}}</text>
      </view>
    </block>

    <!-- 记录列表 -->
    <block wx:else>
      <view wx:for="{{visibleRecords}}" wx:key="id" class="ds-card record-card">
        <view class="record-head">
          <view class="avatar">{{item.avatarText}}</view>
          <view class="record-head-main">
            <view class="record-title">
              <text class="record-name">{{item.name}}</text>
              <text wx:if="{{item.room}}" class="ds-tag ds-tag-muted">{{item.room}}</text>
            </view>
            <text class="record-time">{{item.timeText}}</text>
          </view>
        </view>

        <view class="record-lab">
          <text class="lab-label">实验室</text>
          <text class="lab-value">{{item.labName}}</text>
        </view>

        <view wx:if="{{item.phone}}" class="record-row">
          <text class="row-label">手机号</text>
          <view class="row-value-group">
            <text class="row-value">{{item.phone}}</text>
            <view class="call-btn" data-phone="{{item.phone}}" catchtap="onCall">拨号</view>
          </view>
        </view>

        <view wx:if="{{item.remark}}" class="record-remark">{{item.remark}}</view>

        <view wx:if="{{item.imageUrls.length}}" class="photo-grid">
          <image
            wx:for="{{item.imageUrls}}"
            wx:for-item="url"
            wx:key="*this"
            class="photo"
            src="{{url}}"
            mode="aspectFill"
            data-url="{{url}}"
            data-urls="{{item.imageUrls}}"
            bindtap="previewImage"
          />
        </view>
      </view>

      <button wx:if="{{hasMore}}" class="ds-btn ds-btn-ghost load-more" loading="{{isFetchingMore}}" bindtap="loadMore">加载更多</button>
      <view wx:else class="no-more">已显示全部 {{matchedCount}} 条记录</view>
    </block>

  </view>
</view>
