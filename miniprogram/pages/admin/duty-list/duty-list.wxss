/* pages/admin/duty-list/dutylist.wxss */

.container {
  padding: 24rpx 28rpx;
  background: #f7f8fa;
  min-height: 100vh;
}

.header {
  padding: 16rpx 0 28rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 加载 / 空状态 */
.loading, .empty {
  text-align: center;
  padding: 120rpx 0;
  color: #bbb;
  font-size: 28rpx;
}

/* 记录卡片 */
.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 用户信息头部 */
.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.time {
  font-size: 24rpx;
  color: #c0c0c0;
}

/* 电话 */
.record-phone {
  margin-bottom: 16rpx;
}

.record-phone text {
  font-size: 26rpx;
  color: #8c8c8c;
}

/* 实验室信息 */
.record-info {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
}

.lab-name {
  font-size: 26rpx;
  color: #595959;
}

.room {
  font-size: 26rpx;
  color: #b0b0b0;
  margin-left: 10rpx;
}

/* 备注 */
.record-remark {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 18rpx;
  padding: 14rpx 0;
  line-height: 1.6;
}

/* 图片 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.duty-image {
  width: 156rpx;
  height: 156rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
}

/* 加载更多 */
.load-more, .no-more {
  text-align: center;
  padding: 36rpx 0 48rpx;
}

.load-more text {
  color: #1677ff;
  font-size: 28rpx;
}

.no-more text {
  color: #d9d9d9;
  font-size: 24rpx;
}