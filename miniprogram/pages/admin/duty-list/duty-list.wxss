/* pages/admin/duty-list/duty-list.wxss */

.page {
  min-height: 100vh;
  background: var(--ds-bg);
  padding-bottom: 48rpx;
}

/* ==================== 顶部 ==================== */

.hero {
  padding: 36rpx 40rpx 120rpx;
  background: linear-gradient(160deg, var(--ds-primary), var(--ds-primary-dark));
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-eyebrow {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 2rpx;
}

.hero-chip {
  font-size: 22rpx;
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: var(--ds-radius-pill);
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.body {
  margin-top: -72rpx;
  padding: 0 var(--ds-gap);
}

/* ==================== 搜索与筛选 ==================== */

.filter-card {
  padding: 20rpx;
  margin-bottom: var(--ds-gap);
  border-radius: var(--ds-radius-lg);
  background: var(--ds-surface);
  box-shadow: var(--ds-shadow-md);
}

.search-field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: var(--ds-radius-pill);
  background: var(--ds-fill);
}

.search-icon {
  font-size: 26rpx;
  opacity: 0.7;
}

/* 不给高度的话 input 用基础库默认高度，比 76rpx 的胶囊矮一截，上下留白点不到 */
.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 28rpx;
  color: var(--ds-text);
}

.search-placeholder {
  color: var(--ds-text-muted);
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ds-text-muted);
  border-radius: 50%;
  background: var(--ds-divider);
}

.chip-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.chip {
  font-size: 24rpx;
  color: var(--ds-text-secondary);
  padding: 8rpx 22rpx;
  border-radius: var(--ds-radius-pill);
  background: var(--ds-fill);
}

.chip-active {
  background: var(--ds-primary-light);
  color: var(--ds-primary-deep);
  font-weight: 600;
}

.chip-count {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

/* ==================== 记录卡片 ==================== */

.record-card {
  padding: 28rpx var(--ds-gap-lg);
}

.record-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ds-primary-light);
  color: var(--ds-primary-deep);
  font-size: 30rpx;
  font-weight: 600;
}

.record-head-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.record-time {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.record-lab {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--ds-primary-soft);
}

.lab-label {
  font-size: 22rpx;
  color: var(--ds-primary-deep);
  opacity: 0.75;
  flex-shrink: 0;
}

.lab-value {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ds-primary-deep);
  word-break: break-all;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ds-gap);
  padding: 18rpx 0 0;
}

.row-label {
  font-size: 26rpx;
  color: var(--ds-text-muted);
  flex-shrink: 0;
}

.row-value-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ds-text);
}

.call-btn {
  font-size: 22rpx;
  color: var(--ds-primary-deep);
  padding: 6rpx 22rpx;
  border-radius: var(--ds-radius-pill);
  border: 1rpx solid var(--ds-primary);
}

.record-remark {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--ds-fill);
  font-size: 26rpx;
  color: var(--ds-text-secondary);
  line-height: 1.7;
  word-break: break-all;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.photo {
  width: 196rpx;
  height: 196rpx;
  border-radius: 12rpx;
  background: var(--ds-fill);
}

/* ==================== 底部 ==================== */

.load-more {
  width: 100%;
  margin-top: 8rpx;
  box-sizing: border-box;
}

.load-more::after {
  border: none;
}

.no-more {
  padding: 24rpx 0 var(--ds-gap-lg);
  text-align: center;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

/* ==================== 状态卡 / 骨架屏 ==================== */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx;
  text-align: center;
}

.state-icon {
  font-size: 72rpx;
  line-height: 1.2;
}

.state-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.state-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
  line-height: 1.6;
}

.state-btn {
  margin-top: var(--ds-gap-lg);
  box-sizing: border-box;
}

.state-btn::after {
  border: none;
}

.sk-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sk-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.sk-head-text {
  flex: 1;
}

.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 14rpx;
}

.sk-line-lg {
  width: 55%;
}

.sk-line-sm {
  width: 32%;
  margin-bottom: 0;
}

.sk-photos {
  height: 160rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
}
