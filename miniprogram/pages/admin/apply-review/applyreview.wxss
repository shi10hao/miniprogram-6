.container {
  min-height: 100vh;
  background: #f0f4f8;
}

/* ===== Tab 栏 ===== */
.review-tab-bar {
  display: flex;
  background: white;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #e8ecf0;
}

.review-tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #999;
  position: relative;
}

.review-tab-item.active {
  color: #62BCC4;
  font-weight: 600;
}

.review-tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  width: 40%;
  height: 4rpx;
  background: #62BCC4;
  border-radius: 2rpx;
}

.tab-badge {
  display: inline-block;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  margin-left: 6rpx;
  background: #e74c3c;
  color: white;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 14rpx;
  box-sizing: border-box;
  vertical-align: middle;
}

/* ===== Loading / 空状态 ===== */
.center-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
  color: #aaa;
  font-size: 26rpx;
}

.hint-icon {
  font-size: 64rpx;
}

.loading-spin {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #62BCC4;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ===== 列表 ===== */
.apply-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.apply-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.apply-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f4f8;
}

.apply-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.apply-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.apply-status.pending {
  background: #fff8e1;
  color: #f57c00;
}

.apply-status.approved {
  background: #e8f5e9;
  color: #2e7d32;
}

.apply-status.rejected {
  background: #fce4ec;
  color: #c62828;
}

.apply-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.apply-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #888;
}

.apply-value {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  word-break: break-all;
}

/* ===== 拒绝理由 ===== */
.apply-reject-reason {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff5f5;
  border-left: 6rpx solid #e74c3c;
  border-radius: 8rpx;
}

.reason-label {
  font-size: 24rpx;
  color: #e74c3c;
  font-weight: 500;
}

.reason-text {
  font-size: 24rpx;
  color: #666;
}

/* ===== 操作按钮 ===== */
.apply-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f4f8;
}

.action-reject-btn,
.action-approve-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 14rpx;
  border: none;
}

.action-reject-btn {
  background: #fce4ec;
  color: #c62828;
}

.action-approve-btn {
  background: linear-gradient(135deg, #62BCC4, #4da9b1);
  color: white;
  font-weight: 600;
}

.action-reject-btn[disabled],
.action-approve-btn[disabled] {
  opacity: 0.5;
}

/* ===== 拒绝理由弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.reject-panel {
  width: 600rpx;
  background: white;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.reject-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 12rpx;
}

.reject-desc {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 24rpx;
}

.reject-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #f7f9fc;
  border: 1rpx solid #e8ecf0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.reject-counter {
  align-self: flex-end;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #aaa;
}

.reject-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.reject-cancel-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: #f0f0f0;
  color: #666;
  border: none;
  border-radius: 14rpx;
}

.reject-confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #e74c3c;
  color: white;
  border: none;
  border-radius: 14rpx;
}

.reject-confirm-btn[disabled] {
  background: #f0a9a0;
}