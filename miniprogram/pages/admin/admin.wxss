/* 管理端首页：深青渐变头部 + 悬浮 Tab + 四类功能页
   仅使用 app.wxss 的 --ds-* 变量，尺寸按 750rpx 设计稿 */

.admin-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: var(--ds-bg);
  box-sizing: border-box;
}

/* ==================== 顶部信息卡 ==================== */

.admin-header {
  position: relative;
  overflow: hidden;
  padding: 40rpx 32rpx 96rpx;
  background: linear-gradient(135deg, var(--ds-primary-deep) 0%, var(--ds-primary) 100%);
  border-radius: 0 0 var(--ds-radius-lg) var(--ds-radius-lg);
}

.header-glow {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.header-main {
  position: relative;
  display: flex;
  align-items: center;
}

.admin-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  margin-right: var(--ds-gap);
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 50%;
}

.avatar-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.admin-info {
  flex: 1;
  min-width: 0;
}

.admin-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.3;
}

.admin-sub {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.role-tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  border-radius: var(--ds-radius-pill);
}

.admin-meta {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.header-actions {
  position: relative;
  display: flex;
  margin-top: var(--ds-gap);
}

.header-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  margin-right: var(--ds-gap-sm);
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.14);
  border-radius: var(--ds-radius-pill);
}

.header-action:active {
  background: rgba(255, 255, 255, 0.26);
}

.action-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
  color: #fff;
}

.action-text {
  font-size: 24rpx;
  color: #fff;
}

/* ==================== 悬浮 Tab ==================== */

.tab-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin: -60rpx var(--ds-gap) 0;
  padding: 10rpx;
  background: var(--ds-surface);
  border-radius: var(--ds-radius-pill);
  box-shadow: var(--ds-shadow-md);
}

.tab-item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: var(--ds-radius-pill);
  transition: background 0.2s, color 0.2s;
}

.tab-item.active {
  background: var(--ds-primary);
}

.tab-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
  line-height: 1;
}

.tab-label {
  font-size: 26rpx;
  color: var(--ds-text-secondary);
}

.tab-item.active .tab-label {
  color: #fff;
  font-weight: 600;
}

/* ==================== 页面容器 ==================== */

.page-body {
  padding: var(--ds-gap) var(--ds-gap) 0;
}

.tab-content {
  animation: tab-in 0.22s ease;
}

@keyframes tab-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== Tab0 搜索栏 ==================== */

.search-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--ds-gap);
}

.search-box {
  display: flex;
  flex: 1;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx;
  background: var(--ds-surface);
  border-radius: var(--ds-radius-pill);
  box-shadow: var(--ds-shadow-sm);
}

.search-icon {
  flex-shrink: 0;
  margin-right: 12rpx;
  font-size: 26rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: 28rpx;
  color: var(--ds-text);
}

.search-placeholder {
  color: var(--ds-text-muted);
  font-size: 28rpx;
}

.clear-search {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
  background: var(--ds-fill);
  border-radius: 50%;
}

.add-device-btn {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin-left: var(--ds-gap-sm);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #fff;
  background: var(--ds-primary);
  border-radius: var(--ds-radius-pill);
  box-shadow: 0 6rpx 16rpx rgba(98, 188, 196, 0.32);
}

.add-device-btn:active {
  background: var(--ds-primary-dark);
}

.add-icon {
  margin-right: 4rpx;
  font-size: 32rpx;
  line-height: 1;
}

/* ==================== Tab0 筛选 ==================== */

.filter-panel {
  padding: var(--ds-gap-sm) var(--ds-gap);
  margin-bottom: var(--ds-gap);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
}

.filter-row {
  display: flex;
  align-items: center;
}

.filter-row + .filter-row {
  margin-top: var(--ds-gap-sm);
}

.filter-row-label {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.filter-chips {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
}

.filter-chip {
  height: 52rpx;
  margin: 0 var(--ds-gap-xs) var(--ds-gap-xs) 0;
  padding: 0 22rpx;
  font-size: 24rpx;
  line-height: 52rpx;
  color: var(--ds-text-secondary);
  background: var(--ds-fill);
  border-radius: var(--ds-radius-pill);
}

.filter-chip.active {
  color: var(--ds-primary-deep);
  font-weight: 600;
  background: var(--ds-primary-light);
}

/* ==================== Tab0 列表头 ==================== */

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--ds-gap-sm);
  padding: 0 8rpx;
}

.list-head-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.list-head-sub {
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

/* ==================== Tab0 仪器卡片 ==================== */

.device-list {
  display: flex;
  flex-direction: column;
}

.device-card {
  position: relative;
  display: flex;
  align-items: stretch;
  margin-bottom: var(--ds-gap);
  padding: var(--ds-gap-sm);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
  transition: transform 0.15s;
}

.device-card:active {
  transform: scale(0.99);
}

.skeleton-card {
  align-items: center;
}

.device-thumb {
  flex-shrink: 0;
  width: 148rpx;
  height: 148rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
}

.thumb-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ds-primary-soft);
}

.thumb-icon {
  font-size: 56rpx;
  opacity: 0.55;
  line-height: 1;
}

.device-body {
  flex: 1;
  min-width: 0;
  padding: 0 0 0 var(--ds-gap-sm);
}

.device-name-row {
  display: flex;
  align-items: center;
}

.device-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
  line-height: 1.35;
}

.type-tag {
  flex-shrink: 0;
  margin-left: var(--ds-gap-xs);
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: var(--ds-radius-sm);
}

.type-tag.large {
  color: var(--ds-primary-deep);
  background: var(--ds-primary-light);
}

.type-tag.small {
  color: var(--ds-text-secondary);
  background: var(--ds-fill);
}

.device-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ds-text-secondary);
}

.meta-item {
  display: inline;
}

.meta-dot {
  margin: 0 8rpx;
  color: var(--ds-text-disabled);
}

.device-model {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.device-stats {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.stat {
  display: flex;
  align-items: baseline;
  margin-right: var(--ds-gap);
}

.stat-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ds-text-secondary);
}

.stat-label {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.stat-ok .stat-num {
  color: var(--ds-success);
}

.stat-busy .stat-num {
  color: var(--ds-primary-dark);
}

.stat-warn .stat-num {
  color: var(--ds-warning);
}

.stat-idle .stat-num {
  color: var(--ds-text-disabled);
}

.stat-total {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.device-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  flex-shrink: 0;
  padding-left: var(--ds-gap-xs);
}

.chevron {
  font-size: 32rpx;
  color: var(--ds-text-disabled);
  line-height: 1;
}

.group-del {
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  color: var(--ds-danger);
  background: var(--ds-danger-light);
  border-radius: var(--ds-radius-sm);
}

.group-del.disabled {
  color: var(--ds-text-muted);
  background: var(--ds-fill);
}

/* 骨架屏占位条 */

.sk-line {
  height: 26rpx;
  margin-bottom: 14rpx;
  border-radius: var(--ds-radius-sm);
}

.sk-line-title {
  width: 60%;
  height: 32rpx;
}

.sk-line-meta {
  width: 82%;
}

.sk-line-stats {
  width: 46%;
  margin-bottom: 0;
}

/* ==================== 加载更多 ==================== */

.load-more-wrap {
  padding: var(--ds-gap-sm) 0;
}

.load-more-btn {
  height: 80rpx;
  font-size: 26rpx;
  line-height: 80rpx;
  text-align: center;
  color: var(--ds-primary-deep);
  background: var(--ds-primary-soft);
  border: 2rpx solid var(--ds-border);
  border-radius: var(--ds-radius-pill);
}

.load-more-btn:active {
  background: var(--ds-primary-light);
}

.load-more-btn.loading {
  color: var(--ds-text-muted);
}

.list-end {
  padding: var(--ds-gap) 0;
  font-size: 22rpx;
  text-align: center;
  color: var(--ds-text-muted);
}

/* ==================== Tab1 概览 ==================== */

.overview-card {
  display: flex;
  align-items: stretch;
  margin-bottom: var(--ds-gap);
  padding: var(--ds-gap) 8rpx;
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
}

.overview-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.overview-item + .overview-item::before {
  content: '';
  position: absolute;
  top: 12rpx;
  bottom: 12rpx;
  left: 0;
  width: 2rpx;
  background: var(--ds-divider);
}

.overview-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ds-text);
  line-height: 1.2;
}

.overview-num.busy {
  color: var(--ds-primary-dark);
}

.overview-num.done {
  color: var(--ds-success);
}

.overview-num.danger {
  color: var(--ds-danger);
}

.overview-num.total {
  color: var(--ds-text-secondary);
}

.overview-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

/* ==================== Tab1 预约卡片 ==================== */

.reserve-list {
  display: flex;
  flex-direction: column;
}

.reserve-card {
  margin-bottom: var(--ds-gap-sm);
  padding: var(--ds-gap);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
}

.reserve-card:active {
  background: var(--ds-fill);
}

.reserve-top {
  display: flex;
  align-items: center;
}

.reserve-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.status-tag {
  flex-shrink: 0;
  margin-left: var(--ds-gap-sm);
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  border-radius: var(--ds-radius-sm);
}

.status-tag.upcoming {
  color: var(--ds-primary-deep);
  background: var(--ds-primary-light);
}

.status-tag.using {
  color: var(--ds-success);
  background: var(--ds-success-light);
}

.status-tag.completed {
  color: var(--ds-text-secondary);
  background: var(--ds-fill);
}

.status-tag.abnormal {
  color: var(--ds-danger);
  background: var(--ds-danger-light);
}

.status-tag.past {
  color: var(--ds-text-muted);
  background: var(--ds-fill);
}

.reserve-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.reserve-person {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ds-text-secondary);
}

.reserve-arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--ds-text-disabled);
}

.reserve-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.view-all-btn {
  height: 84rpx;
  margin-top: var(--ds-gap-xs);
  font-size: 26rpx;
  line-height: 84rpx;
  text-align: center;
  color: var(--ds-primary-deep);
  background: var(--ds-primary-soft);
  border-radius: var(--ds-radius-pill);
}

.view-all-btn:active {
  background: var(--ds-primary-light);
}

/* ==================== Tab2 发布通知 ==================== */

.compose-card {
  margin-bottom: var(--ds-gap);
  padding: var(--ds-gap);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
}

.compose-head {
  display: flex;
  align-items: center;
  margin-bottom: var(--ds-gap);
}

.compose-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  font-size: 34rpx;
  background: var(--ds-primary-light);
  border-radius: var(--ds-radius-sm);
}

.compose-head-text {
  flex: 1;
  min-width: 0;
  margin-left: var(--ds-gap-sm);
}

.compose-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.compose-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.field {
  margin-bottom: var(--ds-gap);
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ds-text);
}

.field-count {
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.field-hint-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
  background: var(--ds-fill);
  border-radius: 50%;
}

.field-input {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ds-text);
  background: var(--ds-fill);
  border-radius: var(--ds-radius-sm);
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ds-text);
  background: var(--ds-fill);
  border-radius: var(--ds-radius-sm);
  box-sizing: border-box;
}

.field-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.publish-btn {
  height: 88rpx;
  margin-top: var(--ds-gap-sm);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  color: #fff;
  background: var(--ds-primary);
  border-radius: var(--ds-radius-pill);
  box-shadow: 0 6rpx 16rpx rgba(98, 188, 196, 0.3);
}

.publish-btn::after {
  border: none;
}

.publish-btn[disabled] {
  color: #fff;
  background: var(--ds-text-disabled);
  box-shadow: none;
}

/* ==================== Tab2 历史通知 ==================== */

.sent-section {
  margin-top: var(--ds-gap-sm);
}

.sent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--ds-gap-sm);
  padding: 0 8rpx;
}

.sent-count {
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.sent-list {
  display: flex;
  flex-direction: column;
}

.sent-item {
  margin-bottom: var(--ds-gap-sm);
  padding: var(--ds-gap);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
}

.sent-top {
  display: flex;
  align-items: center;
}

.sent-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.sent-del {
  flex-shrink: 0;
  margin-left: var(--ds-gap-sm);
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  color: var(--ds-danger);
  background: var(--ds-danger-light);
  border-radius: var(--ds-radius-sm);
}

.sent-del.disabled {
  color: var(--ds-text-muted);
  background: var(--ds-fill);
}

.sent-content {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ds-text-secondary);
}

.sent-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--ds-gap-sm);
  padding-top: 12rpx;
  border-top: 2rpx solid var(--ds-divider);
}

.sent-date {
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.doc-link {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--ds-primary-dark);
}

.doc-link-icon {
  margin-right: 6rpx;
  font-size: 22rpx;
}

/* ==================== Tab3 更多 ==================== */

.more-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.more-card {
  position: relative;
  display: flex;
  flex-direction: column;
  width: calc(50% - 8rpx);
  margin-bottom: var(--ds-gap);
  padding: var(--ds-gap) var(--ds-gap-sm);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
  box-sizing: border-box;
}

.more-card:active {
  background: var(--ds-fill);
}

.more-icon {
  font-size: 44rpx;
  line-height: 1;
}

.more-label {
  margin-top: var(--ds-gap-sm);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.more-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--ds-text-muted);
}

.more-badge {
  position: absolute;
  top: var(--ds-gap-sm);
  right: var(--ds-gap-sm);
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
  color: #fff;
  background: var(--ds-danger);
  border-radius: var(--ds-radius-pill);
  box-sizing: border-box;
}

.more-tip {
  padding: var(--ds-gap-sm) 0;
  font-size: 20rpx;
  text-align: center;
  color: var(--ds-text-muted);
}

/* ==================== 弹窗公共 ==================== */

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--ds-gap-lg);
  background: rgba(31, 39, 51, 0.45);
  box-sizing: border-box;
}

/* 退出确认 */

.confirm-panel {
  width: 100%;
  max-width: 600rpx;
  padding: var(--ds-gap-xl) var(--ds-gap-lg) var(--ds-gap-lg);
  text-align: center;
  background: var(--ds-surface);
  border-radius: var(--ds-radius-lg);
  animation: pop-in 0.2s ease;
}

@keyframes pop-in {
  from {
    opacity: 0;
    transform: scale(0.92);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

.confirm-icon {
  font-size: 64rpx;
  line-height: 1;
}

.confirm-title {
  display: block;
  margin-top: var(--ds-gap-sm);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.confirm-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ds-text-secondary);
}

.confirm-btns {
  display: flex;
  margin-top: var(--ds-gap-lg);
}

/* 按钮重置 */

.btn-ghost,
.btn-danger,
.btn-primary {
  flex: 1;
  height: 84rpx;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--ds-radius-pill);
}

.btn-ghost::after,
.btn-danger::after,
.btn-primary::after {
  border: none;
}

.btn-ghost {
  color: var(--ds-text-secondary);
  background: var(--ds-fill);
}

.btn-ghost + .btn-danger,
.btn-ghost + .btn-primary {
  margin-left: var(--ds-gap-sm);
}

.btn-danger {
  color: #fff;
  background: var(--ds-danger);
}

.btn-primary {
  color: #fff;
  background: var(--ds-primary);
}

.btn-primary[disabled] {
  color: #fff;
  background: var(--ds-text-disabled);
}

/* ==================== 新增仪器弹窗 ==================== */

.device-form-modal {
  width: 100%;
  max-width: 660rpx;
  max-height: 84vh;
  padding: var(--ds-gap) var(--ds-gap) var(--ds-gap-lg);
  overflow-y: auto;
  background: var(--ds-surface);
  border-radius: var(--ds-radius-lg);
  box-sizing: border-box;
  animation: pop-in 0.2s ease;
}

.form-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--ds-gap-sm);
}

.form-head-text {
  flex: 1;
  min-width: 0;
}

.form-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.form-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.form-close {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: var(--ds-gap-sm);
  font-size: 26rpx;
  color: var(--ds-text-secondary);
  background: var(--ds-fill);
  border-radius: 50%;
}

.form-section-title {
  margin: var(--ds-gap) 0 var(--ds-gap-sm);
  padding-left: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ds-primary-deep);
  border-left: 6rpx solid var(--ds-primary);
}

.form-item {
  margin-bottom: var(--ds-gap-sm);
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: var(--ds-text);
}

.form-label-tip {
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.required {
  color: var(--ds-danger);
}

.form-input {
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ds-text);
  background: var(--ds-fill);
  border-radius: var(--ds-radius-sm);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ds-text);
  background: var(--ds-fill);
  border-radius: var(--ds-radius-sm);
  box-sizing: border-box;
}

.choice-row {
  display: flex;
}

.choice {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
  line-height: 76rpx;
  text-align: center;
  color: var(--ds-text-secondary);
  background: var(--ds-fill);
  border: 2rpx solid transparent;
  border-radius: var(--ds-radius-sm);
  box-sizing: border-box;
}

.choice + .choice {
  margin-left: var(--ds-gap-sm);
}

.choice.active {
  color: var(--ds-primary-deep);
  font-weight: 600;
  background: var(--ds-primary-light);
  border-color: var(--ds-primary);
}

/* 实例编号 */

.instance-list {
  display: flex;
  flex-direction: column;
}

.instance-item {
  display: flex;
  align-items: center;
  margin-bottom: var(--ds-gap-xs);
}

.instance-index {
  flex-shrink: 0;
  width: 40rpx;
  font-size: 22rpx;
  text-align: center;
  color: var(--ds-text-muted);
}

.instance-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--ds-text);
  background: var(--ds-fill);
  border-radius: var(--ds-radius-sm);
  box-sizing: border-box;
}

.instance-del {
  flex-shrink: 0;
  margin-left: var(--ds-gap-xs);
  padding: 8rpx 12rpx;
  font-size: 20rpx;
  color: var(--ds-danger);
  background: var(--ds-danger-light);
  border-radius: var(--ds-radius-sm);
}

.add-instance-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: var(--ds-gap-xs);
  font-size: 24rpx;
  color: var(--ds-primary-deep);
  background: var(--ds-primary-soft);
  border: 2rpx dashed var(--ds-primary);
  border-radius: var(--ds-radius-sm);
}

.add-icon-sm {
  margin-right: 4rpx;
  font-size: 28rpx;
  line-height: 1;
}

/* 图片上传 */

.upload-box {
  width: 200rpx;
  height: 200rpx;
  overflow: hidden;
  background: var(--ds-fill);
  border-radius: var(--ds-radius-sm);
}

.upload-preview {
  width: 200rpx;
  height: 200rpx;
}

.upload-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
}

.upload-plus {
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--ds-text-disabled);
}

.upload-tip {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.form-btns {
  display: flex;
  margin-top: var(--ds-gap);
}
