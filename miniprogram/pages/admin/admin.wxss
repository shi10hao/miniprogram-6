.container {
  min-height: 100vh;
  background: #f0f4f8;
}

/* 管理员顶部 */
.admin-header {
  background: linear-gradient(135deg, #2d6a6e, #62BCC4);
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.admin-avatar {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.admin-logout {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.15);
}

.admin-3d-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 18rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.2);
  margin-right: 12rpx;
}

.btn-3d-icon {
  font-size: 24rpx;
}

.btn-3d-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
}

.logout-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.admin-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: white;
  border-bottom: 1rpx solid #e8ecf0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx 0;
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: #62BCC4;
  border-radius: 2rpx;
}

.tab-icon {
  font-size: 28rpx;
}

.tab-label {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.tab-item.active .tab-label {
  color: #62BCC4;
  font-weight: 600;
}

/* Tab 内容区 */
.tab-content {
  padding: 24rpx 24rpx 40rpx;
}

/* Loading */
.center-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
  color: #aaa;
  font-size: 26rpx;
}

.hint-icon { font-size: 64rpx; }

.loading-spin {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #62BCC4;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* 仪器列表 */
.device-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.device-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.device-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.d-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.d-type {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.d-type.large { background: #e3f2fd; color: #1565c0; }
.d-type.small { background: #e8f5e9; color: #2e7d32; }

.d-lab {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-bottom: 16rpx;
}

.badge-row {
  display: flex;
  gap: 12rpx;
}

.badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  min-width: 80rpx;
}

.badge-num {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.badge-label {
  font-size: 20rpx;
  margin-top: 2rpx;
}

.badge.available { background: #e8f5e9; }
.badge.available .badge-num { color: #2e7d32; }
.badge.available .badge-label { color: #66bb6a; }

.badge.using, .badge.using-active { background: #fff8e1; }
.badge.using .badge-num, .badge.using-active .badge-num { color: #f57c00; }
.badge.using .badge-label, .badge.using-active .badge-label { color: #ffb74d; }
.badge.using-active { background: #fff3cd; }

.badge.maint, .badge.maint-active { background: #fce4ec; }
.badge.maint .badge-num, .badge.maint-active .badge-num { color: #c62828; }
.badge.maint .badge-label, .badge.maint-active .badge-label { color: #ef9a9a; }

.card-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* ===== Tab 1: 发布消息 ===== */
.compose-card {
  background: white;
  border-radius: 20rpx;
  padding: 36rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  margin-bottom: 24rpx;
}

.compose-heading {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 8rpx;
}

.compose-hint {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  margin-bottom: 32rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.title-input {
  width: 100%;
  height: 72rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  border: 1rpx solid #e8ecf0;
  box-sizing: border-box;
}

.content-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  border: 1rpx solid #e8ecf0;
  box-sizing: border-box;
  line-height: 1.6;
}

.send-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #62BCC4, #4da9b1);
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-top: 8rpx;
}

.send-btn.sending { background: #a8d8dc; }

/* 历史通知 */
.sent-section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.sent-heading {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sent-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.sent-item:last-child { border-bottom: none; }

.sent-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.sent-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.sent-date {
  font-size: 22rpx;
  color: #aaa;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.sent-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.exit-confirm-panel {
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.exit-confirm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 16rpx;
}

.exit-confirm-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 48rpx;
  text-align: center;
}

.exit-confirm-btns {
  display: flex;
  width: 100%;
  gap: 24rpx;
}

.exit-cancel-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #f0f0f0;
  color: #666;
  border: none;
  border-radius: 14rpx;
}

.exit-confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #e74c3c;
  color: white;
  border: none;
  border-radius: 14rpx;
}

.reserve-summary {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.summary-card {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.summary-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1565c0;
  line-height: 1.2;
}

.summary-num.using-color { color: #f57c00; }
.summary-num.completed-color { color: #2e7d32; }
.summary-num.total-color { color: #333; }

.summary-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}

.reserve-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reserve-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.reserve-card .card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.reserve-card .d-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
  flex: 1;
  margin-right: 12rpx;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-tag.upcoming { background: #e3f2fd; color: #1565c0; }
.status-tag.using { background: #fff8e1; color: #f57c00; }
.status-tag.completed { background: #e8f5e9; color: #2e7d32; }
.status-tag.past { background: #f5f5f5; color: #999; }

.reserve-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reserve-person {
  font-size: 24rpx;
  color: #666;
}

.reserve-time {
  font-size: 22rpx;
  color: #999;
}

.view-all-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 24rpx;
  background: white;
  border-radius: 16rpx;
  color: #62BCC4;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
