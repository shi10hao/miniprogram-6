.container {
  min-height: 100vh;
  background: #f0f4f8;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #2d6a6e, #62BCC4);
  padding: 48rpx 40rpx 36rpx;
}

.device-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

.center-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
  color: #aaa;
  font-size: 26rpx;
}

.loading-spin {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #62BCC4;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.content {
  padding: 24rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.empty-hint {
  text-align: center;
  color: #aaa;
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* 仪器实例 */
.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-item {
  padding: 20rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  border: 1rpx solid #e8ecf0;
}

.device-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.device-id {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.status-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-badge.available { background: #e8f5e9; color: #2e7d32; }
.status-badge.using { background: #fff8e1; color: #f57c00; }
.status-badge.maintenance { background: #fce4ec; color: #c62828; }

.maint-btn {
  width: 100%;
  height: 64rpx;
  background: white;
  color: #666;
  font-size: 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.maint-btn.active {
  background: #62BCC4;
  color: white;
  border-color: #62BCC4;
}

/* 使用情况 */
.usage-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.usage-item {
  padding: 24rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  border: 1rpx solid #e8ecf0;
}

.usage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.duration {
  font-size: 22rpx;
  color: #f57c00;
  font-weight: 500;
}

.device-id-small {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.photo-section {
  margin-top: 16rpx;
}

.photo-label {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.usage-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #eee;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-item {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.photo-tip {
  width: 100%;
  font-size: 20rpx;
  color: #666;
  line-height: 1.4;
  text-align: center;
  word-break: break-all;
}

/* 预约情况 */
.reserve-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reserve-item {
  padding: 20rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  border: 1rpx solid #e8ecf0;
}

.reserve-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.reserve-date {
  font-size: 22rpx;
  color: #666;
}

.reserve-time {
  display: block;
  font-size: 24rpx;
  color: #62BCC4;
  font-weight: 500;
  margin-bottom: 8rpx;
}
