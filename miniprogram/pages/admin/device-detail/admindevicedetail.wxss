/* 仪器详情（管理端）—— 全部基于 app.wxss 的 --ds-* 变量与 ds-* 类 */

.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ==================== 顶部身份区 ==================== */

.hero {
  position: relative;
  padding: 40rpx 36rpx 104rpx;
  background: linear-gradient(160deg, var(--ds-primary-deep) 0%, var(--ds-primary-dark) 58%, var(--ds-primary) 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  top: -160rpx;
  right: -120rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-deco::after {
  content: '';
  position: absolute;
  left: -180rpx;
  bottom: -260rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
}

.hero-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--ds-surface);
  opacity: 0.85;
}

.hero-eyebrow-text {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--ds-surface);
  opacity: 0.86;
}

.hero-chip {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 22rpx;
  border-radius: var(--ds-radius-pill);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  color: var(--ds-surface);
}

.chip-available {
  background: rgba(16, 185, 129, 0.3);
  border-color: rgba(255, 255, 255, 0.42);
}

.chip-using {
  background: rgba(16, 185, 129, 0.34);
  border-color: rgba(255, 255, 255, 0.42);
}

.chip-maintenance {
  background: rgba(245, 158, 11, 0.34);
  border-color: rgba(255, 255, 255, 0.42);
}

.chip-none {
  background: rgba(255, 255, 255, 0.1);
}

.hero-title {
  position: relative;
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--ds-surface);
}

.hero-sub {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--ds-surface);
  opacity: 0.82;
}

.hero-sub-dot {
  margin: 0 12rpx;
  opacity: 0.6;
}

/* 实验室 / 型号可能很长，单行省略，不要把标题区顶成两行 */
.hero-sub-item {
  max-width: 46%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-stats {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 22rpx 0;
  border-radius: var(--ds-radius);
  background: rgba(255, 255, 255, 0.12);
}

.hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ds-surface);
  line-height: 1.2;
}

.hero-stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ds-surface);
  opacity: 0.76;
}

.hero-stat-line {
  width: 2rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.22);
}

/* ==================== 内容容器 ==================== */

.body {
  position: relative;
  margin: -76rpx 24rpx 0;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 18rpx 26rpx;
  border-radius: var(--ds-radius);
  background: var(--ds-primary-light);
}

.filter-text {
  flex: 1;
  margin-right: 16rpx;
  font-size: 25rpx;
  color: var(--ds-primary-deep);
}

.filter-action {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ds-primary-dark);
}

.filter-bar-warn {
  background: var(--ds-warning-light);
}

.filter-bar-warn .filter-text {
  color: var(--ds-warning);
}

/* 加载骨架 */

.sk-title {
  width: 42%;
  height: 34rpx;
}

.sk-line {
  width: 100%;
  height: 24rpx;
  margin-top: 20rpx;
}

.sk-line-short {
  width: 62%;
}

.empty-btn {
  margin-top: 32rpx;
  width: 260rpx;
  margin-left: auto;
  margin-right: auto;
}

/* ==================== 卡片通用 ==================== */

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.head-action {
  padding: 8rpx 26rpx;
  border-radius: var(--ds-radius-pill);
  background: var(--ds-primary-light);
  font-size: 25rpx;
  color: var(--ds-primary-deep);
}

.head-meta {
  display: flex;
  align-items: center;
}

.head-count {
  font-size: 23rpx;
  color: var(--ds-text-muted);
}

.head-arrow {
  margin-left: 8rpx;
  font-size: 34rpx;
  line-height: 1;
  color: var(--ds-text-disabled);
  transform: rotate(90deg);
  transition: transform 0.2s;
}

.head-arrow.arrow-folded {
  transform: rotate(0deg);
}

/* ==================== 仪器信息 ==================== */

.cover-wrap {
  overflow: hidden;
  border-radius: var(--ds-radius);
  background: var(--ds-fill);
}

.cover {
  width: 100%;
  height: 320rpx;
  display: block;
}

.cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  border: 2rpx dashed var(--ds-border);
  border-radius: var(--ds-radius);
  background: var(--ds-fill);
}

.cover-empty-icon {
  font-size: 40rpx;
  opacity: 0.5;
}

.cover-empty-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.desc {
  margin-top: 24rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--ds-text-secondary);
}

.desc-muted {
  color: var(--ds-text-muted);
}

.spec-block {
  margin-top: 28rpx;
}

.block-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--ds-text-muted);
}

.spec-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--ds-divider);
}

.spec-row:last-child {
  border-bottom: none;
}

.spec-key {
  flex-shrink: 0;
  width: 190rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

.spec-value {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ds-text);
}

.text-block {
  margin-top: 24rpx;
}

.block-text {
  padding: 20rpx 24rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--ds-text-secondary);
}

.block-text-warn {
  background: var(--ds-warning-light);
  color: var(--ds-text);
}

.video-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--ds-radius);
  background: var(--ds-primary-soft);
}

.video-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: var(--ds-primary);
  color: var(--ds-surface);
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
}

.video-body {
  flex: 1;
}

.video-title {
  font-size: 27rpx;
  color: var(--ds-primary-deep);
}

.video-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.video-arrow {
  font-size: 34rpx;
  color: var(--ds-primary-dark);
}

/* ==================== 编辑态 ==================== */

.edit-field {
  margin-bottom: 28rpx;
}

.edit-label {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
}

.edit-input {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
  font-size: 28rpx;
  color: var(--ds-text);
}

.edit-textarea {
  width: 100%;
  min-height: 130rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ds-text);
}

.edit-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.edit-cover {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 240rpx;
  overflow: hidden;
  border: 2rpx dashed var(--ds-border);
  border-radius: var(--ds-radius);
  background: var(--ds-fill);
}

.edit-cover-img {
  width: 100%;
  height: 240rpx;
  display: block;
}

.edit-cover-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.edit-cover-plus {
  font-size: 44rpx;
  line-height: 1.1;
  color: var(--ds-primary);
}

.edit-cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56rpx;
  background: rgba(31, 39, 51, 0.5);
  color: var(--ds-surface);
  font-size: 23rpx;
  line-height: 56rpx;
  text-align: center;
}

.edit-video {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
}

.edit-video-text {
  flex: 1;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
}

.edit-video-action {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--ds-primary-dark);
}

.save-bar {
  margin-top: 8rpx;
}

.save-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  text-align: center;
  color: var(--ds-text-muted);
}

.btn-loading {
  opacity: 0.6;
}

/* ==================== 仪器实例 ==================== */

.device-item {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: var(--ds-radius);
  background: var(--ds-fill);
}

.device-item:last-child {
  margin-bottom: 0;
}

.device-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-code {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ds-text);
}

.device-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.device-meta-dot {
  margin: 0 8rpx;
}

.device-user {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ds-primary-dark);
}

.device-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.mini-btn {
  margin-left: 16rpx;
  padding: 10rpx 28rpx;
  border: 2rpx solid var(--ds-border);
  border-radius: var(--ds-radius-pill);
  background: var(--ds-surface);
  font-size: 24rpx;
  color: var(--ds-text-secondary);
}

.mini-btn-danger {
  border-color: transparent;
  background: var(--ds-danger-light);
  color: var(--ds-danger);
}

.expand-btn {
  padding: 22rpx 0 6rpx;
  font-size: 25rpx;
  text-align: center;
  color: var(--ds-primary-dark);
}

.add-instance {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.add-input {
  flex: 1;
  height: 80rpx;
  margin-right: 16rpx;
  padding: 0 28rpx;
  border-radius: var(--ds-radius-pill);
  background: var(--ds-fill);
  font-size: 27rpx;
  color: var(--ds-text);
}

.add-btn {
  flex-shrink: 0;
  width: 150rpx;
  height: 80rpx;
  border-radius: var(--ds-radius-pill);
  background: var(--ds-primary);
  color: var(--ds-surface);
  font-size: 27rpx;
  line-height: 80rpx;
  text-align: center;
}

.ds-empty-inline {
  padding: 32rpx 0;
}

/* ==================== 使用记录 / 照片 ==================== */

.record-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--ds-divider);
}

.record-item:last-child {
  border-bottom: none;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ds-text);
}

.record-time {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--ds-text-secondary);
}

.record-date {
  margin-right: 16rpx;
}

.record-clock {
  color: var(--ds-text);
}

.record-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 23rpx;
}

.record-duration {
  color: var(--ds-primary-dark);
}

.record-device {
  color: var(--ds-text-muted);
}

.photo-record {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--ds-divider);
}

.photo-record:last-child {
  border-bottom: none;
}

.photo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.photo-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ds-text);
}

.photo-count {
  font-size: 23rpx;
  color: var(--ds-text-muted);
}

.photo-time {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ds-text-secondary);
}

.photo-time-dot {
  margin: 0 8rpx;
  color: var(--ds-text-disabled);
}

.photo-abnormal {
  margin-left: 12rpx;
  color: var(--ds-warning);
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx -6rpx 0;
}

.photo-cell {
  width: 33.333%;
  padding: 6rpx;
  box-sizing: border-box;
}

.photo-img {
  width: 100%;
  height: 190rpx;
  display: block;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
}

/* ==================== 预约 ==================== */

.reserve-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--ds-divider);
}

.reserve-item:last-child {
  border-bottom: none;
}

.reserve-left {
  flex-shrink: 0;
  width: 200rpx;
}

.reserve-date {
  font-size: 26rpx;
  color: var(--ds-text);
}

.reserve-clock {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--ds-text-muted);
}

.reserve-right {
  flex: 1;
  margin-right: 16rpx;
}

.reserve-name {
  font-size: 27rpx;
  color: var(--ds-text);
}

.reserve-device {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--ds-text-muted);
}

.reserve-tag {
  flex-shrink: 0;
}

/* ==================== 页脚 ==================== */

.foot-note {
  padding: 24rpx 0 8rpx;
  font-size: 22rpx;
  text-align: center;
  color: var(--ds-text-disabled);
}
