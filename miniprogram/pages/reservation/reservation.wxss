/* 预约页样式 —— 使用 app.wxss 的设计变量 */

/* --------------------------------------------------------------------------
   预约人：一行紧凑展示，不再占一整张卡
   -------------------------------------------------------------------------- */
.person-card {
  display: flex;
  align-items: center;
  gap: var(--ds-gap-sm);
  padding: 26rpx var(--ds-gap-lg);
}

.person-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--ds-primary-deep), var(--ds-primary));
  flex-shrink: 0;
}

.person-body {
  flex: 1;
  min-width: 0;
}

.person-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.person-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.person-id {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.person-group {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ds-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* --------------------------------------------------------------------------
   搜索
   -------------------------------------------------------------------------- */
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 24rpx;
  background: var(--ds-fill);
  border: 1rpx solid var(--ds-border);
  border-radius: var(--ds-radius-pill);
}

.search-icon {
  font-size: 26rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 27rpx;
  color: var(--ds-text);
}

.clear-search {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 22rpx;
  color: var(--ds-text-muted);
  background: var(--ds-border);
}

/* --------------------------------------------------------------------------
   筛选：每个条件独占一行，标签固定宽度，按钮撑满剩余空间
   -------------------------------------------------------------------------- */
.filter-block {
  margin-top: var(--ds-gap);
}

.filter-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-line + .filter-line {
  margin-top: 14rpx;
}

.filter-label {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.filter-buttons {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 10rpx;
}

.filter-btn {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 4rpx;
  border-radius: var(--ds-radius-sm);
  font-size: 24rpx;
  color: var(--ds-text-secondary);
  background: var(--ds-fill);
  transition: background 0.2s ease, color 0.2s ease;
}

.filter-btn.active {
  background: var(--ds-primary);
  color: #fff;
  font-weight: 500;
}

/* --------------------------------------------------------------------------
   仪器列表
   列表可能上百条，用固定高度的内层滚动区，
   保证「预约说明」和后续卡片不会被挤出屏幕很远
   -------------------------------------------------------------------------- */
.device-count {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.device-list {
  margin-top: var(--ds-gap);
}

.device-scroll {
  max-height: 720rpx;
  height: 720rpx;
}

/* --------------------------------------------------------------------------
   仪器卡片（真正的卡片观感：白底 + 阴影 + 缩略图）
   -------------------------------------------------------------------------- */
.device-card {
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  padding: var(--ds-gap);
  margin-bottom: var(--ds-gap-sm);
  border: 1rpx solid var(--ds-border);
  box-shadow: var(--ds-shadow-sm);
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.device-card:active {
  background: var(--ds-fill);
}

.device-card.selected {
  border-color: var(--ds-primary);
  background: var(--ds-primary-soft);
  box-shadow: 0 6rpx 20rpx var(--ds-primary-shadow);
}

.device-card-main {
  display: flex;
  align-items: flex-start;
  gap: var(--ds-gap-sm);
}

/* 缩略图 */
.device-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--ds-radius-sm);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--ds-fill);
}

.device-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.device-thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ds-primary-light);
}

.device-thumb-icon {
  font-size: 52rpx;
}

.device-info {
  flex: 1;
  min-width: 0;
}

.device-name-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.device-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
  max-width: 70%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.device-model {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ds-text-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 右侧状态区 */
.device-side {
  flex-shrink: 0;
  align-self: center;
  margin-left: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.selected-indicator {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ds-primary);
  box-shadow: 0 4rpx 10rpx var(--ds-primary-shadow);
}

.selected-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1;
}

.device-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 10rpx;
}

/* 卡片里的标签：尺寸全部自己算，不再继承全局 ds-tag 的 padding + line-height 1.5
   （那样 22rpx 的字会被撑成 45rpx 高的方块）。
   承载元素用 view 而不是 text：text 组件在真机上会保留 wxml 里的换行缩进，
   且固定高度、垂直居中都不生效，标签会自己长高、文字贴底。 */
.rsv-tag {
  display: inline-block;
  height: 36rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: var(--ds-radius-sm);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 36rpx;
  white-space: nowrap;
}

/* 同一行标签之间留 8rpx：不用 gap，部分安卓内核不支持 */
.device-tags .rsv-tag + .rsv-tag {
  margin-left: 8rpx;
}

.rsv-tag--primary {
  background: var(--ds-primary-light);
  color: var(--ds-primary-dark);
}

.rsv-tag--success {
  background: var(--ds-success-light);
  color: var(--ds-success);
}

.rsv-tag--warning {
  background: var(--ds-warning-light);
  color: var(--ds-warning);
}

.rsv-tag--danger {
  background: var(--ds-danger-light);
  color: var(--ds-danger);
}

.rsv-tag--muted {
  background: var(--ds-fill);
  color: var(--ds-text-muted);
}

.device-location-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
}

.device-location-icon {
  font-size: 22rpx;
  margin-right: 2rpx;
  opacity: 0.7;
}

.device-lab-name {
  font-size: 24rpx;
  color: var(--ds-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.device-room-text {
  font-size: 24rpx;
  color: var(--ds-text-muted);
  flex-shrink: 0;
}

/* --------------------------------------------------------------------------
   仪器编号选择（选中后展开的面板）
   -------------------------------------------------------------------------- */
.your-content {
  margin-top: var(--ds-gap);
  padding-top: var(--ds-gap);
  border-top: 1rpx solid var(--ds-divider);
}

.sub-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ds-text-secondary);
}

/* 标题前的小色块，与区块标题保持一致的视觉语言 */
.sub-label::before {
  content: '';
  width: 6rpx;
  height: 22rpx;
  border-radius: 3rpx;
  background: var(--ds-primary);
}

/* 详情页带编号进来时的说明："同款还有几台可换" */
.preselect-hint {
  display: block;
  margin: -6rpx 0 14rpx;
  font-size: 22rpx;
  color: var(--ds-primary-dark);
}

/* 编号列表用两列：flex + 百分比宽度，不用 grid / gap。
   grid 在部分安卓内核（X5）不支持，会退化成块级——每个编号独占一行、铺满整行。 */
.all_devices_btns {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 单个编号：单行「编号 | 状态」，高度收到 64rpx。
   原来文案换行 + 12rpx 内边距，一个编号块近 90rpx 高，列表一多非常臃肿。 */
.rsv-chip {
  width: 49%;
  height: 64rpx;
  margin-bottom: 12rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  font-size: 24rpx;
  transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.1s ease;
}

.rsv-chip-no {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 状态文字用一条细竖线跟编号隔开，比换行更省高度，也不会显得空 */
.rsv-chip-status {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding-left: 10rpx;
  border-left: 1rpx solid currentColor;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 1.2;
  opacity: 0.75;
  white-space: nowrap;
}

/* 「· 当前」跟在状态文字后面，不另起一行，避免编号块高度不齐 */
.rsv-chip-current {
  font-weight: 500;
  opacity: 1;
}

/* 按状态给底色，统一用设计变量，不再用高饱和实心块 */
.rsv-chip.status-available {
  background: var(--ds-success-light);
  border-color: #b7e4cd;
  color: #166534;
}

.rsv-chip.status-reserved {
  background: var(--ds-warning-light);
  border-color: #f3ddb0;
  color: #92400e;
}

.rsv-chip.status-using {
  background: var(--ds-primary-light);
  border-color: #b3e0e4;
  color: #1e5f66;
}

.rsv-chip.status-maintenance {
  background: var(--ds-fill);
  border-color: var(--ds-border);
  color: var(--ds-text-muted);
}

/* 只有「可用」的编号可以选，按下去给一点缩放反馈。
   view 上的 :active 在真机不触发，所以真机靠 wxml 的 hover-class 挂 .rsv-chip--pressed，
   :active 只是给浏览器预览用 */
.rsv-chip.status-available:active,
.rsv-chip--pressed {
  transform: scale(0.97);
}

/* 选中态统一用品牌色，替掉原来的 Element UI 蓝 */
.rsv-chip.active {
  background: var(--ds-primary);
  border-color: var(--ds-primary);
  color: #fff;
  box-shadow: 0 4rpx 12rpx var(--ds-primary-shadow);
}

/* 选中后各状态标签统一变白，不再逐个指定颜色 */
.rsv-chip.active .rsv-chip-status {
  color: #fff;
  opacity: 0.9;
  border-left-color: rgba(255, 255, 255, 0.6);
}

/* --------------------------------------------------------------------------
   冲突提示
   -------------------------------------------------------------------------- */
.conflict-warning {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: var(--ds-warning-light);
  border: 1rpx solid #f3ddb0;
  border-radius: var(--ds-radius-sm);
}

.warning-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.warning-text {
  font-size: 24rpx;
  color: #856404;
}

/* --------------------------------------------------------------------------
   预约时间：四格并排
   -------------------------------------------------------------------------- */
.time-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--ds-gap-sm);
}

.time-field {
  min-width: 0;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.picker-view {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--ds-text);
  background: var(--ds-fill);
  border: 1rpx solid var(--ds-border);
  border-radius: var(--ds-radius-sm);
  box-sizing: border-box;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-view:active {
  background: var(--ds-primary-light);
  border-color: var(--ds-primary);
}

/* 时间范围提示放在区块标题右侧 */
.time-hint {
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

/* --------------------------------------------------------------------------
   系统预约单
   -------------------------------------------------------------------------- */
.reserve-page-section {
  margin-top: var(--ds-gap-lg);
  padding-top: var(--ds-gap);
  border-top: 1rpx solid var(--ds-divider);
}

.slot-upload {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--ds-radius-sm);
  overflow: hidden;
  border: 2rpx dashed var(--ds-border);
  background: var(--ds-fill);
  position: relative;
}

.slot-upload:active {
  border-color: var(--ds-primary);
}

.slot-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  gap: 8rpx;
}

.slot-plus {
  font-size: 48rpx;
  color: var(--ds-text-disabled);
  line-height: 1;
}

.slot-tip {
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.slot-preview {
  width: 100%;
  height: 100%;
}

.slot-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* --------------------------------------------------------------------------
   提示条
   -------------------------------------------------------------------------- */
.alert {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--ds-gap);
  padding: 20rpx;
  border-radius: var(--ds-radius-sm);
}

.alert-danger {
  background: var(--ds-danger-light);
  border: 1rpx solid #f8c9c9;
}

.alert-danger .alert-text {
  color: #b91c1c;
}

.alert-warning {
  background: var(--ds-warning-light);
  border: 1rpx solid #f3ddb0;
}

.alert-warning .alert-text {
  color: #92400e;
}

.alert-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.alert-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* --------------------------------------------------------------------------
   吸底提交栏：页面再长也不用滚到底部才能提交
   -------------------------------------------------------------------------- */
.has-sticky-bar {
  padding-bottom: 200rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: var(--ds-gap);
  padding: 20rpx var(--ds-gap);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--ds-surface);
  border-top: 1rpx solid var(--ds-divider);
  box-shadow: 0 -6rpx 24rpx rgba(31, 39, 51, 0.06);
}

.submit-bar-info {
  flex: 1;
  min-width: 0;
}

.submit-device {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ds-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.submit-slot {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ds-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.submit-tip {
  display: block;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.submit-btn {
  flex-shrink: 0;
  width: 280rpx;
  height: 84rpx;
  padding: 0 32rpx;
  border-radius: var(--ds-radius-pill);
  background: var(--ds-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
  box-shadow: 0 6rpx 18rpx var(--ds-primary-shadow);
}

/* 还没选好：浅底描边代替整块灰底，和主按钮拉开层级；
   按钮依然可以点，点下去会 toast 提示还缺哪一步，不再是「点了没反应」 */
.submit-btn.disabled {
  background: var(--ds-fill);
  color: var(--ds-text-secondary);
  border: 1rpx solid var(--ds-border);
  box-shadow: none;
}

/* 提交中：沿用主色，只降一点不透明度，避免按钮在提交瞬间突然变灰 */
.submit-btn.submitting {
  background: var(--ds-primary);
  color: #fff;
  opacity: 0.75;
  box-shadow: none;
}

.submit-btn.submitting:active {
  opacity: 0.75;
}

/* --------------------------------------------------------------------------
   预约说明
   -------------------------------------------------------------------------- */
.instructions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.instruction-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.bullet {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ds-primary);
  opacity: 0.6;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.instruction-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ds-text-secondary);
}
