<view class="ds-page has-sticky-bar">
  <!-- ==================== 预约人 ==================== -->
  <view class="ds-card person-card">
    <view class="person-avatar">
      <text>{{userInfo.name[0] || '👤'}}</text>
    </view>
    <view class="person-body">
      <view class="person-line">
        <text class="person-name">{{userInfo.name}}</text>
        <text class="person-id">{{userInfo.userId}}</text>
      </view>
      <text class="person-group">{{userInfo.researchGroup}}</text>
    </view>
    <text class="ds-tag ds-tag-primary">预约人</text>
  </view>

  <!-- ==================== 预约时间 ==================== -->
  <view class="ds-card">
    <view class="ds-section-head">
      <text class="ds-section-title">预约时间</text>
      <text class="time-hint">8:00 - 22:00</text>
    </view>

    <view class="time-grid">
      <view class="time-field">
        <text class="field-label">开始日期</text>
        <picker mode="date" value="{{startDate}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onStartDateChange" class="time-picker">
          <view class="picker-view">{{startDate || '请选择'}}</view>
        </picker>
      </view>
      <view class="time-field">
        <text class="field-label">开始时间</text>
        <picker mode="time" value="{{startTime}}" start="08:00" end="22:00" bindchange="onStartTimeChange" class="time-picker">
          <view class="picker-view">{{startTime || '08:00'}}</view>
        </picker>
      </view>
      <view class="time-field">
        <text class="field-label">结束日期</text>
        <picker mode="date" value="{{endDate}}" start="{{startDate}}" end="{{maxEndDate}}" bindchange="onEndDateChange" class="time-picker">
          <view class="picker-view">{{endDate || '请选择'}}</view>
        </picker>
      </view>
      <view class="time-field">
        <text class="field-label">结束时间</text>
        <picker mode="time" value="{{endTime}}" start="08:00" end="22:00" bindchange="onEndTimeChange" class="time-picker">
          <view class="picker-view">{{endTime || '09:00'}}</view>
        </picker>
      </view>
    </view>

    <!-- 系统预约单 -->
    <view class="reserve-page-section">
      <text class="field-label">系统预约单</text>
      <view class="slot-upload" bind:tap="pickReservePage">
        <view wx:if="{{reservePage}}" class="slot-preview">
          <image class="slot-img" src="{{reservePage}}" mode="aspectFill" />
        </view>
        <view wx:else class="slot-empty">
          <text class="slot-plus">+</text>
          <text class="slot-tip">点击选择截图</text>
        </view>
      </view>
    </view>

    <view wx:if="{{timeConflict}}" class="alert alert-danger">
      <text class="alert-icon">🚫</text>
      <text class="alert-text">该时段已被预约，请选择其他时间或仪器实例</text>
    </view>
    <view wx:if="{{isPastTime}}" class="alert alert-warning">
      <text class="alert-icon">⏰</text>
      <text class="alert-text">不能预约过去的时间</text>
    </view>
  </view>

  <!-- ==================== 选择仪器 ==================== -->
  <view class="ds-card">
    <view class="ds-section-head">
      <text class="ds-section-title">选择仪器</text>
      <text class="device-count">共 {{availableDevices.length}} 种</text>
    </view>

    <!-- 搜索 -->
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索仪器名称、实验室..."
        bindinput="onSearchInput"
        value="{{filters.searchKeyword}}"
        confirm-type="search"
      />
      <text class="clear-search" wx:if="{{filters.searchKeyword}}" bindtap="clearSearch">✕</text>
    </view>

    <!-- 筛选：每个条件独占一行，标签在左、按钮在右，保证点击区域够大 -->
    <view class="filter-block">
      <view class="filter-line">
        <text class="filter-label">实验室</text>
        <view class="filter-buttons">
          <text class="filter-btn {{filters.labType === 'all' ? 'active' : ''}}" data-type="all" bindtap="onLabTypeChange">全部</text>
          <text class="filter-btn {{filters.labType === 'public' ? 'active' : ''}}" data-type="public" bindtap="onLabTypeChange">公共实验室</text>
          <text class="filter-btn {{filters.labType === 'group' ? 'active' : ''}}" data-type="group" bindtap="onLabTypeChange">课题组</text>
        </view>
      </view>
      <view class="filter-line">
        <text class="filter-label">仪器</text>
        <view class="filter-buttons">
          <text class="filter-btn {{filters.deviceType === 'all' ? 'active' : ''}}" data-type="all" bindtap="onDeviceTypeChange">全部</text>
          <text class="filter-btn {{filters.deviceType === 'large' ? 'active' : ''}}" data-type="large" bindtap="onDeviceTypeChange">大型仪器</text>
          <text class="filter-btn {{filters.deviceType === 'small' ? 'active' : ''}}" data-type="small" bindtap="onDeviceTypeChange">小型仪器</text>
        </view>
      </view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{isLoading}}" class="ds-loading">
      <view class="ds-spinner"></view>
      <text>加载中</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{availableDevices.length === 0}}" class="ds-empty">
      <text class="ds-empty-icon">🔍</text>
      <text class="ds-empty-title">暂无可用仪器</text>
      <text class="ds-empty-desc">请调整筛选条件或联系管理员</text>
    </view>

    <view wx:else class="device-list">
      <!-- 仪器数量多，用内层滚动把后续卡片保持在首屏可见范围内 -->
      <scroll-view scroll-y class="device-scroll">
        <view
          class="device-card {{selectedDevice && selectedDevice.device_ids[0] === group.device_ids[0] ? 'selected' : ''}}"
          wx:for="{{availableDevices}}"
          wx:for-item="group"
          wx:for-index="groupIndex"
          wx:key="device_id"
          data-device="{{group}}"
          bindtap="selectDevice"
        >
          <!-- 主行：缩略图 + 名称/型号 + 右侧状态 -->
          <view class="device-card-main">
            <view class="device-thumb">
              <image
                wx:if="{{group.picture && !group.imgFailed}}"
                class="device-thumb-img"
                src="{{group.picture}}"
                mode="aspectFill"
                lazy-load
                binderror="onDeviceImgError"
                data-index="{{groupIndex}}"
              ></image>
              <view wx:else class="device-thumb-fallback">
                <text class="device-thumb-icon">{{group.device_type === 'large' ? '🧪' : '🔬'}}</text>
              </view>
            </view>

            <view class="device-info">
              <view class="device-name-row">
                <text class="device-name">{{group.device_name}}</text>
                <text wx:if="{{group.deviceModel}}" class="device-model">{{group.deviceModel}}</text>
              </view>

              <!-- 标签用 view 承载、文案与标签写在同一行：text 组件在真机上会保留 wxml 里的
                   换行缩进（标签内多出一行空行），也不吃固定高度，所以不再用 text + 全局 ds-tag -->
              <view class="device-tags">
                <view class="rsv-tag rsv-tag--{{group.lab_type === 'public' ? 'primary' : (group.lab_type === 'group' ? 'warning' : 'success')}}">{{group.lab_type === 'public' ? '公共实验室' : (group.lab_type === 'group' ? '课题组' : '公共/课题组')}}</view>
                <view class="rsv-tag rsv-tag--{{group.device_type === 'large' ? 'danger' : 'success'}}">{{group.device_type === 'large' ? '大型仪器' : '小型仪器'}}</view>
              </view>

              <view class="device-location-row">
                <text class="device-location-icon">📍</text>
                <text class="device-lab-name">{{group.lab_name || '未设置实验室'}}</text>
                <text class="device-room-text" wx:if="{{group.device_room}}">· {{group.device_room}}</text>
              </view>
            </view>

            <view class="device-side">
              <view
                wx:if="{{group.remainingCount > 0 && !(selectedDevice && selectedDevice.device_ids[0] === group.device_ids[0])}}"
                class="rsv-tag rsv-tag--success"
              >剩余 {{group.remainingCount}} 台</view>
              <view
                wx:elif="{{group.remainingCount === 0 && !(selectedDevice && selectedDevice.device_ids[0] === group.device_ids[0])}}"
                class="rsv-tag rsv-tag--muted"
              >已约满</view>
              <!-- 只有真的选了编号才打勾：选中组但没选编号时按钮仍是灰的，避免看起来已经选好 -->
              <view
                wx:if="{{selectedDeviceId && selectedDevice && selectedDevice.device_ids[0] === group.device_ids[0]}}"
                class="selected-indicator"
              >
                <text class="selected-icon">✓</text>
              </view>
            </view>
          </view>

          <!-- 冲突提示 -->
          <view wx:if="{{group.conflictCount > 0}}" class="conflict-warning">
            <text class="warning-icon">⚠️</text>
            <text class="warning-text">这段时间已有 {{group.conflictCount}} 个预约</text>
          </view>

          <!-- 选中该组后才展示编号。deviceStatusList 与 device_ids 一一对应，
               所以这里直接用 deviceStatusList 的 index，不再跨循环取下标 -->
          <view
            wx:if="{{selectedDevice && selectedDevice.device_ids[0] === group.device_ids[0]}}"
            class="your-content"
          >
            <text class="sub-label">选择仪器编号</text>
            <view class="all_devices_btns">
              <view
                class="rsv-chip status-{{deviceItem.status}} {{deviceItem.active ? 'active' : ''}}"
                wx:for="{{group.deviceStatusList}}"
                wx:for-item="deviceItem"
                wx:for-index="deviceIndex"
                wx:key="device_id"
                data-index="{{groupIndex}}"
                data-device-index="{{deviceIndex}}"
                data-id="{{deviceItem.device_id}}"
                data-status="{{deviceItem.status}}"
                hover-class="{{deviceItem.status === 'available' ? 'rsv-chip--pressed' : 'none'}}"
                hover-stay-time="60"
                bindtap="onSelectDevice"
                catchtap
              >
                <view class="rsv-chip-no">{{deviceItem.device_id}}</view>
                <view class="rsv-chip-status">{{deviceItem.status === 'available' ? '可用' : deviceItem.status === 'reserved' ? '已预约' : deviceItem.status === 'using' ? '使用中' : '维修中'}}</view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ==================== 预约说明 ==================== -->
  <view class="ds-card">
    <view class="ds-section-head">
      <text class="ds-section-title">预约说明</text>
    </view>
    <view class="instructions">
      <view class="instruction-item">
        <text class="bullet"></text>
        <text class="instruction-text">只能预约公共实验室和自己课题组的仪器</text>
      </view>
      <view class="instruction-item">
        <text class="bullet"></text>
        <text class="instruction-text">预约时间为每日 8:00-22:00，最多可跨 2 天</text>
      </view>
      <view class="instruction-item">
        <text class="bullet"></text>
        <text class="instruction-text">选择仪器后再选择具体的仪器编号</text>
      </view>
      <view class="instruction-item">
        <text class="bullet"></text>
        <text class="instruction-text">同一时间段内不可重复预约同一台仪器</text>
      </view>
    </view>
  </view>
</view>

<!-- ==================== 吸底提交栏 ==================== -->
<view class="submit-bar">
  <view class="submit-bar-info">
    <text wx:if="{{selectedDevice}}" class="submit-device">{{selectedDevice.device_name}}</text>
    <text wx:if="{{selectedDevice && selectedDeviceId}}" class="submit-slot">{{selectedDeviceId}}</text>
    <text wx:if="{{!selectedDevice}}" class="submit-tip">请先选择仪器</text>
    <text wx:elif="{{!selectedDeviceId}}" class="submit-tip">请选择仪器编号</text>
  </view>
  <!-- 按钮不再挂原生 disabled：原生 disabled 会让点击完全没有反馈，
       这里用 disabled 样式表示「还没准备好」，点下去由 submitReservation 给出文字提示 -->
  <button
    class="ds-btn submit-btn {{(!selectedDevice || !selectedDeviceId) ? 'disabled' : ''}} {{isSubmitting ? 'submitting' : ''}}"
    bindtap="submitReservation"
  >
    <text wx:if="{{isSubmitting}}">提交中…</text>
    <text wx:else>提交预约</text>
  </button>
</view>
