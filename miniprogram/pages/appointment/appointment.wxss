.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tabs {
  display: flex;
  background-color: white;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-active {
  color: var(--ds-primary);
  font-weight: bold;
  border-bottom: 4rpx solid var(--ds-primary);
}

/* 状态筛选子 tab（预约有 5 个，间距收紧一点） */
.filter-tabs {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 16rpx;
  background-color: white;
  border-bottom: 1rpx solid var(--ds-divider);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
  background-color: var(--ds-fill);
  border-radius: 12rpx;
  transition: all 0.2s;
}

.filter-active {
  color: #fff;
  font-weight: 500;
  background-color: var(--ds-primary);
}

.loading {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
  color: #666;
  font-size: 28rpx;
}

.empty {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}

.history-list {
  padding: 20rpx;
}

.history-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.device-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
  margin-left: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.status.approved {
  background-color: #d4edda;
  color: #155724;
}

.status.effective {
  background-color: #d4edda;
  color: #155724;
}

.status.inactive {
  background-color: #f1f3f5;
  color: #6c757d;
}

.status.pending {
  background-color: #fff3cd;
  color: #856404;
}

.status.completed {
  background-color: #d1edff;
  color: #0c5460;
}

.status.upcoming {
  background-color: var(--ds-primary-light);
  color: var(--ds-primary-dark);
}

/* 已到预约时段、还没开始使用 */
.status.ready {
  background-color: var(--ds-primary);
  color: #fff;
}

/* 时段已过且从未开始使用 */
.status.expired {
  background-color: var(--ds-border);
  color: var(--ds-text);
}

/* 预约状态说明：已到时段 / 已过期时给一句解释 */
.item-tip {
  margin: -8rpx 0 16rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
  line-height: 1.5;
}

/* 卡片底部操作区（目前只有「取消预约」） */
.item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ds-divider);
}

.cancel-btn {
  height: 64rpx;
  line-height: 62rpx;
  padding: 0 32rpx;
  border: 1rpx solid var(--ds-border);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--ds-text-secondary);
}

.cancel-btn-hover {
  background-color: var(--ds-danger-light);
  border-color: var(--ds-danger);
  color: var(--ds-danger);
}

.cancel-btn.is-busy {
  opacity: 0.5;
}

.status.cancelled {
  background-color: var(--ds-fill);
  color: var(--ds-text-muted);
}

.status.rejected {
  background-color: var(--ds-danger-light);
  color: var(--ds-danger);
}

.status.abnormal {
  background-color: var(--ds-danger-light);
  color: var(--ds-danger);
}

.status.using {
  background-color: #fff3cd;
  color: #856404;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
  color: var(--ds-primary);
  font-size: 26rpx;
}

.item-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-row {
  display: flex;
  align-items: center;
  min-height: 40rpx;
}

.item-label {
  font-size: 26rpx;
  color: #666;
  min-width: 160rpx;
  flex-shrink: 0;
}

.item-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
  min-height: 40rpx;
  line-height: 40rpx;
}
