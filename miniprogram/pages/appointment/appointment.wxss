.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tabs {
  display: flex;
  background-color: white;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-active {
  color: #07c160;
  font-weight: bold;
  border-bottom: 4rpx solid #07c160;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
  color: #666;
  font-size: 28rpx;
}

.empty {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}

.history-list {
  padding: 20rpx;
}

.history-item {
  background-color: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.device-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
  margin-left: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.status.approved {
  background-color: #d4edda;
  color: #155724;
}

.status.effective {
  background-color: #d4edda;
  color: #155724;
}

.status.inactive {
  background-color: #f1f3f5;
  color: #6c757d;
}

.status.pending {
  background-color: #fff3cd;
  color: #856404;
}

.status.completed {
  background-color: #d1edff;
  color: #0c5460;
}

.status.using {
  background-color: #fff3cd;
  color: #856404;
}

.item-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-row {
  display: flex;
  align-items: center;
  min-height: 40rpx;
}

.item-label {
  font-size: 26rpx;
  color: #666;
  min-width: 160rpx;
  flex-shrink: 0;
}

.item-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
  min-height: 40rpx;
  line-height: 40rpx;
}
