<view class="container">
  <!-- 主标签：预约记录 / 使用记录 -->
  <view class="tabs">
    <view
      class="tab {{activeTab === 'reservation' ? 'tab-active' : ''}}"
      data-tab="reservation"
      bindtap="switchTab"
    >
      预约记录
    </view>
    <view
      class="tab {{activeTab === 'usage' ? 'tab-active' : ''}}"
      data-tab="usage"
      bindtap="switchTab"
    >
      使用记录
    </view>
  </view>

  <!-- 预约记录的状态筛选（与工作台「使用概览」对齐） -->
  <view wx:if="{{activeTab === 'reservation'}}" class="filter-tabs">
    <view class="filter-tab {{reservationFilter === 'all' ? 'filter-active' : ''}}" data-filter="all" bindtap="switchReservationFilter">全部</view>
    <view class="filter-tab {{reservationFilter === 'upcoming' ? 'filter-active' : ''}}" data-filter="upcoming" bindtap="switchReservationFilter">待开始</view>
    <view class="filter-tab {{reservationFilter === 'effective' ? 'filter-active' : ''}}" data-filter="effective" bindtap="switchReservationFilter">已生效</view>
    <view class="filter-tab {{reservationFilter === 'cancelled' ? 'filter-active' : ''}}" data-filter="cancelled" bindtap="switchReservationFilter">已取消</view>
  </view>

  <!-- 使用记录的状态筛选 -->
  <view wx:if="{{activeTab === 'usage'}}" class="filter-tabs">
    <view class="filter-tab {{usageFilter === 'all' ? 'filter-active' : ''}}" data-filter="all" bindtap="switchUsageFilter">全部</view>
    <view class="filter-tab {{usageFilter === 'completed' ? 'filter-active' : ''}}" data-filter="completed" bindtap="switchUsageFilter">已完成</view>
    <view class="filter-tab {{usageFilter === 'abnormal' ? 'filter-active' : ''}}" data-filter="abnormal" bindtap="switchUsageFilter">异常</view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 预约历史 -->
  <view wx:if="{{activeTab === 'reservation' && !isLoading}}" class="history-list">
    <view wx:if="{{reservationHistory.length === 0}}" class="empty">
      <text>{{reservationFilter === 'upcoming' ? '暂无待开始的预约' : '暂无预约记录'}}</text>
    </view>

    <view
      class="history-item"
      wx:for="{{reservationHistory}}"
      wx:key="_id"
      wx:for-index="index"
      data-index="{{index}}"
      bindtap="viewReservationDetail"
    >
      <view class="item-header">
        <text class="device-name">{{item.device_name}}</text>
        <text class="status {{item.status_class}}">{{item.status_display}}</text>
      </view>
      <view class="item-content">
        <view class="item-row">
          <text class="item-label">仪器编号：</text>
          <text class="item-value">{{item.device_id}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">预约日期：</text>
          <text class="item-value">{{item.reserve_date}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">预约时段：</text>
          <text class="item-value">{{item.start_time_display}} - {{item.end_time_display}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">提交时间：</text>
          <text class="item-value">{{item.formatted_create_time}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{reservationHasMore}}" class="load-more" bindtap="loadMore">
      <text>{{isLoadingMore ? '加载中...' : '加载更多'}}</text>
    </view>
  </view>

  <!-- 使用历史 -->
  <view wx:if="{{activeTab === 'usage' && !isLoading}}" class="history-list">
    <view wx:if="{{usageHistory.length === 0}}" class="empty">
      <text>{{usageFilter === 'abnormal' ? '暂无异常使用记录' : (usageFilter === 'completed' ? '暂无已完成记录' : '暂无使用记录')}}</text>
    </view>

    <view
      class="history-item"
      wx:for="{{usageHistory}}"
      wx:key="_id"
      wx:for-index="index"
      data-index="{{index}}"
      bindtap="viewUsageDetail"
    >
      <view class="item-header">
        <text class="device-name">{{item.device_name}}</text>
        <text class="status {{item.status_class}}">{{item.status_display}}</text>
      </view>
      <view class="item-content">
        <view class="item-row">
          <text class="item-label">仪器编号：</text>
          <text class="item-value">{{item.device_id}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">使用日期：</text>
          <text class="item-value">{{item.usage_date_display}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">使用时段：</text>
          <text class="item-value">{{item.usage_period_display}}</text>
        </view>
        <view class="item-row" wx:if="{{item.usage_images && item.usage_images.length > 0}}">
          <text class="item-label">使用照片：</text>
          <text class="item-value">{{item.usage_images.length}}张</text>
        </view>
      </view>
    </view>

    <view wx:if="{{usageHasMore}}" class="load-more" bindtap="loadMore">
      <text>{{isLoadingMore ? '加载中...' : '加载更多'}}</text>
    </view>
  </view>
</view>
