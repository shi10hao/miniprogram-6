<view class="container">
  <!-- 主标签：预约记录 / 使用记录 -->
  <view class="tabs">
    <view
      class="tab {{activeTab === 'reservation' ? 'tab-active' : ''}}"
      data-tab="reservation"
      bindtap="switchTab"
    >
      预约记录
    </view>
    <view
      class="tab {{activeTab === 'usage' ? 'tab-active' : ''}}"
      data-tab="usage"
      bindtap="switchTab"
    >
      使用记录
    </view>
  </view>

  <!-- 预约记录的状态筛选（与工作台「使用概览」对齐） -->
  <view wx:if="{{activeTab === 'reservation' && !needLogin}}" class="filter-tabs">
    <view
      wx:for="{{reservationFilters}}"
      wx:key="key"
      class="filter-tab {{reservationFilter === item.key ? 'filter-active' : ''}}"
      data-filter="{{item.key}}"
      bindtap="switchReservationFilter"
    >{{item.label}}</view>
  </view>

  <!-- 使用记录的状态筛选 -->
  <view wx:if="{{activeTab === 'usage' && !needLogin}}" class="filter-tabs">
    <view
      wx:for="{{usageFilters}}"
      wx:key="key"
      class="filter-tab {{usageFilter === item.key ? 'filter-active' : ''}}"
      data-filter="{{item.key}}"
      bindtap="switchUsageFilter"
    >{{item.label}}</view>
  </view>

  <!-- 未登录 -->
  <view wx:if="{{needLogin && !isLoading}}" class="empty">
    <text>登录后可查看你的预约与使用记录</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 预约历史 -->
  <view wx:if="{{!needLogin && activeTab === 'reservation' && !isLoading}}" class="history-list">
    <view wx:if="{{reservationHistory.length === 0}}" class="empty">
      <text>{{reservationEmptyText}}</text>
    </view>

    <view
      class="history-item"
      wx:for="{{reservationHistory}}"
      wx:key="_id"
      wx:for-index="index"
      data-index="{{index}}"
      bindtap="viewReservationDetail"
    >
      <view class="item-header">
        <text class="device-name">{{item.device_name}}</text>
        <text class="status {{item.status_class}}">{{item.status_display}}</text>
      </view>

      <view wx:if="{{item.time_hint}}" class="item-tip">{{item.time_hint}}</view>

      <view class="item-content">
        <view class="item-row">
          <text class="item-label">仪器编号：</text>
          <text class="item-value">{{item.device_id}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">预约日期：</text>
          <text class="item-value">{{item.reserve_date}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">预约时段：</text>
          <text class="item-value">{{item.start_time_display}} - {{item.end_time_display}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">提交时间：</text>
          <text class="item-value">{{item.formatted_create_time}}</text>
        </view>
        <view wx:if="{{item.can_cancel}}" class="item-actions">
          <view
            class="cancel-btn {{cancellingId === item._id ? 'is-busy' : ''}}"
            hover-class="cancel-btn-hover"
            hover-stay-time="80"
            data-id="{{item._id}}"
            catchtap="onCancelReservation"
          >{{cancellingId === item._id ? '取消中...' : '取消预约'}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{reservationHasMore}}" class="load-more" bindtap="loadMore">
      <text>{{isLoadingMore ? '加载中...' : '加载更多'}}</text>
    </view>
  </view>

  <!-- 使用历史 -->
  <view wx:if="{{!needLogin && activeTab === 'usage' && !isLoading}}" class="history-list">
    <view wx:if="{{usageHistory.length === 0}}" class="empty">
      <text>{{usageEmptyText}}</text>
    </view>

    <view
      class="history-item"
      wx:for="{{usageHistory}}"
      wx:key="_id"
      wx:for-index="index"
      data-index="{{index}}"
      bindtap="viewUsageDetail"
    >
      <view class="item-header">
        <text class="device-name">{{item.device_name}}</text>
        <text class="status {{item.status_class}}">{{item.status_display}}</text>
      </view>
      <view class="item-content">
        <view class="item-row">
          <text class="item-label">仪器编号：</text>
          <text class="item-value">{{item.device_id}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">使用日期：</text>
          <text class="item-value">{{item.usage_date_display}}</text>
        </view>
        <view class="item-row">
          <text class="item-label">使用时段：</text>
          <text class="item-value">{{item.usage_period_display}}</text>
        </view>
        <view class="item-row" wx:if="{{item.image_count > 0}}">
          <text class="item-label">使用照片：</text>
          <text class="item-value">{{item.image_count}}张</text>
        </view>
      </view>
    </view>

    <view wx:if="{{usageHasMore}}" class="load-more" bindtap="loadMore">
      <text>{{isLoadingMore ? '加载中...' : '加载更多'}}</text>
    </view>
  </view>
</view>
