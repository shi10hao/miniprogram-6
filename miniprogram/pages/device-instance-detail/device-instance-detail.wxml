<!-- pages/device-instance-detail/device-instance-detail.wxml -->
<view class="container">

  <!-- ===== 顶部 Header ===== -->
  <view class="header">
    <text class="device-name">{{deviceInstanceInfo.device_name || ''}}</text>
    <view class="header-meta">
      <text class="meta-item">📍 {{deviceInstanceInfo.lab_name || ''}} · {{deviceInstanceInfo.device_room || ''}}</text>
      <view class="status-badge {{deviceInstanceInfo.displayStatus}}">
        {{deviceInstanceInfo.displayStatus === 'available' ? '可用' : deviceInstanceInfo.displayStatus === 'using' ? '使用中' : '维护中'}}
      </view>
    </view>
    <view class="header-device-id">
      <text class="meta-item">设备编号：{{deviceInstanceInfo.device_id || ''}}</text>
    </view>
  </view>

  <!-- ===== 加载中 ===== -->
  <view wx:if="{{isLoading}}" class="center-hint">
    <view class="loading-spin"></view>
    <text>加载中...</text>
  </view>

  <!-- ===== 主体内容 ===== -->
  <view wx:else class="content">

    <!-- ===== 1. 今日时间轴（核心功能） ===== -->
    <view class="section">
      <view class="section-title-wrap" bindtap="toggleSection" data-section="timeline">
        <text class="section-title">📊 今日时间轴</text>
        <text class="section-arrow {{sectionCollapsed.timeline ? 'collapsed' : ''}}">▼</text>
      </view>

      <view wx:if="{{!sectionCollapsed.timeline}}">
        <view wx:if="{{timelineItems.length === 0}}" class="empty-hint">今日暂无使用记录</view>
        <view wx:else class="timeline">
          <view class="timeline-item" wx:for="{{timelineItems}}" wx:key="index">
            <!-- 时间轴左侧：时间标记 -->
            <view class="timeline-left">
              <view class="timeline-dot {{item.type}}"></view>
              <view class="timeline-line" wx:if="{{index < timelineItems.length - 1}}"></view>
            </view>
            <!-- 时间轴右侧：内容卡片 -->
            <view class="timeline-right {{item.type}}">
              <view class="timeline-time">{{item.timeRange}}</view>
              <view class="timeline-content">
                <text wx:if="{{item.type === 'usage'}}" class="timeline-user">{{item.userName}}</text>
                <text wx:if="{{item.type === 'reserve'}}" class="timeline-user">{{item.userName}}（预约）</text>
                <text wx:if="{{item.type === 'idle'}}" class="timeline-idle-text">空闲</text>
                <text wx:if="{{item.duration}}" class="timeline-duration">{{item.duration}}</text>
              </view>
              <view wx:if="{{item.abnormal}}" class="timeline-abnormal">⚠️ 异常反馈</view>
            </view>
          </view>
        </view>

        <!-- 今日统计 -->
        <view wx:if="{{timelineItems.length > 0}}" class="timeline-stats">
          <text class="stat-item">使用时长：{{todayStats.usageDuration}}</text>
          <text class="stat-item">空闲时长：{{todayStats.idleDuration}}</text>
          <text class="stat-item">利用率：{{todayStats.usageRate}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 2. 近期使用记录 ===== -->
    <view class="section">
      <view class="section-title-wrap" bindtap="toggleSection" data-section="usages">
        <text class="section-title">📋 近期使用记录</text>
        <text class="section-arrow {{sectionCollapsed.usages ? 'collapsed' : ''}}">▼</text>
      </view>

      <view wx:if="{{!sectionCollapsed.usages}}">
        <view wx:if="{{usages.length === 0}}" class="empty-hint">暂无使用记录</view>
        <view wx:else class="usage-list">
          <view class="usage-item" wx:for="{{usages}}" wx:for-item="usage" wx:key="_id">
            <view class="usage-header">
              <text class="user-name">{{usage.student_name || usage.user_id || '未知用户'}}</text>
              <text class="duration">{{usage.durationDisplay || ''}}</text>
            </view>
            <text class="usage-time">{{usage.timeDisplay || ''}}</text>
            <view wx:if="{{usage.status === 'abnormal'}}" class="abnormal-badge">
              ⚠️ 异常反馈：{{usage.feedback ? usage.feedback.content : '未记录'}}
            </view>
            <!-- 照片 -->
            <view wx:if="{{usage.hasAnyPhoto}}" class="photo-section">
              <text class="photo-label">使用照片</text>
              <view class="photo-grid">
                <view class="photo-item" wx:for="{{usage.allPhotoUrls}}" wx:for-item="photo" wx:key="*this">
                  <image class="usage-photo" src="{{photo}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{photo}}" data-urls="{{usage.allPhotoUrls}}"></image>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 3. 即将到来的预约 ===== -->
    <view class="section">
      <view class="section-title-wrap" bindtap="toggleSection" data-section="reserves">
        <text class="section-title">📅 即将到来的预约</text>
        <text class="section-arrow {{sectionCollapsed.reserves ? 'collapsed' : ''}}">▼</text>
      </view>

      <view wx:if="{{!sectionCollapsed.reserves}}">
        <view wx:if="{{reserves.length === 0}}" class="empty-hint">暂无即将到来的预约</view>
        <view wx:else class="reserve-list">
          <view class="reserve-item" wx:for="{{reserves}}" wx:for-item="reserve" wx:key="_id">
            <view class="reserve-header">
              <text class="user-name">{{reserve.student_name || reserve.user_id || '未知用户'}}</text>
              <view class="reserve-status {{reserve.displayStatus}}">{{reserve.statusText}}</view>
            </view>
            <text class="reserve-date">{{reserve.dateDisplay || ''}}</text>
            <text class="reserve-time">{{reserve.timeDisplay || ''}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 4. 仪器信息（可编辑） ===== -->
    <view class="section">
      <view class="section-title-wrap" bindtap="toggleSection" data-section="info">
        <text class="section-title">ℹ️ 仪器信息</text>
        <text class="section-arrow {{sectionCollapsed.info ? 'collapsed' : ''}}">▼</text>
      </view>

      <view wx:if="{{!sectionCollapsed.info}}">
        <view wx:if="{{!isEditing}}">
          <!-- 查看模式 -->
          <view class="info-card-body">
            <view wx:if="{{deviceInstanceInfo.picture}}" class="info-image-wrap">
              <image class="info-image" src="{{deviceInstanceInfo.picture}}" mode="aspectFill"></image>
            </view>
            <view class="info-fields">
              <view class="info-field" wx:if="{{deviceInstanceInfo.description}}">
                <text class="info-label">简介</text>
                <text class="info-text">{{deviceInstanceInfo.description}}</text>
              </view>
              <view class="info-field" wx:if="{{deviceInstanceInfo.specifications && Object.keys(deviceInstanceInfo.specifications).length > 0}}">
                <text class="info-label">规格参数</text>
                <text class="info-text" wx:for="{{Object.entries(deviceInstanceInfo.specifications)}}" wx:for-item="spec" wx:key="0">{{spec[0]}}：{{spec[1]}}</text>
              </view>
              <view class="info-field" wx:if="{{deviceInstanceInfo.video_url}}">
                <text class="info-label">操作视频</text>
                <text class="info-text link" bindtap="playVideo">点击播放 ▶️</text>
              </view>
            </view>
          </view>
          <button class="info-edit-btn" bindtap="toggleEdit">✏️ 编辑</button>
        </view>

        <view wx:else>
          <!-- 编辑模式（复用现有逻辑） -->
          <view class="info-card-body edit-mode">
            <view class="edit-field">
              <text class="edit-label">设备名称</text>
              <input class="edit-input" value="{{editForm.device_name}}" bindinput="onEditInput" data-field="device_name" placeholder="请输入设备名称" />
            </view>
            <view class="edit-field">
              <text class="edit-label">简介</text>
              <textarea class="edit-textarea" value="{{editForm.description}}" bindinput="onEditInput" data-field="description" placeholder="请输入设备简介" maxlength="500"></textarea>
            </view>
            <view class="edit-field">
              <text class="edit-label">规格参数（每行一个，格式：参数名：参数值）</text>
              <textarea class="edit-textarea" value="{{editForm.specifications}}" bindinput="onEditInput" data-field="specifications" placeholder="型号：ABC-123&#10;功率：500W&#10;精度：0.01mm"></textarea>
            </view>
            <view class="edit-field">
              <text class="edit-label">操作规程</text>
              <textarea class="edit-textarea" value="{{editForm.operation_procedure}}" bindinput="onEditInput" data-field="operation_procedure" placeholder="请输入操作规程"></textarea>
            </view>
            <view class="edit-field">
              <text class="edit-label">注意事项</text>
              <textarea class="edit-textarea" value="{{editForm.precautions}}" bindinput="onEditInput" data-field="precautions" placeholder="请输入注意事项"></textarea>
            </view>
            <view class="edit-field">
              <text class="edit-label">设备图片</text>
              <view class="edit-image-row" bindtap="chooseImage">
                <image wx:if="{{hasNewPicture}}" class="edit-image" src="{{newPictureUrl}}" mode="aspectFill"></image>
                <image wx:else class="edit-image" src="/images/default-device.png" mode="aspectFill"></image>
                <text class="edit-image-hint">{{hasNewPicture ? '已选择新图片' : '点击更换图片'}}</text>
              </view>
            </view>
            <view class="edit-field">
              <text class="edit-label">操作视频</text>
              <view class="edit-video-row" bindtap="chooseVideo">
                <text class="edit-video-btn">选择视频</text>
                <text class="edit-video-name">{{hasNewVideo ? newVideoName : (deviceInfo.video_url ? '已上传视频' : '未选择')}}</text>
              </view>
            </view>
          </view>
          <button class="save-btn" bindtap="saveDeviceInfo" disabled="{{isSaving}}">{{isSaving ? '保存中...' : '💾 保存'}}</button>
          <button class="info-edit-btn cancel" bindtap="toggleEdit">取消编辑</button>
        </view>
      </view>
    </view>

  </view>
</view>