<!-- pages/device-instance-detail/device-instance-detail.wxml -->
<view class="container">

  <!-- ===== 顶部 Header ===== -->
  <view class="header">
    <text class="device-name">{{deviceInstanceInfo.device_name || ''}}</text>
    <view class="header-meta">
      <text class="meta-item">📍 {{deviceInstanceInfo.lab_name || ''}} · {{deviceInstanceInfo.device_room || ''}}</text>
      <view class="status-badge {{deviceInstanceInfo.displayStatus}}">
        {{deviceInstanceInfo.displayStatus === 'available' ? '可用' : deviceInstanceInfo.displayStatus === 'using' ? '使用中' : '维护中'}}
      </view>
    </view>
    <view class="header-device-id">
      <text class="meta-item">设备编号：{{deviceInstanceInfo.device_id || ''}}</text>
    </view>
  </view>

  <!-- ===== 加载中 ===== -->
  <view wx:if="{{isLoading}}" class="center-hint">
    <view class="loading-spin"></view>
    <text>加载中...</text>
  </view>

  <!-- ===== 主体内容 ===== -->
  <view wx:else class="content">

    <!-- ===== 1. 今日时间轴（核心功能） ===== -->
    <view class="section">
      <view class="section-title-wrap" bindtap="toggleSection" data-section="timeline">
        <text class="section-title">📊 今日时间轴</text>
        <text class="section-arrow {{sectionCollapsed.timeline ? 'collapsed' : ''}}">▼</text>
      </view>

      <view wx:if="{{!sectionCollapsed.timeline}}">
        <view wx:if="{{timelineItems.length === 0}}" class="empty-hint">今日暂无使用记录</view>
        <view wx:else class="timeline">
          <view class="timeline-item" wx:for="{{timelineItems}}" wx:key="index">
            <!-- 时间轴左侧：时间标记 -->
            <view class="timeline-left">
              <view class="timeline-dot {{item.type}}"></view>
              <view class="timeline-line" wx:if="{{index < timelineItems.length - 1}}"></view>
            </view>
            <!-- 时间轴右侧：内容卡片 -->
            <view class="timeline-right {{item.type}}">
              <view class="timeline-time">{{item.timeRange}}</view>
              <view class="timeline-content">
                <text wx:if="{{item.type === 'usage'}}" class="timeline-user">{{item.userName}}</text>
                <text wx:if="{{item.type === 'reserve'}}" class="timeline-user">{{item.userName}}（预约）</text>
                <text wx:if="{{item.type === 'idle'}}" class="timeline-idle-text">空闲</text>
                <text wx:if="{{item.duration}}" class="timeline-duration">{{item.duration}}</text>
              </view>
              <view wx:if="{{item.abnormal}}" class="timeline-abnormal">⚠️ 异常反馈</view>
            </view>
          </view>
        </view>

        <!-- 今日统计 -->
        <view wx:if="{{timelineItems.length > 0}}" class="timeline-stats">
          <text class="stat-item">使用时长：{{todayStats.usageDuration}}</text>
          <text class="stat-item">空闲时长：{{todayStats.idleDuration}}</text>
          <text class="stat-item">利用率：{{todayStats.usageRate}}</text>
        </view>
      </view>
    </view>
  </view>
</view>