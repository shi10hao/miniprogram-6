.container {
  min-height: 100vh;
  background: #f0f4f8;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #2d6a6e, #62BCC4);
  padding: 48rpx 40rpx 36rpx;
}

.device-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

.center-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
  color: #aaa;
  font-size: 26rpx;
}

.loading-spin {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #62BCC4;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.content {
  padding: 24rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.empty-hint {
  text-align: center;
  color: #aaa;
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* 仪器实例 */
.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-item {
  padding: 20rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  border: 1rpx solid #e8ecf0;
}

.device-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.device-id {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.status-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-badge.available { background: #e8f5e9; color: #2e7d32; }
.status-badge.using { background: #fff8e1; color: #f57c00; }
.status-badge.maintenance { background: #fce4ec; color: #c62828; }

.maint-btn {
  width: 100%;
  height: 64rpx;
  background: white;
  color: #666;
  font-size: 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.maint-btn.active {
  background: #62BCC4;
  color: white;
  border-color: #62BCC4;
}

/* 使用情况 */
.usage-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.usage-item {
  padding: 24rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  border: 1rpx solid #e8ecf0;
}

.usage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.duration {
  font-size: 22rpx;
  color: #f57c00;
  font-weight: 500;
}

.device-id-small {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.photo-section {
  margin-top: 16rpx;
}

.photo-label {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.usage-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #eee;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-item {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.photo-tip {
  width: 100%;
  font-size: 20rpx;
  color: #666;
  line-height: 1.4;
  text-align: center;
  word-break: break-all;
}

/* 预约情况 */
.reserve-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reserve-item {
  padding: 20rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  border: 1rpx solid #e8ecf0;
}

.reserve-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.reserve-date {
  font-size: 22rpx;
  color: #666;
}

.reserve-time {
  display: block;
  font-size: 24rpx;
  color: #62BCC4;
  font-weight: 500;
  margin-bottom: 8rpx;
}

/* 仪器信息卡片 */
.info-card {
  background: white;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.info-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.info-edit-btn {
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: white;
  background: #62BCC4;
  border: none;
  border-radius: 28rpx;
  padding: 0 24rpx;
  margin: 0;
}

.info-edit-btn::after {
  border: none;
}

.info-card-body {
  display: flex;
  gap: 24rpx;
}

.info-image-wrap {
  flex-shrink: 0;
}

.info-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background: #f0f0f0;
}

.info-fields {
  flex: 1;
  min-width: 0;
}

.info-field {
  margin-bottom: 16rpx;
}

.info-field:last-child {
  margin-bottom: 0;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.info-text {
  display: block;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

/* 编辑模式 */
.info-card-body.edit-mode {
  flex-direction: column;
}

.edit-field {
  margin-bottom: 28rpx;
}

.edit-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.edit-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #e8ecf0;
  box-sizing: border-box;
  line-height: 1.6;
}

.edit-hint {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

/* 图片选择 */
.edit-image-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  border: 1rpx solid #e8ecf0;
}

.edit-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #e0e0e0;
  flex-shrink: 0;
}

.edit-image-hint {
  font-size: 24rpx;
  color: #62BCC4;
}

/* 视频选择 */
.edit-video-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  border: 1rpx solid #e8ecf0;
}

.edit-video-btn {
  font-size: 26rpx;
  color: #62BCC4;
  font-weight: 500;
}

.edit-video-name {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #62BCC4, #4da9b1);
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-top: 8rpx;
}

.save-btn[disabled] {
  background: #a8d8dc;
  color: white;
}

/* 取消编辑按钮变灰 */
.info-edit-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

/* ===== 第4步：微调 ===== */

/* 内容区与信息卡片之间留一点间距 */
.content {
  padding-top: 24rpx;
}

/* 信息卡片底部与内容区衔接 */
.info-card {
  margin-bottom: 0;
}

/* 编辑文本输入框获得焦点时的边框高亮 */
.edit-textarea:focus {
  border-color: #62BCC4;
}

/* 已选图片/视频的预览提示 */
.edit-image-hint,
.edit-video-btn {
  color: #62BCC4;
}

/* 保存按钮禁用状态的样式 */
.save-btn[disabled] {
  background: #a8d8dc;
  color: rgba(255,255,255,0.8);
}

/* 当编辑模式开启时，顶部按钮的文字微调 */
.info-edit-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.edit-input {
  width: 100%;
  height: 72rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #e8ecf0;
  box-sizing: border-box;
}

.edit-input:focus {
  border-color: #62BCC4;
}

/* 区域折叠 */
.section-title-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 24rpx;
}

.section-title-wrap .section-title {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.section-arrow {
  font-size: 28rpx;
  color: #bbb;
  transition: transform 0.2s;
}

.section-arrow.collapsed {
  transform: rotate(-90deg);
}

/* 展开全部 */
.expand-wrap {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 0;
}

.expand-btn {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #62BCC4;
  background: #f0f8f9;
  border: none;
  border-radius: 32rpx;
  padding: 0 32rpx;
}

.expand-btn::after {
  border: none;
}

.filter-badge {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  align-self: flex-start;
}

.filter-badge-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}

.fold-wrap {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 0;
}

.fold-btn {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #62BCC4;
  background: #f0f8f9;
  border: none;
  border-radius: 32rpx;
  padding: 0 32rpx;
}

.reserve-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  line-height: 1.2;
}
.reserve-status.upcoming {
  color: #1677ff;
  background: #e6f4ff;
}
.reserve-status.overdue_start {
  color: #cf1322;
  background: #fff1f0;
  font-weight: 500;
}

/* 单台设备双按钮行 */
.device-btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.maint-btn.small {
  flex: 1;
  margin: 0;
}
.delete-instance-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  background: #fff;
  color: #cf1322;
  font-size: 24rpx;
  border: 1rpx solid #ffccc7;
  border-radius: 8rpx;
  margin: 0;
}
.delete-instance-btn[disabled] {
  color: #ccc;
  border-color: #eee;
  background: #f5f5f5;
}
.delete-instance-btn::after {
  border: none;
}

/* 新增输入区 */
.add-instance-wrap {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e8ecf0;
}
.add-instance-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #f7f9fc;
  border: 1rpx solid #e8ecf0;
  border-radius: 8rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}
.add-instance-btn {
  width: 140rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #62BCC4;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: none;
  margin: 0;
}
.add-instance-btn[disabled] {
  background: #a8d8dc;
  color: rgba(255,255,255,0.8);
}
.add-instance-btn::after {
  border: none;
}
/* ===== 时间轴样式 ===== */
.timeline {
  position: relative;
  padding-left: 30rpx;
}

.timeline-item {
  display: flex;
  position: relative;
  min-height: 80rpx;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 30rpx;
  flex-shrink: 0;
  position: relative;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  z-index: 1;
}

.timeline-dot.usage {
  background: #62BCC4;
}

.timeline-dot.reserve {
  background: #1677ff;
  border: 2rpx solid #1677ff;
  background: white;
}

.timeline-dot.idle {
  background: #ddd;
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  background: #e0e0e0;
  position: absolute;
  top: 24rpx;
  left: 13rpx;
}

.timeline-right {
  flex: 1;
  padding: 0 0 24rpx 20rpx;
}

.timeline-right.usage {
  /* 使用记录无特殊背景 */
}

.timeline-right.reserve {
  opacity: 0.85;
}

.timeline-right.idle {
  opacity: 0.6;
}

.timeline-time {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.timeline-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.timeline-user {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.timeline-idle-text {
  font-size: 24rpx;
  color: #bbb;
  font-style: italic;
}

.timeline-duration {
  font-size: 22rpx;
  color: #f57c00;
}

.timeline-abnormal {
  font-size: 22rpx;
  color: #cf1322;
  margin-top: 4rpx;
}

/* 今日统计 */
.timeline-stats {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  font-size: 24rpx;
  color: #666;
}

/* 使用时间显示 */
.usage-time {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}

/* 异常标记 */
.abnormal-badge {
  font-size: 22rpx;
  color: #cf1322;
  background: #fff1f0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

/* 头部扩展 */
.header-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.device-model {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 6rpx;
}

.header-device-id {
  margin-top: 8rpx;
}

/* 链接样式 */
.link {
  color: #62BCC4;
  text-decoration: underline;
}