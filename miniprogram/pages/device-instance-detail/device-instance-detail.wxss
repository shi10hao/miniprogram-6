/* 设备实例详情 —— 颜色、圆角、阴影全部取自 app.wxss 的 --ds-* 变量 */

.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ==================== 顶部身份区 ==================== */

.hero {
  position: relative;
  padding: 40rpx 36rpx 104rpx;
  background: linear-gradient(160deg, var(--ds-primary-deep) 0%, var(--ds-primary-dark) 58%, var(--ds-primary) 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  top: -160rpx;
  right: -120rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-deco::after {
  content: '';
  position: absolute;
  left: -180rpx;
  bottom: -260rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
}

.hero-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--ds-surface);
  opacity: 0.85;
}

.hero-eyebrow-text {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--ds-surface);
  opacity: 0.86;
}

.hero-chip {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 22rpx;
  border-radius: var(--ds-radius-pill);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  color: var(--ds-surface);
}

.chip-available {
  background: rgba(16, 185, 129, 0.3);
  border-color: rgba(255, 255, 255, 0.42);
}

.chip-using {
  background: rgba(98, 188, 196, 0.46);
  border-color: rgba(255, 255, 255, 0.5);
}

.chip-maintenance {
  background: rgba(245, 158, 11, 0.34);
  border-color: rgba(255, 255, 255, 0.42);
}

.chip-none {
  background: rgba(255, 255, 255, 0.1);
}

.hero-title {
  position: relative;
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--ds-surface);
}

.hero-sub {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--ds-surface);
  opacity: 0.82;
}

.hero-sub-item {
  max-width: 46%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-sub-dot {
  margin: 0 12rpx;
  opacity: 0.6;
}

.hero-tags {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.hero-tag {
  margin: 0 12rpx 8rpx 0;
  padding: 4rpx 18rpx;
  border-radius: var(--ds-radius-sm);
  background: rgba(255, 255, 255, 0.14);
  font-size: 21rpx;
  color: var(--ds-surface);
  opacity: 0.9;
}

.hero-using {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--ds-radius);
  background: rgba(255, 255, 255, 0.16);
}

.hero-using-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: var(--ds-surface);
  animation: pulse 1.6s infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.35; }
  100% { opacity: 1; }
}

.hero-using-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.hero-using-name {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ds-surface);
}

.hero-using-detail {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ds-surface);
  opacity: 0.78;
}

/* ==================== 内容容器 ==================== */

.body {
  position: relative;
  margin: -76rpx 24rpx 0;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.card-hint {
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.head-right {
  display: flex;
  align-items: center;
}

.head-arrow {
  margin-left: 8rpx;
  font-size: 30rpx;
  color: var(--ds-text-muted);
  transform: rotate(90deg);
  transition: transform 0.2s;
}

.head-arrow.is-collapsed {
  transform: rotate(0deg);
}

/* 加载骨架 */

.sk-title {
  width: 46%;
  height: 34rpx;
}

.sk-line {
  width: 100%;
  height: 24rpx;
  margin-top: 20rpx;
}

.sk-line-short {
  width: 64%;
}

.sk-block {
  height: 132rpx;
  margin-top: 28rpx;
  border-radius: var(--ds-radius);
}

.empty-btn {
  width: 260rpx;
  margin: 32rpx auto 0;
}

/* ==================== 今日概览 ==================== */

.stat-grid {
  display: flex;
  padding: 24rpx 0;
  border-radius: var(--ds-radius);
  background: var(--ds-fill);
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.stat-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ds-text);
  text-align: center;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ds-text-muted);
}

.meter {
  margin-top: 26rpx;
}

.meter-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.meter-label {
  font-size: 23rpx;
  color: var(--ds-text-secondary);
}

.meter-value {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ds-primary-dark);
}

.meter-track {
  height: 12rpx;
  border-radius: 8rpx;
  background: var(--ds-fill);
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--ds-primary), var(--ds-primary-dark));
  transition: width 0.3s;
}

.strip-wrap {
  margin-top: 28rpx;
}

.strip {
  position: relative;
  height: 20rpx;
  border-radius: 10rpx;
  background: var(--ds-fill);
  overflow: hidden;
}

.strip-block {
  position: absolute;
  top: 0;
  bottom: 0;
  min-width: 4rpx;
  border-radius: 6rpx;
}

.strip-usage {
  background: var(--ds-primary);
}

.strip-reserve {
  background: var(--ds-warning);
}

/* 时间条上的「现在」刻度 */
.strip-now {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3rpx;
  margin-left: -1rpx;
  background: var(--ds-primary-deep);
}

.strip-axis {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.strip-legend {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 3rpx;
}

.legend-usage {
  background: var(--ds-primary);
}

.legend-reserve {
  background: var(--ds-warning);
}

.legend-text {
  font-size: 21rpx;
  color: var(--ds-text-secondary);
}

.legend-note {
  flex: 1;
  text-align: right;
  font-size: 21rpx;
  color: var(--ds-text-muted);
}

/* ==================== 时间轴 ==================== */

.empty-inline {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0 20rpx;
}

.empty-inline-icon {
  font-size: 44rpx;
}

.empty-inline-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.tl-row {
  display: flex;
  align-items: stretch;
}

.tl-time {
  flex-shrink: 0;
  width: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-top: 4rpx;
}

.tl-clock {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ds-text);
}

.tl-clock-end {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.tl-rail {
  position: relative;
  flex-shrink: 0;
  width: 24rpx;
  margin: 0 18rpx;
  display: flex;
  justify-content: center;
}

.tl-rail::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  margin-left: -1rpx;
  background: var(--ds-divider);
}

.tl-dot {
  position: relative;
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: var(--ds-primary);
  box-shadow: 0 0 0 6rpx var(--ds-primary-light);
}

.tl-row-reserve .tl-dot {
  background: var(--ds-warning);
  box-shadow: 0 0 0 6rpx var(--ds-warning-light);
}

.tl-row-idle .tl-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  background: var(--ds-border);
  box-shadow: none;
}

.tl-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 24rpx;
}

.tl-row:last-child .tl-body {
  padding-bottom: 4rpx;
}

.tl-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tl-title {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ds-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tl-duration {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--ds-text-secondary);
}

.tl-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tl-meta .ds-tag {
  flex-shrink: 0;
  margin-right: 10rpx;
}

.tl-sub {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ds-text-muted);
}

.tl-row-idle .tl-title {
  font-weight: 400;
  color: var(--ds-text-muted);
}

.tl-row-idle .tl-duration {
  font-size: 21rpx;
  color: var(--ds-text-disabled);
}

/* ==================== 使用记录 / 预约 ==================== */

.rec-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--ds-divider);
}

.rec-row:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.rec-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.rec-head {
  display: flex;
  align-items: center;
}

.rec-title {
  max-width: 62%;
  margin-right: 12rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ds-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rec-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ds-text-muted);
}

.rec-feedback {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ds-text-secondary);
}

.rec-duration {
  flex-shrink: 0;
  font-size: 23rpx;
  color: var(--ds-text-secondary);
}

/* ==================== 仪器信息 ==================== */

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.info-label {
  flex-shrink: 0;
  width: 170rpx;
  font-size: 25rpx;
  color: var(--ds-text-muted);
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--ds-text);
  text-align: right;
  word-break: break-all;
}

.info-desc {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-fill);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ds-text-secondary);
}

.block-label {
  margin-bottom: 10rpx;
  font-size: 23rpx;
  color: var(--ds-text-muted);
}

.spec-block {
  margin-top: 24rpx;
}

.spec-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-bottom: 2rpx solid var(--ds-divider);
}

.spec-row:last-child {
  border-bottom: none;
}

.spec-key {
  flex-shrink: 0;
  width: 200rpx;
  font-size: 24rpx;
  color: var(--ds-text-muted);
}

.spec-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ds-text);
  text-align: right;
  word-break: break-all;
}

/* 部分数据失败时的提示条，紧贴内容区顶部 */
.partial-tip {
  margin: 0 0 20rpx;
  padding: 14rpx 20rpx;
  border-radius: var(--ds-radius-sm);
  background: var(--ds-warning-light);
  font-size: 22rpx;
  color: var(--ds-warning);
}
