page {
  background-color: #f0f4f8;
}
.container {
  padding: 24rpx;
  min-height: 100vh;
}

.header-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.device-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  display:block;
  margin-bottom:12rpx;
}
.sub-tip {
  font-size:26rpx;
  color:#666;
}

.loading-wrap,.empty-wrap {
  padding:120rpx 0;
  text-align:center;
  color:#999;
  font-size:28rpx;
}

.user-card {
  background:#fff;
  border-radius:16rpx;
  padding:32rpx;
  margin-bottom:20rpx;
}
.row {
  display:flex;
  padding:12rpx 0;
}
.label {
  width:160rpx;
  font-size:28rpx;
  color:#666;
}
.val {
  flex:1;
  font-size:28rpx;
  color:#222;
}

.more-area{
  margin:60rpx 0 80rpx;
  text-align:center;
}
/* 替换原生button默认样式 */
.load-more-btn{
  width: auto;
  display: inline-block;
  background: transparent !important;
  border: none !important;
  color:#888888;
  font-size:28rpx;
  padding:0;
  margin:0;
  text-decoration: underline;
}
/* 清除button小程序默认边框伪元素 */
.load-more-btn::after{
  border:none;
}
.no-more-tip{
  font-size:26rpx;
  color:#999;
}