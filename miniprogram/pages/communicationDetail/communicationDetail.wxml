<view class="page">
  <view class="hero">
    <view class="hero-eyebrow">历史使用者</view>
    <view class="hero-title">{{deviceName || '仪器详情'}}</view>
    <view class="hero-desc">按最近使用时间排序，可直接联系他们请教</view>
  </view>

  <view class="body">
    <view class="notice">
      <text class="notice-dot"></text>
      <text class="notice-text">仅展示已完成的使用记录</text>
    </view>

    <view wx:if="{{!isLoading && !hasError && userList.length}}" class="sec-head">
      <text class="ds-section-title">使用过它的同学</text>
      <text class="sec-hint">已加载 {{userList.length}} 位</text>
    </view>

    <view wx:if="{{isLoading}}" class="list">
      <view wx:for="{{skeletonRows}}" wx:key="*this" class="ds-skeleton-card sk-card">
        <view class="ds-skeleton sk-avatar"></view>
        <view class="sk-main">
          <view class="ds-skeleton sk-line-lg"></view>
          <view class="ds-skeleton sk-line-sm"></view>
          <view class="ds-skeleton sk-line-sm"></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{hasError}}" class="state-card">
      <text class="state-icon">⚠️</text>
      <text class="state-title">{{errorText}}</text>
      <view class="ds-btn ds-btn-ghost retry-btn" bindtap="loadFirstPage">重新加载</view>
    </view>

    <view wx:elif="{{!userList.length}}" class="ds-empty">
      <text class="ds-empty-icon">🧑‍🔬</text>
      <text class="ds-empty-title">还没有人用过这台仪器</text>
      <text class="ds-empty-desc">等有同学完成使用后，这里会出现他们的联系方式</text>
    </view>

    <view wx:else class="list">
      <view class="user-card" wx:for="{{userList}}" wx:key="userId">
        <view class="user-head">
          <view class="avatar">{{item.avatarText}}</view>
          <view class="user-main">
            <view class="user-name-row">
              <text class="user-name">{{item.name}}</text>
              <text wx:if="{{item.groupName}}" class="ds-tag ds-tag-primary">{{item.groupName}}</text>
            </view>
            <text class="user-sub">最近使用：{{item.useTime}}</text>
          </view>
        </view>

        <view class="user-meta">
          <view class="meta-row">
            <text class="meta-label">学号</text>
            <text class="meta-val">{{item.studentId || '未填写'}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">手机号</text>
            <text class="meta-val">{{item.phone}}</text>
            <view wx:if="{{item.canCall}}" class="call-btn" catchtap="onCall" data-phone="{{item.phone}}">拨号</view>
          </view>
        </view>
      </view>

      <view class="more-area">
        <view wx:if="{{hasMore}}" class="ds-btn ds-btn-ghost load-more" bindtap="loadMore">{{btnLoading ? '加载中…' : '加载更多'}}</view>
        <text wx:else class="no-more">已显示全部使用者</text>
      </view>
    </view>
  </view>
</view>
