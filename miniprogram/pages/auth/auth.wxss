.auth-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #62BCC4 0%, #4aa8b0 100%);
  padding: 40rpx 30rpx;
  position: relative;
}

/* 微信登录弹框遮罩层 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-dialog {
  width: 600rpx;
  background: white;
  border-radius: 32rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  background: linear-gradient(135deg, #62BCC4, #4aa8b0);
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
}

.wechat-icon {
  width: 144rpx;
  height: 116rpx;
  margin: 0 auto 24rpx;
  position: relative;
}

.wechat-bubble {
  position: absolute;
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
}

.bubble-front {
  width: 92rpx;
  height: 92rpx;
  top: 0;
  right: 0;
  background: #ffffff;
}

.bubble-back {
  width: 76rpx;
  height: 76rpx;
  left: 12rpx;
  bottom: 6rpx;
  background: rgba(255, 255, 255, 0.82);
}

.bubble-front::after,
.bubble-back::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  background: inherit;
  border-radius: 4rpx;
  transform: rotate(28deg);
}

.bubble-front::after {
  left: 16rpx;
  bottom: 6rpx;
}

.bubble-back::after {
  right: 12rpx;
  bottom: 4rpx;
}

.bubble-dot {
  position: absolute;
  top: 38rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #62BCC4;
}

.bubble-back .bubble-dot {
  top: 30rpx;
}

.dot-left {
  left: 22rpx;
}

.dot-center {
  left: 40rpx;
}

.dot-right {
  left: 58rpx;
}

.bubble-back .dot-left {
  left: 16rpx;
}

.bubble-back .dot-center {
  left: 32rpx;
}

.bubble-back .dot-right {
  left: 48rpx;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 12rpx;
}

.modal-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.modal-body {
  padding: 48rpx 40rpx;
}

.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #62BCC4, #4aa8b0);
  color: white;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(98, 188, 196, 0.4);
}

.wechat-login-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  font-size: 32rpx;
}

.auth-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.auth-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.auth-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.form-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  border: 2rpx solid #e1e1e1;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: white;
  box-sizing: border-box;
}

.form-input.disabled {
  background: #f8f9fa;
  color: #666;
  border-color: #e9ecef;
}

.verify-button {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: #62BCC4;
  color: white;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.verify-button.verifying {
  background: #a0d8de;
}

.verify-button[disabled] {
  background: #cccccc;
}

.status-display {
  margin-top: 16rpx;
  min-height: 40rpx;
}

.status-success {
  color: #07c160;
  font-size: 26rpx;
}

.status-error {
  color: #ff6b6b;
  font-size: 26rpx;
}

.submit-button {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #68e9be;
  color: white;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(98, 188, 196, 0.3);
  margin-bottom: 40rpx;
}

.submit-button.disabled {
  background: #cccccc;
  box-shadow: none;
}

.info-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 40rpx;
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.info-item {
  font-size: 26rpx;
  color: #666;
  line-height: 44rpx;
  margin-bottom: 8rpx;
}

.admin-entry {
  text-align: center;
  padding: 32rpx 0;
}

.admin-button {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: transparent;
  color: white;
  border: 2rpx solid white;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.admin-button::after {
  border: none;
}
/* 新增隐私弹窗样式 */
.privacy-mask {
  position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);
  display:flex;align-items:center;justify-content:center;z-index:99999;
}
.privacy-box {
  width:620rpx;background:#fff;border-radius:24rpx;padding:40rpx;
}
.privacy-title {
  font-size:32rpx;font-weight:bold;text-align:center;margin-bottom:30rpx;
}
.privacy-content {
  font-size:28rpx;color:#555;line-height:48rpx;margin-bottom:30rpx;
}
.privacy-check {
  display:flex;align-items:center;margin-bottom:30rpx;font-size:28rpx;
}
.privacy-confirm-btn {
  background:#62BCC4;color:#fff;border-radius:12rpx;
}

/* ✅ 常驻隐私勾选区域 */
.privacy-static {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  padding: 20rpx 24rpx;
  background: #f7f9fb;
  border-radius: 12rpx;
  margin: 24rpx 0;
}

.privacy-text {
  color: #666;
}

.privacy-link {
  color: #007aff;
  margin: 0 4rpx;
}

.privacy-static checkbox-group {
  margin-right: 12rpx;
}

.goto-register-wrap {
  text-align: center;
  margin-bottom: 40rpx;
}
.goto-register-text {
  font-size: 28rpx;
  color: #ffffff;
}
.goto-register-link {
  font-size: 28rpx;
  color: #ffffff;
  text-decoration: underline;
  margin-left: 8rpx;
}

/* ==========注册弹窗样式 追加到wxss末尾========== */
.register-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
  animation: fadeIn 0.3s ease;
}

.register-box {
  width: 620rpx;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  animation: slideUp 0.3s ease;
  box-sizing: border-box;
}

.register-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 12rpx;
}

.register-desc {
  font-size: 24rpx;
  color:#777;
  text-align:center;
  margin-bottom:36rpx;
}

.register-form-item {
  margin-bottom:28rpx;
}

.register-label {
  display:block;
  font-size:28rpx;
  font-weight:600;
  color:#333;
  margin-bottom:12rpx;
}

.register-input {
  width:100%;
  height:72rpx;
  border:2rpx solid #e1e1e1;
  border-radius:12rpx;
  padding:0 24rpx;
  font-size:28rpx;
  box-sizing: border-box;
}

.register-btn-group {
  margin-top:40rpx;
  display:flex;
  gap:24rpx;
}

.register-confirm-btn {
  flex:1;
  height:84rpx;
  line-height:84rpx;
  background:#62BCC4;
  color:#fff;
  border-radius:12rpx;
  font-size:28rpx;
}

.register-cancel-btn {
  flex:1;
  height:84rpx;
  line-height:84rpx;
  background:#f2f3f5;
  color:#333;
  border-radius:12rpx;
  font-size:28rpx;
}

/* 去除button默认边框 */
.register-confirm-btn::after,
.register-cancel-btn::after {
  border:none;
}