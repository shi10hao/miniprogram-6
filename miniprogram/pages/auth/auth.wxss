/* ==================== 全局容器 ==================== */
.auth-container {
  min-height: 100vh;
  background: linear-gradient(160deg, #62BCC4 0%, #4aa8b0 40%, #3a9ca4 100%);
  padding: 40rpx 30rpx 60rpx;
  position: relative;
  box-sizing: border-box;
}

/* ==================== 头部 ==================== */
.auth-header {
  text-align: center;
  margin-bottom: 56rpx;
  padding-top: 20rpx;
}

.auth-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}

.auth-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 1rpx;
}

/* ==================== 登录卡片 ==================== */
.form-card {
  background: white;
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  margin-bottom: 36rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #444;
  margin-bottom: 14rpx;
  padding-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8eef0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f8fafb;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: #62BCC4;
  background: #fff;
}

/* ==================== 登录按钮 ==================== */
.verify-button {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #62BCC4, #4aa8b0);
  color: white;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(98, 188, 196, 0.35);
  letter-spacing: 4rpx;
}

.verify-button.verifying {
  background: linear-gradient(135deg, #a0d8de, #8ccbd2);
  box-shadow: none;
}

.verify-button[disabled] {
  background: #c8d6d8;
  box-shadow: none;
}

/* ==================== 错误提示 ==================== */
.status-display {
  margin-top: 20rpx;
  min-height: 40rpx;
  text-align: center;
}

.status-error {
  color: #ff6b6b;
  font-size: 26rpx;
}

/* ==================== 常驻隐私勾选 ==================== */
.privacy-static {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 14rpx;
  margin: 28rpx 0;
  backdrop-filter: blur(10rpx);
}

.privacy-text {
  color: rgba(255, 255, 255, 0.9);
}

.privacy-link {
  color: #ffffff;
  font-weight: 600;
  margin: 0 4rpx;
  text-decoration: underline;
}

.privacy-static checkbox-group {
  margin-right: 12rpx;
}

/* ==================== 说明卡片 ==================== */
.info-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  padding: 32rpx 32rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.info-item {
  font-size: 25rpx;
  color: #666;
  line-height: 44rpx;
}

/* ==================== 去注册 ==================== */
.goto-register-wrap {
  text-align: center;
  margin-bottom: 36rpx;
}

.goto-register-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.goto-register-link {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  text-decoration: underline;
  margin-left: 8rpx;
}

/* ==================== 管理员入口 ==================== */
.admin-entry {
  text-align: center;
  padding: 16rpx 0;
}

.admin-button {
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: transparent;
  color: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 36rpx;
  font-size: 26rpx;
}

.admin-button::after {
  border: none;
}

/* ==================== 隐私协议弹窗 ==================== */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
  animation: fadeIn 0.25s ease;
}

.privacy-box {
  width: 640rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  animation: slideUp 0.3s ease;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}

.privacy-content {
  font-size: 27rpx;
  color: #555;
  line-height: 52rpx;
  margin-bottom: 32rpx;
  padding: 20rpx 24rpx;
  background: #f8fafb;
  border-radius: 12rpx;
}

.privacy-check {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  font-size: 27rpx;
  color: #444;
}
.privacy-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

.privacy-confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #62BCC4, #4aa8b0);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(98, 188, 196, 0.35);
  margin-bottom: 0;
}

.privacy-confirm-btn:active {
  opacity: 0.85;
  box-shadow: 0 4rpx 12rpx rgba(98, 188, 196, 0.3);
}

.privacy-confirm-btn[disabled] {
  background: #d4e8ea;
  color: #aac4c7;
  box-shadow: none;
}

.privacy-cancel-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  color: #62BCC4;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 2rpx solid #62BCC4;
  margin-bottom: 0;
}

.privacy-cancel-btn:active {
  background: rgba(98, 188, 196, 0.08);
}

.privacy-link-inline {
  color: #62BCC4;
  font-weight: 500;
}

/* ==================== 注册弹窗 ==================== */
.register-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
  animation: fadeIn 0.25s ease;
}

.register-box {
  width: 640rpx;
  max-height: 88vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  animation: slideUp 0.3s ease;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
}

.register-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 12rpx;
  color: #333;
}

.register-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.register-form-item {
  margin-bottom: 28rpx;
  padding: 4rpx 0;
}

.register-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #444;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.register-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8eef0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.register-btn-group {
  margin-top: 44rpx;
  display: flex;
  gap: 24rpx;
}

.register-confirm-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #62BCC4, #4aa8b0);
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(98, 188, 196, 0.3);
}

.register-cancel-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  background: #f2f4f6;
  color: #666;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.register-confirm-btn::after,
.register-cancel-btn::after {
  border: none;
}

/* ==================== 初始密码提示弹窗 ==================== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
  animation: fadeIn 0.25s ease;
}

.modal-box {
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  animation: slideUp 0.3s ease;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
  color: #333;
}

.modal-content {
  font-size: 27rpx;
  color: #666;
  line-height: 48rpx;
  text-align: center;
  margin-bottom: 36rpx;
  padding: 20rpx 12rpx;
  background: #fff8f0;
  border-radius: 12rpx;
}

.modal-btn-group {
  display: flex;
  gap: 20rpx;
}

.modal-btn-group button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
}

.modal-btn-group button:first-child {
  background: linear-gradient(135deg, #62BCC4, #4aa8b0);
  color: #fff;
}

.modal-btn-group button:last-child {
  background: #f2f4f6;
  color: #666;
}

.modal-btn-group button::after {
  border: none;
}

/* ==================== 动画 ==================== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    transform: translateY(60rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}