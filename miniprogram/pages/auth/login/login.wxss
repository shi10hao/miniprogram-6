/* 遮罩层 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 弹框主体 */
.modal-dialog {
  width: 600rpx;
  background: white;
  border-radius: 32rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 头部 */
.modal-header {
  background: linear-gradient(135deg, #62BCC4, #4aa8b0);
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
  position: relative;
}

.wechat-icon {
  width: 144rpx;
  height: 116rpx;
  margin: 0 auto 24rpx;
  position: relative;
}

.wechat-bubble {
  position: absolute;
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
}

.bubble-front {
  width: 92rpx;
  height: 92rpx;
  top: 0;
  right: 0;
  background: #ffffff;
}

.bubble-back {
  width: 76rpx;
  height: 76rpx;
  left: 12rpx;
  bottom: 6rpx;
  background: rgba(255, 255, 255, 0.82);
}

.bubble-front::after,
.bubble-back::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  background: inherit;
  border-radius: 4rpx;
  transform: rotate(28deg);
}

.bubble-front::after {
  left: 16rpx;
  bottom: 6rpx;
}

.bubble-back::after {
  right: 12rpx;
  bottom: 4rpx;
}

.bubble-dot {
  position: absolute;
  top: 38rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #62BCC4;
}

.bubble-back .bubble-dot {
  top: 30rpx;
}

.dot-left {
  left: 22rpx;
}

.dot-center {
  left: 40rpx;
}

.dot-right {
  left: 58rpx;
}

.bubble-back .dot-left {
  left: 16rpx;
}

.bubble-back .dot-center {
  left: 32rpx;
}

.bubble-back .dot-right {
  left: 48rpx;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 12rpx;
}

.modal-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 内容区 */
.modal-body {
  padding: 48rpx 40rpx;
}

/* 微信登录按钮 */
.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #62BCC4, #4aa8b0);
  color: white;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(98, 188, 196, 0.4);
  margin-bottom: 24rpx;
}

.wechat-login-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  font-size: 32rpx;
}

/* 取消按钮 */
.cancel-btn {
  width: 100%;
  height: 88rpx;
  background: white;
  color: #999;
  border: 1rpx solid #e0e0e0;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.cancel-btn::after {
  border: none;
}
