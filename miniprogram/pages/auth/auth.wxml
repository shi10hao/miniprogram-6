<view wx:if="{{showPrivacyModal}}" class="privacy-mask" catch:tap="">
  <view class="privacy-box">
    <view class="privacy-title">用户协议与隐私政策</view>
    <view class="privacy-content">
      <text>为完成学生身份认证，本小程序需要收集您的学号、手机号、姓名、专业信息，仅用于校内身份核验，不会挪作其他用途。</text>
      <text style="color:#007aff;" bindtap="openPrivacyPage">《隐私政策》</text>
      <text>、</text>
      <text style="color:#007aff;" bindtap="openAgreementPage">《用户服务协议》</text>
    </view>
    <view class="privacy-check">
      <checkbox-group bindchange="onCheckPrivacy">
        <checkbox checked="{{privacyChecked}}" />
      </checkbox-group>
      <text>我已阅读并同意以上协议</text>
    </view>
    <button bindtap="confirmPrivacy" disabled="{{!privacyChecked}}" class="privacy-confirm-btn">
      确认同意
    </button>
    <button bindtap="skipPrivacy">暂不登录</button>
  </view>
</view>

<view wx:if="{{showRegisterModal}}" class="register-mask" catch:tap="">
  <view class="register-box">
    <view class="register-title">用户注册申请</view>
    <view class="register-desc">提交信息后等待管理员审核通过方可登录</view>

    <view class="register-form-item">
      <text class="register-label">学号</text>
      <input class="register-input" placeholder="请输入学号" value="{{registerForm.regStudentId}}" bindinput="onRegStudentIdInput" maxlength="20" />
    </view>
    <view class="register-form-item">
      <text class="register-label">姓名</text>
      <input class="register-input" placeholder="请输入真实姓名" value="{{registerForm.regName}}" bindinput="onRegNameInput" />
    </view>
    <view class="register-form-item">
      <text class="register-label">手机号</text>
      <input class="register-input" placeholder="请输入11位手机号" value="{{registerForm.regPhone}}" bindinput="onRegPhoneInput" type="number" maxlength="11" />
    </view>
    <view class="register-form-item">
      <text class="register-label">专业</text>
      <input class="register-input" placeholder="请输入专业名称" value="{{registerForm.regMajor}}" bindinput="onRegMajorInput" />
    </view>
    <view class="register-form-item">
      <text class="register-label">课题组(可选)</text>
      <input class="register-input" placeholder="请输入课题组名称" value="{{registerForm.regGroup}}" bindinput="onRegGroupInput" />
    </view>

    <view class="register-btn-group">
      <button class="register-confirm-btn" bind:tap="onRegisterSubmit">提交申请</button>
      <button class="register-cancel-btn" bind:tap="onRegisterCancel">取消</button>
    </view>
  </view>
</view>

<!-- 初始密码提示弹窗 -->
<view wx:if="{{showPwdTipModal}}" class="mask" catch:tap="">
  <view class="modal-box">
    <view class="modal-title">安全提示</view>
    <view class="modal-content">
      <text>您正在使用初始密码，建议尽快修改密码提升账号安全</text>
    </view>
    <view class="modal-btn-group">
      <button bindtap="goChangePwd">去修改密码</button>
      <button bindtap="closePwdTip">稍后再说</button>
    </view>
  </view>
</view>

<view class="auth-container">
  <view class="auth-header">
    <text class="auth-title">学生身份认证</text>
    <text class="auth-subtitle">请输入学号与密码登录</text>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="form-label">学号</text>
      <input class="form-input" placeholder="请输入学号" value="{{studentId}}" bindinput="onStudentIdInput" maxlength="20" />
    </view>
    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" placeholder="请输入密码" value="{{password}}" bindinput="onPwdInput" password maxlength="20" />
    </view>
    <!-- <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入11位手机号" value="{{phone}}" bindinput="onPhoneInput" type="number" maxlength="11" />
    </view> -->
    <button class="verify-button {{isVerifying ? 'verifying' : ''}}" bindtap="doLogin" disabled="{{isVerifying || !canSubmit}}">
      {{isVerifying ? '登录中...' : '登录'}}
    </button>

    <view class="status-display">
      <text wx:if="{{loginErrMsg}}" class="status-error">{{loginErrMsg}}</text>
    </view>
  </view>

  <view class="privacy-static">
    <checkbox-group bindchange="onCheckPrivacy">
      <checkbox checked="{{privacyChecked}}" />
    </checkbox-group>
    <text class="privacy-text">我已阅读并同意</text>
    <text class="privacy-link" bindtap="openPrivacyPage">《隐私政策》</text>
    <text class="privacy-text">与</text>
    <text class="privacy-link" bindtap="openAgreementPage">《用户协议》</text>
  </view>

  <view class="info-card">
    <view class="info-title">登录说明</view>
    <view class="info-item">1.新用户提交注册申请，等待管理员审核。</view>
    <view class="info-item">2.初始密码为注册时填写的手机号。</view>
  </view>

  <!-- 没有账号？去注册 -->
  <view class="goto-register-wrap">
    <text class="goto-register-text">没有账号？</text>
    <text class="goto-register-link" bindtap="openRegisterModal">去注册</text>
  </view>

  <view class="admin-entry">
    <button class="admin-button" bindtap="navigateToAdminLogin">管理员登录</button>
  </view>
</view>