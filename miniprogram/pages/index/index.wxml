<view class="container">
  <!-- 未登录时不显示提醒，其他全部正常显示 -->
  <view wx:if="{{!isAuthenticated}}" class="login-tip">
    <text>如需预约或使用仪器，请先登录</text>
    <view class="login-btn" bindtap="gotoAuth">
      去登录
    </view>
  </view>

  <view wx:if="{{isAuthenticated && unreadReminder}}" style="margin-bottom: 24rpx; padding: 24rpx; border-radius: 20rpx; background: linear-gradient(135deg, #eefbf3 0%, #ddf7e8 100%); border: 1px solid #9ed8b4;">
    <view style="display: flex; justify-content: space-between; align-items: center; gap: 16rpx;">
      <text style="font-size: 30rpx; font-weight: 600; color: #1d6b44;">最新未读提醒</text>
      <text style="font-size: 22rpx; color: #1d6b44;">{{unreadReminder.create_time}}</text>
    </view>
    <view style="margin-top: 12rpx;">
      <text style="display: block; font-size: 28rpx; font-weight: 600; color: #333;">{{unreadReminder.title}}</text>
      <text style="display: block; margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: #5b6472;">{{unreadReminder.content}}</text>
    </view>
  </view>

  <!-- 订阅公告通知按钮 -->
  <view wx:if="{{isAuthenticated}}" class="subscribe-bar" bindtap="onSubscribeTap">
    <view class="subscribe-left">
      <text class="subscribe-icon">🔔</text>
      <text class="subscribe-text">订阅公告通知</text>
    </view>
    <view class="subscribe-right">
      <text class="subscribe-count" wx:if="{{subMsgCount > 0}}">剩余 {{subMsgCount}} 次</text>
      <text class="subscribe-hint" wx:else>点一次 · 收一次</text>
    </view>
  </view>

  <view class="card-container">
    <view class="function-cards">
      <view class="function-card large" bindtap="gotoDeviceList">
        <view class="card-icon">🔬</view>
        <text class="card-title">仪器设备</text>
        <text class="card-desc">查看所有可用仪器设备</text>
      </view>
      <view class="function-card large" bindtap="gotoNoticeList">
        <view class="card-icon">📢</view>
        <text class="card-title">公告通知</text>
        <text class="card-desc">查看最新实验室公告</text>
      </view>
    </view>
  </view>

  <view class="common-devices">
    <view class="section-header">
      <text class="section-title">⭐ 常用仪器</text>
      <text class="section-more" bindtap="gotoDeviceList">查看全部</text>
    </view>

    <view wx:if="{{isLoading}}" class="loading">加载中...</view>

    <view wx:else class="device-grid">
      <view class="device-item" wx:for="{{commonDevices}}" wx:key="device_id" bindtap="gotoDeviceDetail" data-deviceid="{{item.device_id}}">
        <image class="device-img" src="{{item.picture}}" mode="aspectFill"></image>
        <text class="device-name">{{item.device_name}}</text>
      </view>

      <view class="device-item empty-item" wx:for="{{3 - commonDevices.length}}" wx:key="*this" wx:if="{{commonDevices.length < 3}}">
        <view class="empty-device-icon">➕</view>
        <text class="empty-device-text">更多仪器</text>
      </view>
    </view>
  </view>

  <view class="latest-notices">
    <view class="section-header">
      <text class="section-title">📢 最新公告</text>
      <text class="section-more" bindtap="gotoNoticeList">查看全部</text>
    </view>

    <view class="notice-list">
      <view class="notice-item" wx:for="{{latestNotices}}" wx:key="_id" bindtap="gotoNoticeDetail" data-noticeid="{{item.notice_id || item._id}}">
        <view class="notice-item-body">
          <text class="notice-title">{{item.title}}</text>
          <text class="notice-doc-tag" wx:if="{{item.doc_url}}">含文档</text>
        </view>
        <text class="notice-date">{{item.publish_date}}</text>
      </view>
      <view wx:if="{{latestNotices.length === 0}}" class="no-notice">
        <text>暂无公告</text>
      </view>
    </view>
  </view>
</view>