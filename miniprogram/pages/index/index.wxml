<view class="ds-page">
  <!-- 标题区：左对齐，比居中的大标题更接近成熟产品 -->
  <view class="hero">
    <text class="hero-title">实验室仪器平台</text>
    <text class="hero-subtitle">资源与环境工程学院</text>
  </view>

  <!-- 未登录引导 -->
  <view wx:if="{{!isAuthenticated}}" class="login-tip">
    <view class="login-tip-text">
      <text class="login-tip-title">尚未登录</text>
      <text class="login-tip-desc">登录后即可预约和使用仪器</text>
    </view>
    <view class="ds-btn login-tip-btn" bindtap="gotoAuth">去登录</view>
  </view>

  <!-- 未读提醒：从内联样式改为类名，层级提到最前 -->
  <view wx:if="{{isAuthenticated && unreadReminder}}" class="reminder-card" bindtap="goToUnreadReminder">
    <view class="reminder-head">
      <text class="reminder-label">最新未读提醒</text>
      <text class="reminder-time">{{unreadReminder.create_time}}</text>
    </view>
    <text class="reminder-title">{{unreadReminder.title}}</text>
    <text class="reminder-content">{{unreadReminder.content}}</text>
  </view>

  <!-- 订阅公告通知：一次授权换一条公告推送，可重复点击累积 -->
  <view
    wx:if="{{isAuthenticated}}"
    class="subscribe-bar {{isSubscribing ? 'is-busy' : ''}}"
    bindtap="onSubscribeTap"
  >
    <view class="subscribe-left">
      <text class="subscribe-icon">🔔</text>
      <text class="subscribe-text">{{isSubscribing ? '正在获取订阅…' : '订阅公告通知'}}</text>
    </view>
    <text class="subscribe-count" wx:if="{{subMsgCount > 0}}">可收 {{subMsgCount}} 条</text>
    <text class="subscribe-hint" wx:else>点一次 · 收一次</text>
  </view>

  <!-- 快捷入口：四个高频功能并排，替代原来"仪器/公告"两张大卡 + 应用页的重复入口 -->
  <view class="quick-entries">
    <view
      class="quick-entry"
      wx:for="{{quickEntries}}"
      wx:key="key"
      data-url="{{item.url}}"
      data-needauth="{{item.needAuth}}"
      bindtap="gotoQuickEntry"
    >
      <view class="quick-icon">{{item.icon}}</view>
      <text class="quick-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 常用仪器 -->
  <view class="ds-card">
    <view class="ds-section-head">
      <text class="ds-section-title">常用仪器</text>
      <text class="ds-section-more" bindtap="gotoDeviceList">查看全部</text>
    </view>

    <view wx:if="{{isLoading}}" class="ds-loading">
      <view class="ds-spinner"></view>
      <text>加载中</text>
    </view>

    <view wx:elif="{{commonDevices.length > 0}}" class="device-grid">
      <view
        class="device-item"
        wx:for="{{commonDevices}}"
        wx:key="device_id"
        bindtap="gotoDeviceDetail"
        data-deviceid="{{item.device_id}}"
      >
        <image
          wx:if="{{!item.imgFailed}}"
          class="device-img"
          src="{{item.picture}}"
          mode="aspectFill"
          lazy-load
          binderror="onCommonDeviceImageError"
          data-index="{{index}}"
        ></image>
        <view wx:else class="device-img device-img-fallback">
          <text class="device-img-fallback-text">暂无图</text>
        </view>
        <text class="device-name">{{item.device_name}}</text>
        <text class="device-meta" wx:if="{{item.meta_text}}">{{item.meta_text}}</text>
      </view>
    </view>

    <view wx:else class="ds-empty device-empty">
      <text class="ds-empty-title">暂无可预约仪器</text>
      <text class="ds-empty-desc">请联系管理员添加设备</text>
    </view>
  </view>

  <!-- 最新公告 -->
  <view class="ds-card">
    <view class="ds-section-head">
      <text class="ds-section-title">最新公告</text>
      <text class="ds-section-more" bindtap="gotoNoticeList">查看全部</text>
    </view>

    <view wx:if="{{latestNotices.length > 0}}">
      <view
        class="notice-item"
        wx:for="{{latestNotices}}"
        wx:key="_id"
        bindtap="gotoNoticeDetail"
        data-noticeid="{{item.notice_id || item._id}}"
      >
        <view class="notice-item-body">
          <text class="notice-title ds-clamp-2">{{item.title}}</text>
          <text class="ds-tag ds-tag-primary" wx:if="{{item.doc_url}}">含文档</text>
        </view>
        <text class="notice-date">{{item.publish_date}}</text>
      </view>
    </view>

    <view wx:else class="ds-empty notice-empty">
      <text class="ds-empty-title">暂无公告</text>
    </view>
  </view>
</view>
