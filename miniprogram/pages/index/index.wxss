/* 首页样式 —— 全部使用 app.wxss 里的设计变量 */

/* --------------------------------------------------------------------------
   标题区
   -------------------------------------------------------------------------- */
.hero {
  padding: 16rpx 8rpx 40rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: var(--ds-text);
  letter-spacing: 1rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ds-text-muted);
}

/* --------------------------------------------------------------------------
   未登录引导
   -------------------------------------------------------------------------- */
.login-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ds-gap);
  padding: 28rpx var(--ds-gap-lg);
  margin-bottom: var(--ds-gap);
  background: var(--ds-warning-light);
  border: 1rpx solid #f5e0b8;
  border-radius: var(--ds-radius);
}

.login-tip-text {
  flex: 1;
  min-width: 0;
}

.login-tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #8a6116;
}

.login-tip-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #a8823a;
}

.login-tip-btn {
  height: 64rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  flex-shrink: 0;
  background: var(--ds-warning);
}

/* --------------------------------------------------------------------------
   未读提醒卡片
   -------------------------------------------------------------------------- */
.reminder-card {
  padding: var(--ds-gap-lg);
  margin-bottom: var(--ds-gap);
  border-radius: var(--ds-radius);
  background: linear-gradient(135deg, #eefbf3 0%, #ddf7e8 100%);
  border: 1rpx solid #b7e3c8;
  box-shadow: var(--ds-shadow-sm);
}

.reminder-card:active {
  opacity: 0.9;
}

.reminder-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ds-gap-sm);
  margin-bottom: 12rpx;
}

.reminder-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d6b44;
}

.reminder-time {
  font-size: 22rpx;
  color: #4f8a6a;
}

.reminder-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ds-text);
}

.reminder-content {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ds-text-secondary);
}

/* --------------------------------------------------------------------------
   订阅公告通知
   -------------------------------------------------------------------------- */
.subscribe-bar {
  display: flex;
  align-items: center;
  gap: var(--ds-gap-sm);
  padding: 26rpx var(--ds-gap-lg);
  margin-bottom: var(--ds-gap);
  border-radius: var(--ds-radius);
  background: var(--ds-surface);
  border: 1rpx solid var(--ds-border);
  box-shadow: var(--ds-shadow-sm);
}

.subscribe-bar:active {
  background: var(--ds-fill);
}

/* 正在等微信授权弹窗/云端记账：视觉上淡一档，避免连点 */
.subscribe-bar.is-busy {
  opacity: 0.6;
}

.subscribe-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.subscribe-icon {
  font-size: 34rpx;
}

.subscribe-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ds-text);
}

.subscribe-count {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ds-primary-dark);
  background: var(--ds-primary-light);
  padding: 6rpx 18rpx;
  border-radius: var(--ds-radius-pill);
  flex-shrink: 0;
}

.subscribe-hint {
  font-size: 24rpx;
  color: var(--ds-text-muted);
  flex-shrink: 0;
}

/* --------------------------------------------------------------------------
   快捷入口
   -------------------------------------------------------------------------- */
.quick-entries {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--ds-gap-sm);
  padding: var(--ds-gap-lg) var(--ds-gap-sm);
  margin-bottom: var(--ds-gap);
  background: var(--ds-surface);
  border-radius: var(--ds-radius);
  box-shadow: var(--ds-shadow-sm);
}

.quick-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-radius: var(--ds-radius-sm);
}

.quick-entry:active {
  background: var(--ds-primary-soft);
}

.quick-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: var(--ds-primary-light);
}

.quick-label {
  font-size: 24rpx;
  color: var(--ds-text-secondary);
}

/* --------------------------------------------------------------------------
   常用仪器
   -------------------------------------------------------------------------- */
.device-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--ds-gap);
}

.device-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.device-item:active {
  opacity: 0.8;
}

.device-img {
  width: 100%;
  height: 150rpx;
  border-radius: var(--ds-radius-sm);
  object-fit: cover;
  margin-bottom: 12rpx;
  background: var(--ds-fill);
}

.device-img-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--ds-border);
  box-sizing: border-box;
}

.device-img-fallback-text {
  font-size: 20rpx;
  color: var(--ds-text-muted);
}

.device-name {
  width: 100%;
  font-size: 24rpx;
  color: var(--ds-text-secondary);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 第二行：用过 5 次 · 今天 / 推荐 */
.device-meta {
  display: block;
  width: 100%;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--ds-text-muted);
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.device-empty {
  padding: 60rpx 0;
}

.notice-empty {
  padding: 60rpx 0;
}

/* --------------------------------------------------------------------------
   最新公告
   -------------------------------------------------------------------------- */
.notice-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ds-gap);
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--ds-divider);
}

.notice-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.notice-item:active {
  opacity: 0.7;
}

.notice-item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}

.notice-title {
  font-size: 28rpx;
  color: var(--ds-text);
  line-height: 1.45;
}

.notice-date {
  font-size: 22rpx;
  color: var(--ds-text-muted);
  flex-shrink: 0;
}
